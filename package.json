{
  "name": "shelkovo-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist apps/www/dist apps/www/.astro node_modules/.astro",
    "dev": "turbo run dev",
    "start": "pnpm dev",
    "build": "turbo run build",
    "bundle:analyze": "pnpm --filter @shelkovo/www bundle:analyze",
    "search:prepare": "pnpm --filter @shelkovo/www search:prepare",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt --write . && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.astro\"",
    "format:changed": "lint-staged",
    "lint": "pnpm test:lint && oxlint --deny-warnings .",
    "test:lint": "node --test tools/oxlint/*.test.ts",
    "test": "turbo run test",
    "test:search-quality": "pnpm --filter @shelkovo/www test:search-quality",
    "parcels:update": "node apps/www/scripts/parcels/update.ts",
    "test:watch": "turbo run test:watch",
    "agents:setup": "pnpm install --frozen-lockfile && pnpm skills:install && pnpm openspec:generate",
    "skills:install": "node scripts/skills.mjs install",
    "skills:check": "node scripts/skills.mjs check",
    "openspec:generate": "node scripts/openspec.mjs",
    "openspec:validate": "pnpm exec openspec validate --all --strict --no-interactive && pnpm exec openspec validate --archived --strict --no-interactive",
    "test:agent-tooling": "node --test scripts/agent-tooling.test.mjs",
    "postinstall": "node scripts/hooks.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2",
    "@lhci/cli": "^0.15.1",
    "@oxlint/plugins": "1.86.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@yandex/ymaps3-types": "^1.0.21354683",
    "astro-compressor": "^2.0.1",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "skills": "1.7.0",
    "svelte": "^5.57.1",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,svelte}": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.astro": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "!(*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.mts|*.cts|*.svelte|*.astro)": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.4.1"
}

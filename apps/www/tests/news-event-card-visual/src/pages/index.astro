---
import '../../../config/visual-foundation.css';
import '@/styles/site.css';

import NewsEventCard from '@/components/news/NewsEventCard.astro';
import type { NewsEvent } from '@/lib/news/types';
import { testPlace } from '@/lib/places/tests/place.test-helper';
import MapBackground from '../../map-background.svg';

const eventWithCoordinates = {
  id: 'reglament',
  eventSlug: 'reglament-meeting',
  referenceKey: '2026/05/reglament-meeting',
  aliases: [],
  category: 'meetings',
  status: 'announced',
  startsDate: '2026-05-31',
  timePrecision: 'datetime',
  sourceUrl: 'https://example.com/reglament',
  body: 'На встрече обсудим регламент обслуживания поселка.',
  mentions: [],
  calendarUid: 'event-reglament@kpshelkovo.online',
  url: '/events/2026/05/reglament-meeting/',
  slug: 'reglament',
  title: 'Встреча по регламенту',
  startsAt: new Date('2026-09-30T19:00:00+03:00'),
  startsIso: '2026-09-30T19:00:00.000+03:00',
  startsTime: '19:00',
  endsAt: new Date('2026-09-30T21:00:00+03:00'),
  endsIso: '2026-09-30T21:00:00.000+03:00',
  endsTime: '21:00',
  icsUrl: '/news/2026/05/reglament/event.ics',
  place: testPlace({ coordinates: { lat: 55.123456, lng: 38.654321 } }),
  locationDetails: 'в беседке',
} satisfies NewsEvent;

const eventWithoutPlace = {
  id: 'entrance',
  eventSlug: 'entrance-meeting',
  referenceKey: '2026/06/entrance-meeting',
  aliases: [],
  category: 'community',
  status: 'announced',
  startsDate: '2026-06-03',
  timePrecision: 'datetime',
  sourceUrl: 'https://example.com/entrance',
  body: 'Обсудим благоустройство главного въезда и предложения жителей.',
  mentions: [],
  calendarUid: 'event-entrance@kpshelkovo.online',
  url: '/events/2026/06/entrance-meeting/',
  slug: 'entrance',
  title: 'Обсуждение благоустройства въезда',
  startsAt: new Date('2026-06-03T10:30:00+03:00'),
  startsIso: '2026-06-03T10:30:00.000+03:00',
  startsTime: '10:30',
  endsAt: new Date('2026-06-03T12:00:00+03:00'),
  endsIso: '2026-06-03T12:00:00.000+03:00',
  endsTime: '12:00',
  icsUrl: '/news/2026/06/entrance/event.ics',
} satisfies NewsEvent;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>News event card visual fixture</title>
  </head>
  <body class="ui-root-site news-event-visual-page">
    <main class="news-event-visual-shell">
      <section class="news-event-visual-card">
        <p class="news-event-visual-label">Coordinates</p>
        <div
          class="news-event-visual-target"
          data-testid="news-event-card-coordinates"
        >
          <NewsEventCard event={eventWithCoordinates} />
        </div>
      </section>

      <section class="news-event-visual-card">
        <p class="news-event-visual-label">Without a place</p>
        <div
          class="news-event-visual-target"
          data-testid="news-event-card-no-place"
        >
          <NewsEventCard event={eventWithoutPlace} />
        </div>
      </section>
    </main>
    <!-- Static SDK-owned layout only; MapPreview supplies the marker at runtime. -->
    <template id="map-sdk-fixture">
      <div class="fixture-map">
        <MapBackground class="fixture-map-background" aria-hidden="true" />
        <div class="fixture-map-marker" data-fixture-marker></div>
        <div class="fixture-map-copyright ymaps3--map-copyrights">
          <a href="https://yandex.ru/maps/" class="ymaps3--map-copyrights__logo"
            >Яндекс Карты</a
          >
          <a href="https://yandex.ru/legal/maps_termsofuse/"
            >Условия использования</a
          >
        </div>
        <button
          type="button"
          class="fixture-map-open"
          aria-label="Открыть в Яндекс Картах"
        >
          <span class="ymaps3--open-maps-button">Открыть Яндекс Карты</span>
        </button>
      </div>
    </template>
  </body>
</html>

<style>
  .fixture-map {
    position: absolute;
    inset: 0;
    font-family: Arial, sans-serif;
  }

  .fixture-map :global(.fixture-map-background) {
    opacity: 0.4;
    filter: saturate(0.6) brightness(1.2);
  }

  .fixture-map-marker {
    position: absolute;
    left: 75%;
    top: 45%;
  }

  .fixture-map-copyright {
    position: absolute;
    bottom: 8px;
    left: 8px;
    display: grid;
    gap: 2px;
    font-size: 10px;
    line-height: 12px;
  }

  .fixture-map :is(a, button) {
    color: #222;
    text-decoration: none;
  }

  .ymaps3--map-copyrights__logo {
    font-size: 14px;
    font-weight: 700;
    line-height: 18px;
  }

  .fixture-map-open {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-content: center;
    width: 163.875px;
    height: 36px;
    border: 0;
    padding: 0;
    font-size: 14px;
    white-space: nowrap;
    border-radius: 8px;
    background: white;
    box-shadow: 0 2px 6px #0003;
  }

  .news-event-visual-page {
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(circle at top, oklch(97% 0.012 145) 0, transparent 44%),
      linear-gradient(180deg, oklch(98% 0.008 140), oklch(95% 0.012 140));
    color: var(--color-text);
  }

  .news-event-visual-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: min(100%, 68rem);
    margin: 0 auto;
    padding: 3rem;
  }

  .news-event-visual-card {
    display: grid;
    gap: 0.75rem;
  }

  .news-event-visual-label {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-event-visual-target {
    /* Production desktop sidebar: 17.5rem plus screenshot padding. */
    width: min(100%, 19rem);
    padding: 0.75rem;
    border-radius: 1.75rem;
    background: color-mix(in oklab, white 74%, var(--color-bg) 26%);
  }

  @media (max-width: 47.999rem) {
    .news-event-visual-shell {
      gap: 1rem;
      /* With target padding, match the production 1.25rem mobile gutter. */
      padding: 0.5rem;
    }

    .news-event-visual-target {
      width: 100%;
    }
  }
</style>

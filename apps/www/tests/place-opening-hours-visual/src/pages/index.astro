---
import '../../../config/visual-foundation.css';
import '@/styles/site.css';

import PlaceOpeningHours from '@/components/places/PlaceOpeningHours.astro';
import type { PlaceOpeningHours as OpeningHours } from '@/lib/places/types';

const schedules = {
  daily: {
    periods: [
      {
        days: ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'],
        opensAt: '07:00',
        closesAt: '23:00',
      },
    ],
  },
  'middle-day-off': {
    periods: [
      {
        days: ['mon', 'wed', 'thu', 'fri'],
        opensAt: '10:00',
        closesAt: '19:00',
      },
      { days: ['sat', 'sun'], opensAt: '10:00', closesAt: '20:00' },
    ],
  },
  'differing-weekend-hours': {
    periods: [
      {
        days: ['mon', 'tue', 'wed', 'thu', 'sun'],
        opensAt: '09:00',
        closesAt: '22:00',
      },
      { days: ['fri', 'sat'], opensAt: '09:00', closesAt: '23:00' },
    ],
  },
  'split-intervals-description': {
    description: 'Вход со двора.',
    periods: [
      {
        days: ['mon', 'tue', 'wed', 'thu', 'fri'],
        opensAt: '14:00',
        closesAt: '18:00',
      },
      {
        days: ['mon', 'tue', 'wed', 'thu', 'fri'],
        opensAt: '09:00',
        closesAt: '13:00',
      },
    ],
  },
  'no-hours': undefined,
} satisfies Readonly<Record<string, OpeningHours | undefined>>;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Place opening hours visual fixture</title>
  </head>
  <body class="ui-root-site">
    <main>
      {
        Object.entries(schedules).map(([variant, openingHours]) => (
          <section>
            <p class="fixture-label">{variant}</p>
            <dl data-testid={variant}>
              {variant === 'no-hours' && (
                <div class="fixture-fact">
                  <dt>Адрес</dt>
                  <dd>Шелково Форест, Берёзовая улица</dd>
                </div>
              )}
              <PlaceOpeningHours openingHours={openingHours} />
            </dl>
          </section>
        ))
      }
    </main>
  </body>
</html>

<style>
  main {
    display: grid;
    gap: 2rem;
    max-width: 48rem;
    margin-inline: auto;
    padding: 2rem 1.25rem;
  }

  .fixture-label {
    margin-block-end: 0.75rem;
    color: var(--color-text-muted);
  }

  dl {
    border-bottom: 1px solid var(--color-border);
  }

  /* Neighboring fact mirrors the place page; the hours component owns its CSS. */
  .fixture-fact {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .fixture-fact dt {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.75rem;
  }

  .fixture-fact dd {
    line-height: 1.75rem;
  }

  @media (min-width: 40rem) {
    .fixture-fact {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 48rem) {
    main {
      padding-inline: 1.5rem;
    }
  }
</style>

---
import { TelegramIcon } from '@shelkovo/ui/icons';
import { isTelegramUrl } from '@shelkovo/url';

import type { ContactReview } from '@/lib/contacts/types';
import {
  formatContactReviewDate,
  formatContactReviewSentiment,
} from '@/lib/contacts/view';
import { renderMarkdown } from '@/lib/markdown/render';

interface Props {
  readonly reviews: readonly ContactReview[];
  readonly labelledBy?: string;
}

const { reviews, labelledBy } = Astro.props;
const sentimentEmoji = {
  positive: '👍',
  negative: '👎',
} as const satisfies Record<ContactReview['sentiment'], string>;
---

{
  reviews.length > 0 ? (
    <ul aria-labelledby={labelledBy} class="contact-reviews">
      {reviews.map((review) => (
        <li>
          <div
            class:list={[
              'contact-review',
              `contact-review--${review.sentiment}`,
            ]}
          >
            <a
              href={review.url}
              class="contact-review__overlay"
              aria-label={`Открыть отзыв от ${formatContactReviewDate(review)}`}
            />
            <span class="contact-review__emoji" aria-hidden="true">
              {sentimentEmoji[review.sentiment]}
            </span>
            <span class="contact-review__sentiment">
              {formatContactReviewSentiment(review.sentiment)}:{' '}
            </span>
            <div class="contact-review__content">
              <div
                class="contact-review__summary"
                data-pagefind-body
                set:html={renderMarkdown(review.summary)}
              />
              <span class="contact-review__meta">
                {isTelegramUrl(review.url) ? (
                  <TelegramIcon class="contact-review__telegram-icon" />
                ) : null}
                <span>{formatContactReviewDate(review)}</span>
              </span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  ) : null
}

<style>
  .contact-reviews {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-reviews > li + li {
    margin-block-start: 0.5rem;
  }

  .contact-review {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-inline: -0.5rem;
    border-radius: var(--radius-xl);
    padding: 0.5rem;
    transition: background-color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-review--positive:hover {
    background: var(--color-primary-soft-2);
  }

  .contact-review--negative {
    background: var(--color-danger-soft);
  }

  .contact-review__overlay {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
  }

  .contact-review__overlay:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--color-surface-raised),
      0 0 0 4px var(--color-focus);
  }

  .contact-review__emoji,
  .contact-review__content {
    position: relative;
    z-index: 10;
    margin-block-start: 0.125rem;
    pointer-events: none;
  }

  .contact-review__emoji {
    width: 1.5rem;
    flex-shrink: 0;
    font-size: 1rem;
    line-height: 1.25rem;
    text-align: center;
  }

  .contact-review__sentiment {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact-review__content {
    min-width: 0;
  }

  .contact-review__summary {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-review__summary :global(p) {
    margin: 0;
  }

  .contact-review__summary :global(a) {
    position: relative;
    color: var(--color-text);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: color-mix(
      in oklab,
      var(--color-text) 30%,
      transparent
    );
    text-underline-offset: 0.1875rem;
    pointer-events: auto;
  }

  .contact-review__summary :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .contact-review__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-block-start: 0.125rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25rem;
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-review__meta :global(.contact-review__telegram-icon) {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    color: var(--color-telegram);
  }

  .contact-review:hover .contact-review__summary,
  .contact-review:hover .contact-review__meta {
    color: var(--color-text);
  }
</style>

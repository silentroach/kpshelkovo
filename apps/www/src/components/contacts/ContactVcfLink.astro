---
import { ContactPlusIcon } from '@shelkovo/ui/icons';
import HeadingAction from '../HeadingAction.astro';
import type { ContactVcfLinkProps } from './contact-vcf-link.types';

type Props = ContactVcfLinkProps;
const { vcf }: Props = Astro.props;
---

<HeadingAction
  href={vcf.downloadUrl}
  download={vcf.filename}
  resource
  icon={ContactPlusIcon}
  label="Добавить в контакты"
/>

---
import type { ContactMethods } from '@/lib/contact-methods/types';
import { contactMethods } from '@/lib/contact-methods/view';
import type { ContactLocation } from '@/lib/contacts/types';
import { contactPlace } from '@/lib/contacts/view';

interface Props {
  readonly contacts: ContactMethods;
  readonly location?: ContactLocation;
  readonly headingId?: string;
  readonly headingLevel?: 'h2' | 'h3';
  readonly compact?: boolean;
}

const {
  contacts,
  location,
  headingId = 'contact-methods',
  headingLevel = 'h2',
  compact = false,
} = Astro.props;
const Heading = headingLevel;
const methods = contactMethods(contacts);
const place = contactPlace(location);
const heading = place ? 'Контакты и адрес' : 'Способы связи';
---

<section
  aria-labelledby={headingId}
  class:list={['contact-methods', { 'contact-methods--compact': compact }]}
>
  <Heading id={headingId} class="contact-methods__heading">
    {heading}
  </Heading>
  <dl class="contact-methods__list">
    {place ? (
      <div class="contact-methods__row">
        <dt class="contact-methods__label">{place.label}</dt>
        <dd class="contact-methods__value">
          <a href={place.href} class="ui-link contact-methods__link">
            {place.title}
          </a>
          {place.address ? (
            <p class="contact-methods__address">{place.address}</p>
          ) : null}
        </dd>
      </div>
    ) : null}

    {methods.map((method) => (
      <div class="contact-methods__row">
        <dt class="contact-methods__label">{method.label}</dt>
        <dd class="contact-methods__value">
          {method.href ? (
            <a href={method.href} class="ui-link contact-methods__link">
              {method.value}
            </a>
          ) : (
            method.value
          )}
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .contact-methods {
    max-width: 65ch;
  }

  .contact-methods__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border-width: 0;
  }

  .contact-methods__list {
    margin: 0;
  }

  .contact-methods__row {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.75rem;
  }

  .contact-methods__row:not(:last-child) {
    border-block-end: 1px solid var(--color-border);
  }

  .contact-methods__label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.75rem;
  }

  .contact-methods__value {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .contact-methods__link {
    font-weight: 600;
  }

  .contact-methods__address {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  @media (min-width: 40rem) {
    .contact-methods__row {
      grid-template-columns: 8rem minmax(0, 1fr);
      align-items: start;
      gap: 1rem;
    }
  }
  .contact-methods--compact .contact-methods__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .contact-methods--compact .contact-methods__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.375rem;
    padding-block: 0.25rem;
    border: 0;
  }
  .contact-methods--compact .contact-methods__label {
    font-weight: 400;
  }
  .contact-methods--compact .contact-methods__value {
    overflow-wrap: anywhere;
  }
</style>

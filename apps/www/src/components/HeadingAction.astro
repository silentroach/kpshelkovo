---
import ResourceLink from '@shelkovo/ui/ResourceLink.astro';
import type { HeadingActionProps } from './heading-action.types';

type Props = HeadingActionProps;

const {
  icon: Icon,
  label,
  title = label,
  class: className,
  href,
  resource,
  ...attributes
}: Props = Astro.props;
const Element = href !== undefined ? (resource ? ResourceLink : 'a') : 'button';
---

<Element
  {...attributes}
  href={href}
  type={href === undefined ? (attributes.type ?? 'button') : attributes.type}
  class:list={['ui-btn', 'ui-icon-action', 'heading-action', className]}
  aria-label={label}
  title={title}
>
  <Icon />
</Element>

<style>
  .heading-action {
    width: 2.75rem;
    height: 2.75rem;
  }

  .heading-action > :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }
</style>

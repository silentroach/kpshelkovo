---
import SearchTrigger from '@/components/search/SearchTrigger.astro';
import SiteNav from '@/components/site/SiteNav.astro';
import {
  getHomeStatusAriaLabel,
  getHomeStatusState,
  getHomeStatusWindows,
} from '@/lib/home/status';
import { loadStatusData } from '@/lib/status/load';

const status = await loadStatusData();
const buildNow = Date.now();
const statusState = getHomeStatusState(status.incidents, buildNow);
const statusAriaLabel = getHomeStatusAriaLabel(statusState);
const statusWindows = getHomeStatusWindows(status.incidents, buildNow);
---

<header class="site-header">
  <div class="site-header-inner ui-page">
    <a href="/" class="site-header-brand"> Шелково Онлайн </a>

    <div class="site-header-desktop-nav">
      <SiteNav
        variant="header"
        statusState={statusState}
        statusAriaLabel={statusAriaLabel}
      />
    </div>

    <div class="site-header-mobile-actions">
      <a
        href="/status/"
        aria-label={statusAriaLabel}
        title={statusAriaLabel}
        class="site-header-status-link"
        data-home-status-link
        data-home-status-state={statusState}
      >
        <span aria-hidden="true" class="site-header-status-dot"></span>
      </a>
      <SearchTrigger variant="mobile" />
      <details class="site-header-menu">
        <summary class="site-header-menu-button" aria-label="Меню">
          <span class="site-header-menu-label">Меню</span>
          <span aria-hidden="true" class="site-header-menu-icon"></span>
        </summary>

        <div class="site-header-mobile-panel">
          <SiteNav
            variant="mobile"
            statusState={statusState}
            statusAriaLabel={statusAriaLabel}
            ariaLabel="Главное меню сайта"
          />
        </div>
      </details>
    </div>
  </div>

  <script
    type="application/json"
    data-home-status-windows
    set:html={JSON.stringify(statusWindows)}
  />
</header>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-border) 68%, transparent);
    background: transparent;
  }

  .site-header-inner {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
  }

  .site-header-desktop-nav {
    display: none;
    min-width: 0;
  }

  .site-header-mobile-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(
      in oklab,
      var(--color-surface-raised) 74%,
      transparent
    );
    box-shadow:
      inset 0 1px 0
        color-mix(in oklab, var(--color-surface-raised) 86%, transparent),
      0 1px 0 color-mix(in oklab, var(--color-surface-raised) 54%, transparent);
    -webkit-backdrop-filter: saturate(145%) blur(4px);
    backdrop-filter: saturate(145%) blur(4px);
    pointer-events: none;
  }

  .site-header-brand {
    min-width: 0;
    flex: 1;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-wrap: balance;
    transition: color 0.2s ease;
  }

  .site-header-brand:is(:hover, :focus-visible) {
    color: var(--color-primary-hover);
    outline: none;
  }

  .site-header-menu {
    position: relative;
    flex: none;
  }

  .site-header-status-link {
    display: inline-flex;
    width: 2.25rem;
    min-height: 2.25rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--color-text);
    transition: background-color 0.2s ease;
  }

  .site-header-status-link:is(:hover, :focus-visible) {
    background: color-mix(in oklab, var(--color-primary-soft) 76%, transparent);
    outline: none;
  }

  .site-header-status-link:focus-visible {
    box-shadow: 0 0 0 2px var(--color-focus);
  }

  .site-header-status-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 1px
      color-mix(in oklab, var(--color-surface-raised) 72%, transparent);
  }

  .site-header-status-link[data-home-status-state='green']
    .site-header-status-dot {
    background: var(--color-success);
  }

  .site-header-status-link[data-home-status-state='amber']
    .site-header-status-dot {
    background: var(--color-warning);
  }

  .site-header-status-link[data-home-status-state='red']
    .site-header-status-dot {
    background: var(--color-danger);
  }

  .site-header-menu-button {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface-raised);
    padding: 0.4375rem 0.8125rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    cursor: pointer;
    user-select: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .site-header-menu-button::-webkit-details-marker {
    display: none;
  }

  .site-header-menu-button {
    list-style: none;
  }

  .site-header-menu-button:is(:hover, :focus-visible) {
    border-color: var(--color-primary);
    color: var(--color-primary-hover);
    outline: none;
  }

  .site-header-brand:focus-visible,
  .site-header-menu-button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 0.2rem;
  }

  .site-header-menu-icon {
    width: 0;
    height: 0;
    border-inline: 0.25rem solid transparent;
    border-top: 0.3125rem solid currentColor;
    opacity: 0.72;
    transition: transform 0.2s ease;
  }

  .site-header-menu[open] .site-header-menu-icon {
    transform: rotate(180deg);
  }

  .site-header-mobile-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(20rem, calc(100vw - 2rem));
    border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
    border-radius: var(--radius-2xl);
    background: color-mix(
      in oklab,
      var(--color-surface-raised) 68%,
      transparent
    );
    padding: 0.5rem;
    box-shadow:
      inset 0 1px 0
        color-mix(in oklab, var(--color-surface-raised) 90%, transparent),
      0 1rem 2rem oklch(24% 0.04 145 / 0.12);
    -webkit-backdrop-filter: saturate(165%) blur(16px);
    backdrop-filter: saturate(165%) blur(16px);
  }

  @media (max-width: 24rem) {
    .site-header-menu-button {
      width: 2.25rem;
      justify-content: center;
      padding-inline: 0.4375rem;
    }

    .site-header-menu-label {
      display: none;
    }

    .site-header-menu-icon {
      width: 1rem;
      height: 0.75rem;
      border: 0;
      background: linear-gradient(
        to bottom,
        currentColor 0 0.125rem,
        transparent 0.125rem 0.3125rem,
        currentColor 0.3125rem 0.4375rem,
        transparent 0.4375rem 0.625rem,
        currentColor 0.625rem 0.75rem
      );
    }

    .site-header-menu[open] .site-header-menu-icon {
      transform: none;
    }
  }

  @media (max-width: 22rem) {
    .site-header-inner {
      gap: 0.375rem;
      padding-inline: 0.75rem;
    }

    .site-header-brand {
      white-space: nowrap;
    }

    .site-header-mobile-panel {
      width: min(20rem, calc(100vw - 2.75rem));
    }
  }

  @media (min-width: 48rem) {
    .site-header {
      position: sticky;
      top: 0;
    }

    .site-header-inner {
      min-height: 3.5rem;
      gap: 1rem;
      padding: 0.625rem 1.5rem;
    }

    .site-header-desktop-nav {
      display: block;
    }

    .site-header-mobile-actions {
      display: none;
    }

    .site-header-brand {
      flex: none;
      font-size: 1.0625rem;
    }
  }
</style>

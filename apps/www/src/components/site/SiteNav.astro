---
import SearchTrigger from '@/components/search/SearchTrigger.astro';
import type { HomeStatusState } from '@/lib/home/status.types';

type SiteNavVariant = 'header' | 'mobile';

interface Props {
  readonly variant?: SiteNavVariant;
  readonly statusState: HomeStatusState;
  readonly statusAriaLabel: string;
  readonly ariaLabel?: string;
}

const {
  variant = 'header',
  statusState,
  statusAriaLabel,
  ariaLabel = 'Главное меню',
} = Astro.props;

const isMobile = variant === 'mobile';
const tariffMenuId = 'site-header-tariff-menu';
const pathname = Astro.url.pathname;
const currentPathname =
  pathname === '/' ? pathname : `${pathname.replace(/\/+$/, '')}/`;
const getCurrent = (href: string): 'page' | 'location' | undefined => {
  if (currentPathname === href) {
    return 'page';
  }

  return currentPathname.startsWith(href) ? 'location' : undefined;
};
const newsCurrent = getCurrent('/news/');
const placesCurrent = getCurrent('/map/');
const compareCurrent = getCurrent('/815/compare/');
const regulationCurrent = getCurrent('/815/regulation/');
const kbCurrent = getCurrent('/kb/');
const sarafanCurrent = getCurrent('/sarafan/');
const reviewsCurrent = getCurrent('/reviews/');
const statusCurrent = getCurrent('/status/');
const isTariffCurrent = Boolean(compareCurrent || regulationCurrent);
---

{
  isMobile ? (
    <nav aria-label={ariaLabel} class="site-nav site-nav-mobile">
      <a href="/news/" aria-current={newsCurrent} class="site-nav-mobile-link">
        Новости
      </a>
      <div
        class="site-nav-mobile-group"
        data-current-section={isTariffCurrent ? '' : undefined}
      >
        <p class="site-nav-mobile-label">
          Тариф 815
          {isTariffCurrent && (
            <span class="site-nav-sr-only">, текущий раздел</span>
          )}
        </p>
        <a
          href="/815/compare/"
          aria-current={compareCurrent}
          class="site-nav-mobile-link site-nav-mobile-nested"
        >
          Сравнение тарифов
        </a>
        <a
          href="/815/regulation/"
          aria-current={regulationCurrent}
          class="site-nav-mobile-link site-nav-mobile-nested"
        >
          Регламент
        </a>
      </div>

      <a href="/map/" aria-current={placesCurrent} class="site-nav-mobile-link">
        Карта
      </a>

      <a href="/kb/" aria-current={kbCurrent} class="site-nav-mobile-link">
        База знаний
      </a>
      <a
        href="/sarafan/"
        aria-current={sarafanCurrent}
        class="site-nav-mobile-link"
      >
        Сарафан
      </a>
      <a
        href="/reviews/"
        aria-current={reviewsCurrent}
        class="site-nav-mobile-link"
      >
        Отзывы
      </a>
      <a
        href="/status/"
        aria-current={statusCurrent}
        aria-label={statusAriaLabel}
        class="site-nav-mobile-link site-nav-mobile-status-link"
        data-home-status-link
        data-home-status-state={statusState}
      >
        <span>Статус</span>
        <span
          aria-hidden="true"
          data-home-status-dot
          class="site-nav-status-dot"
        />
      </a>
    </nav>
  ) : (
    <nav aria-label={ariaLabel} class="site-nav site-nav-header">
      <a href="/news/" aria-current={newsCurrent} class="site-nav-link">
        Новости
      </a>
      <div
        class="site-nav-dropdown"
        data-site-nav-dropdown
        data-current-section={isTariffCurrent ? '' : undefined}
      >
        <button
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls={tariffMenuId}
          data-site-nav-dropdown-button
          class="site-nav-link site-nav-dropdown-button"
        >
          <span>Тариф 815</span>
          {isTariffCurrent && (
            <span class="site-nav-sr-only">, текущий раздел</span>
          )}
          <span
            aria-hidden="true"
            data-site-nav-dropdown-icon
            class="site-nav-dropdown-icon"
          />
        </button>
        <div
          id={tariffMenuId}
          data-site-nav-dropdown-menu
          class="site-nav-submenu"
        >
          <div class="site-nav-glass-panel">
            <a
              href="/815/compare/"
              aria-current={compareCurrent}
              class="site-nav-submenu-link"
            >
              Сравнение тарифов
            </a>
            <a
              href="/815/regulation/"
              aria-current={regulationCurrent}
              class="site-nav-submenu-link"
            >
              Регламент
            </a>
          </div>
        </div>
      </div>

      <a href="/map/" aria-current={placesCurrent} class="site-nav-link">
        Карта
      </a>

      <a href="/kb/" aria-current={kbCurrent} class="site-nav-link">
        База знаний
      </a>
      <a href="/sarafan/" aria-current={sarafanCurrent} class="site-nav-link">
        Сарафан
      </a>
      <a href="/reviews/" aria-current={reviewsCurrent} class="site-nav-link">
        Отзывы
      </a>
      <a
        href="/status/"
        aria-current={statusCurrent}
        aria-label={statusAriaLabel}
        class="site-nav-link site-nav-status-link"
        data-home-status-link
        data-home-status-state={statusState}
      >
        <span>Статус</span>
        <span
          aria-hidden="true"
          data-home-status-dot
          class="site-nav-status-dot"
        />
      </a>
      <SearchTrigger variant="header" />
    </nav>
  )
}

<style>
  .site-nav-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    border: 0;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .site-nav-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
  }

  .site-nav-link {
    position: relative;
    isolation: isolate;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .site-nav-link::before,
  .site-nav-dropdown[data-current-section]
    > [data-site-nav-dropdown-button]::before {
    content: '';
    position: absolute;
    right: -0.625rem;
    bottom: -1.125rem;
    left: -0.625rem;
    z-index: -1;
    height: 0.1875rem;
    border-radius: 999px;
    pointer-events: none;
  }

  .site-nav-link[aria-current]::before,
  .site-nav-dropdown[data-current-section]
    > [data-site-nav-dropdown-button]::before {
    background: linear-gradient(
      0deg,
      color-mix(
        in oklab,
        var(--color-accent-text) 58%,
        var(--color-accent-soft)
      ),
      color-mix(in oklab, var(--color-accent) 70%, var(--color-accent-soft))
    );
    box-shadow: inset 0 1px 0
      color-mix(in oklab, var(--color-surface-raised) 66%, transparent);
    opacity: 0.78;
  }

  .site-nav-link[aria-current]::after,
  .site-nav-dropdown[data-current-section]
    > [data-site-nav-dropdown-button]::after {
    content: '';
    position: absolute;
    right: -0.625rem;
    bottom: -0.9375rem;
    left: -0.625rem;
    z-index: -1;
    height: 0.75rem;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--color-accent) 11%, transparent),
      transparent
    );
    filter: blur(0.25rem);
    pointer-events: none;
  }

  .site-nav-link[aria-current],
  .site-nav-dropdown[data-current-section] > [data-site-nav-dropdown-button] {
    color: var(--color-primary-hover);
    font-weight: 600;
  }

  .site-nav-dropdown {
    position: relative;
  }

  .site-nav-dropdown-button,
  .site-nav-status-link {
    display: flex;
    align-items: center;
    border-radius: var(--radius-full);
  }

  .site-nav-dropdown-button {
    gap: 0.375rem;
  }

  .site-nav-status-link {
    gap: 0.5rem;
  }

  .site-nav-dropdown-button:focus-visible,
  .site-nav-status-link:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--color-surface-raised),
      0 0 0 4px var(--color-focus);
  }

  .site-nav-dropdown-icon {
    width: 0;
    height: 0;
    border-inline: 0.25rem solid transparent;
    border-top: 0.3125rem solid currentColor;
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .site-nav-link:is(:hover, :focus-visible) {
    color: var(--color-primary-hover);
  }

  .site-nav-submenu-link:is(:hover, :focus-visible) {
    background: color-mix(in oklab, var(--color-primary-soft) 82%, transparent);
    color: var(--color-text);
  }

  .site-nav-submenu-link[aria-current] {
    background: color-mix(in oklab, var(--color-primary-soft) 90%, transparent);
    color: var(--color-primary-hover);
    box-shadow: inset 0 0 0 1px
      color-mix(in oklab, var(--color-primary) 16%, transparent);
    font-weight: 600;
  }

  .site-nav-glass-panel {
    border: 1px solid;
    border-radius: var(--radius-xl);
    padding: 0.375rem;
    border-color: color-mix(in oklab, var(--color-border) 72%, transparent);
    background: color-mix(
      in oklab,
      var(--color-surface-raised) 68%,
      transparent
    );
    box-shadow:
      inset 0 1px 0
        color-mix(in oklab, var(--color-surface-raised) 90%, transparent),
      0 0.75rem 1.75rem oklch(24% 0.04 145 / 0.1);
    -webkit-backdrop-filter: saturate(165%) blur(16px);
    backdrop-filter: saturate(165%) blur(16px);
  }

  .site-nav-submenu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 20;
    min-width: 12rem;
    visibility: hidden;
    padding-top: 0.5rem;
    pointer-events: none;
    transform: translateY(-0.25rem);
    opacity: 0;
    transition:
      opacity 0.15s ease-out,
      transform 0.15s ease-out,
      visibility 0.15s ease-out;
  }

  .site-nav-submenu-link {
    display: block;
    border-radius: var(--radius-lg);
    padding: 0.5rem 0.75rem;
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.25rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .site-nav-submenu-link:focus-visible {
    outline: none;
  }

  .site-nav-dropdown:not([data-site-nav-dropdown-hydrated]):is(
      :hover,
      :focus-within
    )
    .site-nav-submenu,
  .site-nav-dropdown[data-open] .site-nav-submenu {
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    opacity: 1;
  }

  .site-nav-submenu[hidden] {
    display: none;
  }

  .site-nav-dropdown:not([data-site-nav-dropdown-hydrated]):is(
      :hover,
      :focus-within
    )
    [data-site-nav-dropdown-icon],
  .site-nav-dropdown[data-open] [data-site-nav-dropdown-icon] {
    transform: rotate(180deg);
  }

  .site-nav-mobile {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .site-nav-mobile-link,
  .site-nav-mobile-label {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    color: var(--color-text);
  }

  .site-nav-mobile-link {
    border: 1px solid transparent;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .site-nav-mobile-link[aria-current] {
    border-color: color-mix(
      in oklab,
      var(--color-surface-raised) 82%,
      var(--color-border)
    );
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--color-surface-raised) 82%, transparent),
      color-mix(in oklab, var(--color-primary-soft) 62%, transparent)
    );
    box-shadow:
      inset 0 1px 0
        color-mix(in oklab, var(--color-surface-raised) 96%, transparent),
      inset 0 -1px 0 color-mix(in oklab, var(--color-border) 44%, transparent),
      0 0.25rem 0.75rem oklch(27% 0.05 142 / 0.07);
    color: var(--color-primary-hover);
  }

  .site-nav-mobile-link:is(:hover, :focus-visible) {
    background: color-mix(in oklab, var(--color-primary-soft) 82%, transparent);
    color: var(--color-primary-hover);
    outline: none;
  }

  .site-nav-mobile-label {
    min-height: 2rem;
    padding-bottom: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  .site-nav-mobile-group[data-current-section] .site-nav-mobile-label {
    color: var(--color-primary-hover);
  }

  .site-nav-mobile-group {
    border-block: 1px solid
      color-mix(in oklab, var(--color-border) 72%, transparent);
    padding-block: 0.375rem;
  }

  .site-nav-mobile-nested {
    margin-left: 0.5rem;
    padding-left: 1rem;
    font-size: 0.875rem;
    font-weight: 400;
  }

  .site-nav-mobile-status-link {
    justify-content: space-between;
  }

  .site-nav-status-dot {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-full);
  }

  .site-nav-mobile .site-nav-status-dot {
    width: 0.625rem;
    height: 0.625rem;
  }

  [data-home-status-state='green'] .site-nav-status-dot {
    background: var(--color-success);
  }

  [data-home-status-state='amber'] .site-nav-status-dot {
    background: var(--color-warning);
  }

  [data-home-status-state='red'] .site-nav-status-dot {
    background: var(--color-danger);
  }

  @media (min-width: 64rem) {
    .site-nav-header {
      gap: 1.5rem;
    }
  }
</style>

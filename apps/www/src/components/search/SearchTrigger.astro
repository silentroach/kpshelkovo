---
import { SearchIcon } from '@shelkovo/ui/icons';

type SearchTriggerVariant = 'header' | 'hero' | 'mobile';

interface Props {
  readonly variant: SearchTriggerVariant;
}

const { variant }: Props = Astro.props;
---

<button
  type="button"
  class:list={['site-search-trigger', `site-search-trigger--${variant}`]}
  aria-haspopup="dialog"
  data-search-trigger
  data-pagefind-ignore="all"
>
  <SearchIcon class="size-4 shrink-0" />
  <span>Поиск</span>
</button>

<style>
  .site-search-trigger {
    display: inline-flex;
    min-height: 2rem;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0.25rem 0.125rem;
    color: inherit;
    font: inherit;
    line-height: 1.25;
    cursor: pointer;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .site-search-trigger:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 0.2rem;
  }

  .site-search-trigger--header:is(:hover, :focus-visible),
  .site-search-trigger--mobile:is(:hover, :focus-visible) {
    color: var(--color-primary-hover);
  }

  .site-search-trigger--hero:is(:hover, :focus-visible) {
    opacity: 0.78;
  }

  .site-search-trigger--mobile {
    min-height: 2.25rem;
    padding-inline: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
</style>

---
import { SearchIcon } from '@shelkovo/ui/icons';

type SearchTriggerVariant = 'header' | 'mobile';

interface Props {
  readonly variant: SearchTriggerVariant;
}

const { variant }: Props = Astro.props;
---

<button
  type="button"
  class:list={['site-search-trigger', `site-search-trigger--${variant}`]}
  aria-label="Поиск"
  title="Поиск"
  aria-haspopup="dialog"
  data-search-trigger
  data-pagefind-ignore="all"
>
  <SearchIcon class="size-4 shrink-0" />
</button>

<style>
  .site-search-trigger {
    display: inline-flex;
    width: 2rem;
    min-height: 2rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0.25rem;
    color: inherit;
    font: inherit;
    line-height: 1.25;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .site-search-trigger:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 0.2rem;
  }

  .site-search-trigger--header:is(:hover, :focus-visible),
  .site-search-trigger--mobile:is(:hover, :focus-visible) {
    color: var(--color-primary-hover);
  }

  .site-search-trigger--mobile:is(:hover, :focus-visible) {
    background: color-mix(in oklab, var(--color-primary-soft) 76%, transparent);
  }

  .site-search-trigger--mobile {
    width: 2.25rem;
    min-height: 2.25rem;
  }
</style>

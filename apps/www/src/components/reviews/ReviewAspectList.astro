---
import StarRating from '@shelkovo/ui/StarRating.astro';

import { renderMarkdown } from '@/lib/markdown/render';
import type { ReviewAspect } from '@/lib/reviews/types';
import { formatReviewAspectLabel, sortReviewAspects } from '@/lib/reviews/view';

interface Props {
  readonly aspects: readonly ReviewAspect[];
}

const { aspects } = Astro.props;
const ordered = sortReviewAspects(aspects);
---

{
  ordered.length > 0 && (
    <section aria-labelledby="review-aspects" class="space-y-5">
      <h2 id="review-aspects" class="ui-prose-title">
        Оценки по темам
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        {ordered.map((aspect) => (
          <article class="space-y-3">
            <div class="space-y-2">
              <h3 class="ui-section-label">
                {formatReviewAspectLabel(aspect.type)}
              </h3>
              {aspect.rating && (
                <StarRating
                  rating={aspect.rating}
                  label={`Оценка ${aspect.rating} из 5`}
                />
              )}
            </div>
            {aspect.body && (
              <div
                class="ui-prose text-sm"
                data-pagefind-body
                set:html={renderMarkdown(aspect.body)}
              />
            )}
          </article>
        ))}
      </div>
    </section>
  )
}

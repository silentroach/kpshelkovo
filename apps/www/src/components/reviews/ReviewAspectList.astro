---
import StarRating from '@shelkovo/ui/StarRating.astro';

import { renderMarkdown } from '@/lib/markdown/render';
import type { ReviewAspect } from '@/lib/reviews/types';
import {
  formatReviewAspectLabel,
  formatReviewAspectLabelHint,
  sortReviewAspects,
} from '@/lib/reviews/view';

interface Props {
  readonly aspects: readonly ReviewAspect[];
}

const { aspects } = Astro.props;
const ordered = sortReviewAspects(aspects);
---

{
  ordered.length > 0 && (
    <section aria-labelledby="review-aspects" class="review-aspect-list">
      <h2 id="review-aspects" class="ui-prose-title">
        Оценки по темам
      </h2>
      <div class="review-aspect-list__grid">
        {ordered.map((aspect) => (
          <article class="review-aspect-list__aspect">
            <div class="review-aspect-list__header">
              <h3
                class="ui-section-label"
                title={formatReviewAspectLabelHint(aspect.type)}
              >
                {formatReviewAspectLabel(aspect.type)}
              </h3>
              {aspect.rating && (
                <StarRating
                  rating={aspect.rating}
                  label={`Оценка ${aspect.rating} из 5`}
                  class="review-aspect-list__rating"
                />
              )}
            </div>
            {aspect.body && (
              <div
                class="ui-prose"
                data-pagefind-body
                set:html={renderMarkdown(aspect.body)}
              />
            )}
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .review-aspect-list > * + * {
    margin-block-start: 1.25rem;
  }

  .review-aspect-list__grid {
    display: grid;
    gap: 1.5rem;
  }

  .review-aspect-list__aspect > * + * {
    margin-block-start: 0.75rem;
  }

  .review-aspect-list__header > :global(.review-aspect-list__rating) {
    margin-block-start: 0.5rem;
  }

  @media (min-width: 48rem) {
    .review-aspect-list__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

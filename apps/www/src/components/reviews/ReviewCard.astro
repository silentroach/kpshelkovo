---
import StarRating from '@shelkovo/ui/StarRating.astro';
import { formatText } from '@shelkovo/typography';

import type { Review, ReviewAspect } from '@/lib/reviews/types';
import {
  formatReviewAspectLabel,
  formatReviewAspectLabelHint,
  formatReviewTitle,
  sortReviewAspects,
} from '@/lib/reviews/view';
import ReviewMeta from './ReviewMeta.astro';

interface Props {
  readonly review: Review;
}

const { review } = Astro.props;
const ratedAspects = sortReviewAspects(review.aspects).filter(
  (aspect): aspect is ReviewAspect & { readonly rating: number } =>
    Boolean(aspect.rating),
);
---

<article class="ui-shell review-card">
  <div class="review-card__layout">
    <div class="review-card__summary">
      <h3 class="ui-entry-title">
        <a href={review.url} class="ui-title-link">
          {formatReviewTitle(review)}
        </a>
      </h3>
      <div class="review-card__meta">
        <ReviewMeta review={review} authorFirst />
      </div>
    </div>

    {review.excerpt && (
      <blockquote class="review-card__excerpt" cite={review.url}>
        {formatText(review.excerpt)}
      </blockquote>
    )}

    {ratedAspects.length > 0 && (
      <ul class="review-card__aspects">
        {ratedAspects.map((aspect) => (
          <li class="review-card__aspect">
            <span
              class="review-card__aspect-label"
              title={formatReviewAspectLabelHint(aspect.type)}
            >
              {formatReviewAspectLabel(aspect.type)}
            </span>
            <div class="review-card__rating">
              <StarRating
                rating={aspect.rating}
                label={`Оценка ${aspect.rating} из 5`}
              />
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .review-card {
    container-type: inline-size;
    min-width: 0;
    height: 100%;
    padding: 1.25rem;
    overflow-wrap: anywhere;
  }

  .review-card__layout {
    display: grid;
    gap: 1rem;
  }

  .review-card__summary > * + * {
    margin-block-start: 0.5rem;
  }

  .review-card__excerpt {
    max-width: 76ch;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 400;
    font-style: normal;
    line-height: 1.6;
  }

  .review-card__aspects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 28rem;
    column-gap: 0.75rem;
    row-gap: 0.75rem;
    --star-rating-size: 0.875rem;
    --star-rating-gap: 0.0625rem;
    --star-rating-fill: oklch(58% 0.065 84);
  }

  .review-card__aspect {
    min-width: 0;
  }

  .review-card__aspect-label {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1rem;
  }

  .review-card__rating {
    display: flex;
    margin-block-start: 0.25rem;
  }

  @media (min-width: 40rem) {
    .review-card__aspects {
      column-gap: 1.5rem;
    }
  }

  @container (max-width: 18rem) {
    .review-card__aspects {
      grid-template-columns: minmax(0, 1fr);
    }

    .review-card__aspect {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.25rem 0.75rem;
    }

    .review-card__rating {
      margin-block-start: 0;
    }
  }

  @media (min-width: 48rem) {
    .review-card {
      padding: 1.5rem;
    }
  }
</style>

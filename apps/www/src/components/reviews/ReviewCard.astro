---
import StarRating from '@shelkovo/ui/StarRating.astro';

import type { Review, ReviewAspect } from '@/lib/reviews/types';
import {
  formatReviewAspectLabel,
  formatReviewAspectLabelHint,
  formatReviewTitle,
  sortReviewAspects,
} from '@/lib/reviews/view';
import ReviewMeta from './ReviewMeta.astro';

interface Props {
  readonly review: Review;
}

const { review } = Astro.props;
const ratedAspects = sortReviewAspects(review.aspects).filter(
  (aspect): aspect is ReviewAspect & { readonly rating: number } =>
    Boolean(aspect.rating),
);
---

<article class="ui-shell review-card">
  <div
    class:list={[
      'review-card__layout',
      ratedAspects.length > 0 && 'review-card__layout--rated',
    ]}
  >
    <div class="review-card__summary">
      <h3 class="ui-entry-title">
        <a href={review.url} class="ui-link">{formatReviewTitle(review)}</a>
      </h3>
      <div class="review-card__meta">
        <ReviewMeta review={review} />
      </div>
    </div>

    {
      ratedAspects.length > 0 && (
        <ul class="review-card__aspects">
          {ratedAspects.map((aspect) => (
            <li class="review-card__aspect">
              <span
                class="review-card__aspect-label"
                title={formatReviewAspectLabelHint(aspect.type)}
              >
                {formatReviewAspectLabel(aspect.type)}
              </span>
              <div class="review-card__rating">
                <StarRating
                  rating={aspect.rating}
                  label={`Оценка ${aspect.rating} из 5`}
                />
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .review-card {
    height: 100%;
    padding: 1.25rem;
  }

  .review-card__layout {
    display: grid;
    gap: 1rem;
  }

  .review-card__summary > * + * {
    margin-block-start: 0.75rem;
  }

  .review-card__aspects {
    display: grid;
    column-gap: 1.5rem;
    row-gap: 0.75rem;
  }

  .review-card__aspect {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.75rem;
  }

  .review-card__aspect-label {
    display: block;
    grid-column: 2;
    grid-row: 1;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
  }

  .review-card__rating {
    display: contents;
  }

  @media (min-width: 40rem) {
    .review-card__aspects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .review-card__aspect {
      display: block;
    }

    .review-card__rating {
      display: block;
      margin-block-start: 0.25rem;
    }
  }

  @media (min-width: 48rem) {
    .review-card {
      padding: 1.5rem;
    }
  }

  @media (min-width: 80rem) {
    .review-card__layout {
      align-items: center;
      gap: 2rem;
    }

    .review-card__layout--rated {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import { CheckCircleIcon } from '@shelkovo/ui/icons';

import ShelkovoAreaIcon from '@/components/ShelkovoAreaIcon.astro';
import type { Review } from '@/lib/reviews/types';
import { formatReviewAuthor, formatReviewDate } from '@/lib/reviews/view';

interface Props {
  readonly review: Pick<Review, 'author' | 'area' | 'publishedIso'>;
  readonly showVerified?: boolean;
  readonly className?: string;
}

const { review, showVerified = false, className } = Astro.props;
---

<div class:list={['review-meta', className]}>
  <time datetime={review.publishedIso} class="review-meta-date">
    {formatReviewDate(review)}
  </time>
  <span>{formatReviewAuthor(review)}</span>
  <ShelkovoAreaIcon area={review.area} />
  {
    showVerified && (
      <span class="review-meta-verified">
        <CheckCircleIcon />
        проверенный собственник
      </span>
    )
  }
</div>

<style>
  .review-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .review-meta-date {
    color: var(--color-text);
    font-weight: 600;
  }

  .review-meta-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-success);
    font-weight: 600;
  }

  .review-meta-verified > :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>

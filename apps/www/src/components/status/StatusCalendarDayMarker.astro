---
import type { StatusCalendarDayKind } from '@/lib/status/calendar.types';

interface Props {
  readonly kind: StatusCalendarDayKind;
  readonly decorative?: boolean;
}

const { kind, decorative = false } = Astro.props;
const label =
  kind === 'incident'
    ? 'Есть проблемы'
    : kind === 'maintenance'
      ? 'Есть плановые работы'
      : 'Есть проблемы и плановые работы';
---

<span
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  data-status-calendar-marker={kind}
  class:list={[
    'inline-flex size-4 shrink-0 items-center justify-center rounded-full',
    kind === 'incident' && 'bg-[color:var(--color-danger)]',
    kind !== 'incident' &&
      'border-2 border-[color:var(--color-warning-graphic)]',
  ]}
>
  {
    kind === 'mixed' && (
      <span
        aria-hidden="true"
        class="size-2 rounded-full bg-[color:var(--color-danger)]"
      />
    )
  }
</span>

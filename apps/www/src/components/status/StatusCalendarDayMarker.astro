---
import type { StatusCalendarDayKind } from '@/lib/status/calendar.types';

interface Props {
  readonly kind: StatusCalendarDayKind;
  readonly decorative?: boolean;
}

const { kind, decorative = false } = Astro.props;
const label =
  kind === 'incident'
    ? 'Есть проблемы'
    : kind === 'maintenance'
      ? 'Есть плановые работы'
      : 'Есть проблемы и плановые работы';
---

<span
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  data-status-calendar-marker={kind}
  class="marker"
>
  {kind === 'mixed' && <span aria-hidden="true" class="marker__core" />}
</span>

<style>
  .marker {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
  }

  .marker[data-status-calendar-marker='incident'] {
    background: var(--color-danger);
  }

  .marker:not([data-status-calendar-marker='incident']) {
    border: 2px solid var(--color-warning-graphic);
  }

  .marker__core {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-danger);
  }
</style>

---
import { AlertCircleIcon, CheckCircleIcon } from '@shelkovo/ui/icons';

import type { StatusIncident } from '../../lib/status/types';
import { renderNewsMarkdown } from '../../lib/news/html';
import StatusIncidentMeta from './StatusIncidentMeta.astro';

interface Props {
  readonly incident: StatusIncident;
}

const { incident } = Astro.props;

const excerptHtml = incident.excerpt
  ? renderNewsMarkdown(incident.excerpt)
  : undefined;
const titleIcon =
  incident.kind !== 'incident'
    ? undefined
    : incident.phase === 'active'
      ? {
          Icon: AlertCircleIcon,
          tone: 'danger',
        }
      : incident.phase === 'resolved'
        ? {
            Icon: CheckCircleIcon,
            tone: 'success',
          }
        : undefined;
const TitleIcon = titleIcon?.Icon;
---

<article class="ui-shell status-incident-row">
  <div class="status-incident-row__content">
    <div class="status-incident-row__header">
      <h3 class="ui-entry-title">
        {
          titleIcon && TitleIcon && (
            <span
              aria-hidden="true"
              class:list={[
                'status-incident-row__icon',
                `status-incident-row__icon--${titleIcon.tone}`,
              ]}
            >
              <TitleIcon />
            </span>
          )
        }
        {
          incident.hasPage ? (
            // prettier-ignore
            <a href={incident.url} class="ui-link status-incident-row__title">{incident.title}</a>
          ) : (
            <span class="status-incident-row__title">{incident.title}</span>
          )
        }
      </h3>

      <StatusIncidentMeta incident={incident} />
    </div>

    {
      excerptHtml && (
        <div
          class="ui-copy status-incident-row__excerpt"
          set:html={excerptHtml}
        />
      )
    }
  </div>
</article>

<style>
  .status-incident-row {
    padding: 1.25rem;
  }

  .status-incident-row__content {
    max-width: 56rem;
  }

  .status-incident-row__content > * + * {
    margin-block-start: 0.75rem;
  }

  .status-incident-row__header > * + * {
    margin-block-start: 0.5rem;
  }

  .status-incident-row__icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    margin-inline-end: 0.5rem;
    vertical-align: -0.1em;
  }

  .status-incident-row__icon > :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .status-incident-row__icon--danger {
    color: var(--color-danger);
  }

  .status-incident-row__icon--success {
    color: var(--color-success);
  }

  .status-incident-row__title {
    min-width: 0;
  }

  .status-incident-row__excerpt {
    max-width: 48rem;
    color: var(--color-muted-foreground);
  }

  .status-incident-row__excerpt :global(p) {
    margin-block: 0;
  }

  @media (min-width: 48rem) {
    .status-incident-row {
      padding: 1.5rem;
    }
  }
</style>

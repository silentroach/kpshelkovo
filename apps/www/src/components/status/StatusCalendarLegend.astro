---
import StatusCalendarDayMarker from './StatusCalendarDayMarker.astro';
---

<section aria-label="Обозначения" class="legend" data-status-calendar-legend>
  <ul class="legend__list">
    <li class="legend__item">
      <StatusCalendarDayMarker kind="incident" decorative />
      <span>Проблемы</span>
    </li>
    <li class="legend__item">
      <StatusCalendarDayMarker kind="maintenance" decorative />
      <span>Плановые работы</span>
    </li>
  </ul>
</section>

<style>
  .legend {
    margin-top: 2.5rem;
  }

  .legend__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .legend__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>

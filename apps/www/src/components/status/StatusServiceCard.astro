---
import {
  DamIcon,
  FiberIcon,
  LightningIcon,
  WaterDropIcon,
} from '@shelkovo/ui/icons';

import ShelkovoAreaIcon from '@/components/ShelkovoAreaIcon.astro';
import { toStatusTimelineIncidentInput } from '@/lib/status/timeline';
import StatusServiceState from './StatusServiceState.astro';
import StatusServiceTimeline from './StatusServiceTimeline.astro';
import type { StatusServiceSummary } from '../../lib/status/types';
import {
  formatStatusDate,
  formatStatusDuration,
  formatStatusService,
} from '../../lib/status/view';

interface Props {
  readonly summary: StatusServiceSummary;
  readonly timelineDays?: number;
  readonly mobileTimelineDays?: number;
  readonly serviceHref?: string;
}

const {
  summary,
  timelineDays = 30,
  mobileTimelineDays,
  serviceHref,
} = Astro.props;

const serviceLabel = formatStatusService(summary.service);
const latestRecord = summary.incidents[0];
const latestMoment = latestRecord
  ? formatStatusDate(latestRecord.started.iso, {
      hasTime: latestRecord.started.hasTime,
      nonBreaking: true,
    })
  : undefined;
const latestDuration =
  latestRecord && latestRecord.phase !== 'active' && latestRecord.duration
    ? formatStatusDuration(latestRecord.duration, { nonBreaking: true })
    : undefined;
const latestAreas =
  latestRecord && !latestRecord.appliesToAllAreas ? latestRecord.areas : [];
const timelineIncidents = summary.incidents.map(toStatusTimelineIncidentInput);
const serviceIcons = {
  electricity: LightningIcon,
  water: WaterDropIcon,
  internet: FiberIcon,
  dam: DamIcon,
} as const;
const ServiceIcon = serviceIcons[summary.service];
const resolvedMobileTimelineDays = mobileTimelineDays ?? timelineDays;
const hasResponsiveTimeline = resolvedMobileTimelineDays !== timelineDays;
---

<article class="status-service-row ui-shell" data-status-service-card>
  <div class="status-service-row__layout">
    {
      serviceHref ? (
        <a href={serviceHref} class="status-service-row__service-link">
          <span
            class:list={[
              'status-service-row__icon',
              `status-service-row__icon--${summary.service}`,
            ]}
          >
            <ServiceIcon />
          </span>

          <div class="status-service-row__service-name">
            <h3 class="ui-card-title status-service-row__linked-title">
              {serviceLabel}
            </h3>
          </div>
        </a>
      ) : (
        <div class="status-service-row__service">
          <span
            class:list={[
              'status-service-row__icon',
              `status-service-row__icon--${summary.service}`,
            ]}
          >
            <ServiceIcon />
          </span>

          <div class="status-service-row__service-name">
            <h3 class="ui-card-title">{serviceLabel}</h3>
          </div>
        </div>
      )
    }

    <div class="status-service-row__timeline">
      {
        hasResponsiveTimeline ? (
          <>
            <div data-status-timeline-viewport="mobile">
              <StatusServiceTimeline
                service={summary.service}
                incidents={timelineIncidents}
                timelineDays={resolvedMobileTimelineDays}
              />
            </div>

            <div data-status-timeline-viewport="desktop">
              <StatusServiceTimeline
                service={summary.service}
                incidents={timelineIncidents}
                timelineDays={timelineDays}
              />
            </div>
          </>
        ) : (
          <StatusServiceTimeline
            service={summary.service}
            incidents={timelineIncidents}
            timelineDays={timelineDays}
          />
        )
      }
    </div>

    <div class="status-service-row__state">
      <StatusServiceState summary={summary} />
    </div>

    <div class="status-service-row__latest">
      <p class="status-service-row__latest-label">Последняя запись</p>

      {
        latestRecord ? (
          <div class="status-service-row__latest-content">
            {latestRecord.hasPage ? (
              <a
                href={latestRecord.url}
                class="site-inline-link status-service-row__latest-title"
              >
                {latestRecord.title}
              </a>
            ) : (
              <p class="status-service-row__latest-title">
                {latestRecord.title}
              </p>
            )}
            {(latestMoment || latestAreas.length > 0) && (
              <div class="status-service-row__latest-meta">
                {latestMoment && <span>{latestMoment}</span>}
                {latestAreas.map((area) => (
                  <ShelkovoAreaIcon area={area} />
                ))}
              </div>
            )}
            {latestDuration && (
              <p class="status-service-row__latest-meta">
                Длительность: {latestDuration}
              </p>
            )}
          </div>
        ) : (
          <div class="status-service-row__latest-content">
            <p class="status-service-row__latest-empty">
              Пока без записей по этому сервису
            </p>
            <p class="status-service-row__latest-meta">-</p>
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .status-service-row {
    padding: 1rem 1.25rem;
  }

  .status-service-row__layout {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .status-service-row__service-link,
  .status-service-row__service {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-service-row__service-link {
    align-self: flex-start;
  }

  .status-service-row__icon {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
  }

  .status-service-row__icon--electricity {
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .status-service-row__icon--water {
    background: var(--color-water-soft);
    color: var(--color-water);
  }

  .status-service-row__icon--internet {
    background: var(--color-unknown-soft);
    color: var(--color-unknown);
  }

  .status-service-row__icon--dam {
    background: var(--color-surface-muted);
    color: var(--color-earth);
  }

  .status-service-row__icon > :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .status-service-row__service-name,
  .status-service-row__timeline {
    display: flex;
    flex-direction: column;
  }

  .status-service-row__service-name {
    gap: 0.25rem;
  }

  .status-service-row__timeline {
    gap: 0.5rem;
  }

  .status-service-row__linked-title {
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .status-service-row__service-link:hover .status-service-row__linked-title {
    color: var(--color-primary);
  }

  [data-status-timeline-viewport='desktop'],
  .status-service-row__latest,
  .status-service-row__latest-label {
    display: none;
  }

  .status-service-row__state :global([data-status-service-state-label]) {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25rem;
  }

  .status-service-row__latest-content > * + * {
    margin-block-start: 0.25rem;
  }

  .status-service-row__latest-title,
  .status-service-row__latest-empty {
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .status-service-row__latest-title {
    display: block;
    font-weight: 600;
  }

  .status-service-row__latest-meta {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  div.status-service-row__latest-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
  }

  @media (min-width: 48rem) {
    .status-service-row {
      padding: 1.25rem 1.5rem;
    }

    .status-service-row__icon {
      width: 2.5rem;
      height: 2.5rem;
    }

    .status-service-row__icon > :global(svg) {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .status-service-row__layout {
      display: grid;
      grid-template-columns:
        minmax(0, 15rem) minmax(0, 1fr) minmax(0, 11rem)
        minmax(0, 21rem);
      align-items: center;
      gap: 1.25rem;
    }

    .status-service-row__service-link {
      align-self: auto;
    }

    .status-service-row__service-name,
    .status-service-row__timeline {
      gap: 0;
    }

    [data-status-timeline-viewport='mobile'] {
      display: none;
    }

    [data-status-timeline-viewport='desktop'],
    .status-service-row__latest {
      display: block;
    }
  }
</style>

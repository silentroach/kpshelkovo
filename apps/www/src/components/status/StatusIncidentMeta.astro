---
import ShelkovoAreaIcon from '../ShelkovoAreaIcon.astro';
import LinkWithIcon from '@shelkovo/ui/LinkWithIcon.astro';

import type { StatusIncident } from '../../lib/status/types';
import StatusIncidentPeriod from './StatusIncidentPeriod.astro';

interface Props {
  readonly incident: StatusIncident;
  readonly className?: string;
  readonly variant?: 'default' | 'prominent';
}

const { incident, className, variant = 'default' } = Astro.props;

const sourceUrl = incident.sourceUrl;
---

<div
  class:list={[
    'status-incident-meta',
    { 'status-incident-meta--prominent': variant === 'prominent' },
    className,
  ]}
>
  <StatusIncidentPeriod incident={incident} />

  {
    !incident.appliesToAllAreas &&
      incident.areas.map((area) => <ShelkovoAreaIcon area={area} />)
  }

  {
    sourceUrl && (
      <span data-pagefind-ignore="all">
        <LinkWithIcon href={sourceUrl} ariaLabelPrefix="Источник" />
      </span>
    )
  }
</div>

<style>
  .status-incident-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.625rem;
    row-gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .status-incident-meta--prominent {
    column-gap: 1rem;
    font-size: 0.9375rem;
  }
</style>

---
import type { StatusCalendarMonthGrid } from '@/lib/status/calendar.types';
import { statusCalendarDayUrl } from '@/lib/status/routes';
import {
  formatStatusCalendarDayLabel,
  formatStatusCalendarDayTooltipSummary,
} from '@/lib/status/view';

interface Props {
  readonly month: StatusCalendarMonthGrid;
}

const { month } = Astro.props;
const titleId = `status-calendar-month-${month.month}`;
const tooltipDescription = 'Откроется журнал за этот день';
const weekdays = [
  ['Пн', 'Понедельник'],
  ['Вт', 'Вторник'],
  ['Ср', 'Среда'],
  ['Чт', 'Четверг'],
  ['Пт', 'Пятница'],
  ['Сб', 'Суббота'],
  ['Вс', 'Воскресенье'],
] as const;
---

<section class="status-calendar-month" data-status-calendar-month={month.month}>
  <h2 id={titleId} class="ui-section-title status-calendar-month__title">
    {month.name}
  </h2>

  <table aria-labelledby={titleId} class="status-calendar-month__table">
    <thead>
      <tr>
        {
          weekdays.map(([short, full]) => (
            <th
              scope="col"
              aria-label={full}
              class="status-calendar-month__weekday"
            >
              <span aria-hidden="true">{short}</span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        month.weeks.map((week) => (
          <tr>
            {week.map((day) => {
              const status = day.status;
              const linkLabel = status
                ? formatStatusCalendarDayLabel(status)
                : undefined;
              const tooltipSummary = status
                ? formatStatusCalendarDayTooltipSummary(status)
                : undefined;
              const tooltipId = status
                ? `status-calendar-tooltip-${day.id}`
                : undefined;

              return (
                <td
                  aria-hidden={!day.isInMonth ? 'true' : undefined}
                  class="status-calendar-month__cell"
                  data-status-calendar-cell={day.id}
                  data-status-calendar-adjacent={
                    !day.isInMonth ? day.id : undefined
                  }
                >
                  <div
                    class="status-calendar-date"
                    data-status-calendar-date={
                      day.isInMonth ? day.id : undefined
                    }
                    data-status-calendar-tooltip-root={
                      status ? day.id : undefined
                    }
                    data-status-calendar-tooltip-summary={tooltipSummary}
                  >
                    {!day.isInMonth ? (
                      <span class="ui-num status-calendar-date__adjacent-day">
                        {day.day}
                      </span>
                    ) : status ? (
                      <a
                        href={statusCalendarDayUrl({
                          year: month.year,
                          month: month.month,
                          id: day.id,
                        })}
                        aria-label={linkLabel}
                        aria-describedby={tooltipId}
                        class="status-calendar-date__link"
                        data-status-calendar-day-link={day.id}
                        data-status-calendar-marker={status.kind}
                      >
                        <span
                          aria-hidden="true"
                          class="ui-num status-calendar-date__incident-day"
                        >
                          {day.day}
                        </span>
                      </a>
                    ) : (
                      <time
                        datetime={day.id}
                        class="ui-num status-calendar-date__regular-day"
                      >
                        {day.day}
                      </time>
                    )}

                    {status && (
                      <span
                        id={tooltipId}
                        role="tooltip"
                        aria-label={tooltipDescription}
                        aria-hidden="true"
                        class="status-calendar-date__tooltip"
                        data-status-calendar-tooltip={day.id}
                      >
                        <span
                          aria-hidden="true"
                          data-status-calendar-tooltip-text
                        >
                          {tooltipSummary}
                        </span>
                      </span>
                    )}
                  </div>
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<style>
  .status-calendar-month {
    min-width: 0;
  }

  .status-calendar-month__title {
    padding-inline: 0.25rem;
  }

  .status-calendar-month__table {
    width: 100%;
    margin-block-start: 1.5rem;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .status-calendar-month__weekday {
    height: 2rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1rem;
    text-align: center;
  }

  .status-calendar-month__cell {
    position: relative;
    height: 2.75rem;
    padding: 0;
    text-align: center;
    vertical-align: middle;
  }

  .status-calendar-date {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-inline: auto;
    border-radius: var(--radius-sm);
  }

  .status-calendar-date--today {
    border: 2px solid var(--color-primary);
  }

  .status-calendar-date__adjacent-day,
  .status-calendar-date__link,
  .status-calendar-date__regular-day,
  .status-calendar-date__incident-day {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .status-calendar-date__adjacent-day {
    color: color-mix(in oklab, var(--color-text-muted) 40%, transparent);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .status-calendar-date__link,
  .status-calendar-date__regular-day {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .status-calendar-date__link {
    border: 2px solid transparent;
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  .status-calendar-date__link:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 2px;
  }

  .status-calendar-date__link[data-status-calendar-marker='maintenance'],
  .status-calendar-date__link[data-status-calendar-marker='mixed'] {
    border-color: var(--color-warning-graphic);
  }

  .status-calendar-date__incident-day {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
  }

  .status-calendar-date__link:not([data-status-calendar-marker='maintenance'])
    .status-calendar-date__incident-day {
    background: var(--color-danger);
    color: var(--color-danger-foreground);
  }

  .status-calendar-date__regular-day {
    color: var(--color-text);
  }

  .status-calendar-date__tooltip {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.375rem);
    left: 50%;
    width: max-content;
    max-width: min(15rem, calc(100vw - 2rem));
    padding: 0.5rem 0.625rem;
    translate: calc(-50% + var(--status-calendar-tooltip-shift-x, 0px)) 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-1);
    color: var(--color-text);
    display: none;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.4;
    pointer-events: auto;
    text-align: left;
    white-space: pre-line;
  }

  .status-calendar-date__tooltip::before {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 0.375rem;
    content: '';
  }

  .status-calendar-date[data-status-calendar-tooltip-open]
    .status-calendar-date__tooltip {
    display: block;
  }
</style>

---
import { dateTimeFromISO } from '@shelkovo/format';
import { AlertCircleIcon, CheckCircleIcon } from '@shelkovo/ui/icons';

import ShelkovoAreaIcon from '@/components/ShelkovoAreaIcon.astro';
import {
  STATUS_AREAS,
  type StatusArea,
  type StatusService,
} from '@/lib/status/schema';
import {
  buildStatusTimelineLaneLayout,
  buildStatusTimelineProblemSegments,
  getStatusTimelineHitInterval,
  getStatusTimelineSegmentGeometry,
  getStatusTimelineRange,
  STATUS_TIMELINE_HIT_SIZE_PX,
  STATUS_TIMELINE_LANE_LAYOUT_WIDTH_PX,
  type StatusTimelineIncidentInput,
  type StatusTimelineSpan,
} from '@/lib/status/timeline';
import {
  buildStatusTimelineTooltipData,
  buildStatusTimelineTooltipListItemData,
  formatStatusService,
  formatStatusTimelineGroupTitle,
  formatStatusTimelineTooltipGroupLabel,
  formatStatusTimelineTooltipLabel,
} from '@/lib/status/view';
import { toStatusTimelineTooltipItemDto } from '@/lib/status/timeline-tooltip-dto';

interface Props {
  readonly service: StatusService;
  readonly incidents: readonly StatusTimelineIncidentInput[];
  readonly timelineDays?: number;
}

const { service, incidents, timelineDays = 90 } = Astro.props;

const range = getStatusTimelineRange(Date.now(), timelineDays);
const tooltipId = `status-service-timeline-tooltip-${service}-${timelineDays}`;
const serviceLabel = formatStatusService(service);
const visibleSegmentsById = new Map(
  buildStatusTimelineProblemSegments({ incidents, range }).map((segment) => [
    segment.id,
    segment,
  ]),
);

interface TimelineGroup {
  readonly dayKey: string;
  readonly compact: boolean;
  readonly isFuture: boolean;
  readonly items: StatusTimelineIncidentInput[];
  readonly visibleSegments: StatusTimelineSpan[];
}

const toTimelineSortMs = (value?: string): number => {
  const parsed = Date.parse(value ?? '');

  return Number.isFinite(parsed) ? parsed : Number.POSITIVE_INFINITY;
};

const getTimelineDayKey = (value: string): string =>
  dateTimeFromISO(value).toISODate() ?? value.slice(0, 10);

const getTimelineDayStartMs = (valueMs: number): number =>
  dateTimeFromISO(new Date(valueMs).toISOString()).startOf('day').toMillis();

const getTimelineNextDayStartMs = (valueMs: number): number =>
  dateTimeFromISO(new Date(valueMs).toISOString())
    .startOf('day')
    .plus({ days: 1 })
    .toMillis();

const visibleAreas = (
  item: Pick<StatusTimelineIncidentInput, 'areas'>,
): readonly StatusArea[] => item.areas ?? [];

const serializeAreas = (areas: readonly StatusArea[]): string | undefined =>
  areas.length > 0 ? JSON.stringify(areas) : undefined;

const isCompactTimelineCandidate = (
  item: StatusTimelineIncidentInput,
  visibleSegment?: StatusTimelineSpan,
): boolean => {
  if (!visibleSegment) {
    return false;
  }

  const endIso = item.endedIso ?? new Date(visibleSegment.endMs).toISOString();

  return getTimelineDayKey(item.startedIso) === getTimelineDayKey(endIso);
};

const fitTimelineSpanToRange = (
  span: StatusTimelineSpan,
): StatusTimelineSpan | undefined => {
  const spanMs = Math.min(range.spanMs, span.endMs - span.startMs);

  if (spanMs <= 0) {
    return undefined;
  }

  let { startMs, endMs } = span;

  if (startMs < range.startMs) {
    startMs = range.startMs;
    endMs = Math.min(range.endMs, startMs + spanMs);
  }

  if (endMs > range.endMs) {
    endMs = range.endMs;
    startMs = Math.max(range.startMs, endMs - spanMs);
  }

  if (endMs <= startMs) {
    return undefined;
  }

  return {
    startMs,
    endMs,
  };
};

const buildTimelineProblemDaySpan = (
  span: StatusTimelineSpan,
): StatusTimelineSpan | undefined =>
  fitTimelineSpanToRange({
    startMs: getTimelineDayStartMs(span.startMs),
    endMs: getTimelineNextDayStartMs(Math.max(span.startMs, span.endMs - 1)),
  });

const serializeTimelineTooltipItems = (
  items: readonly StatusTimelineIncidentInput[],
): string => JSON.stringify(items.map(toStatusTimelineTooltipItemDto));

const timelineGroups = incidents
  .filter((item) => {
    const visibleSegment = visibleSegmentsById.get(item.id);

    return (
      visibleSegment !== undefined ||
      toTimelineSortMs(item.startedIso) >= range.endMs
    );
  })
  .toSorted(
    (a, b) =>
      toTimelineSortMs(a.startedIso) - toTimelineSortMs(b.startedIso) ||
      toTimelineSortMs(a.endedIso) - toTimelineSortMs(b.endedIso) ||
      a.id.localeCompare(b.id),
  )
  .reduce<TimelineGroup[]>((groups, item) => {
    const visibleSegment = visibleSegmentsById.get(item.id);
    const isCompactCandidate = isCompactTimelineCandidate(item, visibleSegment);
    const last = groups.at(-1);
    const dayKey = getTimelineDayKey(item.startedIso);
    const isFuture = visibleSegment === undefined;

    if (
      last &&
      last.compact &&
      last.isFuture === isFuture &&
      isCompactCandidate &&
      last.dayKey === dayKey
    ) {
      last.items.push(item);

      if (visibleSegment) {
        last.visibleSegments.push(visibleSegment);
      }

      return groups;
    }

    groups.push({
      dayKey,
      compact: isCompactCandidate,
      isFuture,
      items: [item],
      visibleSegments: visibleSegment ? [visibleSegment] : [],
    });

    return groups;
  }, [])
  .map((group) => {
    const [firstItem] = group.items;
    const hasVisibleSpan = group.visibleSegments.length > 0;
    const tooltipItems = group.items.map((item) =>
      buildStatusTimelineTooltipListItemData(item, { nonBreaking: true }),
    );
    const tooltipTitle =
      group.items.length === 1
        ? firstItem.title
        : formatStatusTimelineGroupTitle({
            count: group.items.length,
            startedIso: firstItem.startedIso,
            nonBreaking: true,
          });
    const reachesRangeEnd = group.visibleSegments.some(
      (item) => item.endMs === range.endMs,
    );
    const actualSpan = hasVisibleSpan
      ? {
          startMs: Math.min(
            ...group.visibleSegments.map((item) => item.startMs),
          ),
          endMs: Math.max(...group.visibleSegments.map((item) => item.endMs)),
        }
      : undefined;
    const useCompactMarker = group.compact;
    const geometrySpan = actualSpan
      ? buildTimelineProblemDaySpan(actualSpan)
      : undefined;
    const geometry = geometrySpan
      ? getStatusTimelineSegmentGeometry(geometrySpan, range)
      : undefined;
    const geometryStartIso = geometrySpan
      ? new Date(geometrySpan.startMs).toISOString()
      : undefined;
    const geometryEndIso = geometrySpan
      ? new Date(geometrySpan.endMs).toISOString()
      : undefined;
    const latestEndedIso = group.items
      .map((item) => item.endedIso)
      .filter((item) => item !== undefined)
      .toSorted((a, b) => toTimelineSortMs(a) - toTimelineSortMs(b))
      .at(-1);
    const groupEndIso = group.items.some((item) => !item.endedIso)
      ? undefined
      : latestEndedIso;

    if (group.items.length === 1) {
      const areas = visibleAreas(firstItem);
      const tooltip = buildStatusTimelineTooltipData({
        service,
        incident: firstItem,
        nonBreaking: true,
      });
      const phaseIcon =
        firstItem.kind !== 'incident'
          ? undefined
          : firstItem.phase === 'active'
            ? 'alert'
            : firstItem.endedIso
              ? 'check'
              : undefined;

      return {
        href: firstItem.href,
        hidden: !hasVisibleSpan,
        id: firstItem.id,
        left: geometry?.leftPercent,
        compactMarker: useCompactMarker,
        geometryStartIso,
        geometryEndIso,
        reachesRangeEnd,
        startIso: firstItem.startedIso,
        endIso: groupEndIso,
        statusKind: firstItem.kind,
        tone: firstItem.kind === 'maintenance' ? 'amber' : 'red',
        tooltip,
        tooltipAreas: areas,
        tooltipAreaLabel: tooltip.areaLabel,
        tooltipLabel: formatStatusTimelineTooltipLabel(tooltip),
        tooltipItems: undefined,
        tooltipServiceLabel: undefined,
        tooltipTitle,
        phaseIcon,
        width: geometry?.widthPercent,
      };
    }

    return {
      href: undefined,
      hidden: !hasVisibleSpan,
      id: firstItem.id,
      left: geometry?.leftPercent,
      compactMarker: useCompactMarker,
      geometryStartIso,
      geometryEndIso,
      reachesRangeEnd,
      startIso: firstItem.startedIso,
      endIso: groupEndIso,
      statusKind: group.items.some((item) => item.kind === 'incident')
        ? 'incident'
        : 'maintenance',
      tone: group.items.some((item) => item.kind === 'incident')
        ? 'red'
        : 'amber',
      tooltipAreaLabel: undefined,
      tooltipAreas: undefined,
      tooltipItems: serializeTimelineTooltipItems(group.items),
      tooltipLabel: formatStatusTimelineTooltipGroupLabel({
        serviceLabel,
        title: tooltipTitle,
        items: tooltipItems,
      }),
      tooltipServiceLabel: serviceLabel,
      tooltipTitle,
      width: geometry?.widthPercent,
    };
  });

const timelineLaneLayout = buildStatusTimelineLaneLayout(
  timelineGroups.flatMap((group) =>
    group.hidden || group.left === undefined || group.width === undefined
      ? []
      : [
          getStatusTimelineHitInterval(
            {
              id: group.id,
              leftPercent: group.left,
              widthPercent: group.width,
              compactMarker: group.compactMarker,
              reachesRangeEnd: group.reachesRangeEnd,
            },
            STATUS_TIMELINE_LANE_LAYOUT_WIDTH_PX,
          ),
        ],
  ),
);
const timelineLaneOffsets = timelineLaneLayout.offsetsById;
---

<div
  class="js-status-service-timeline status-service-timeline"
  data-status-timeline
  data-range-days={String(timelineDays)}
  style={`--timeline-hit-size: ${STATUS_TIMELINE_HIT_SIZE_PX}px; --timeline-lane-space: ${timelineLaneLayout.spacePx}px;`}
>
  <div class="status-service-timeline__track">
    <div class="status-service-timeline__segments" data-status-timeline-track>
      {
        timelineGroups.map(
          ({
            compactMarker,
            endIso,
            geometryEndIso,
            geometryStartIso,
            href,
            hidden,
            id,
            left,
            phaseIcon,
            reachesRangeEnd,
            statusKind,
            tone,
            tooltip,
            tooltipAreaLabel,
            tooltipAreas,
            tooltipLabel,
            tooltipItems,
            tooltipServiceLabel,
            tooltipTitle,
            startIso,
            width,
          }) => {
            const TimelineSegment = href ? 'a' : 'button';
            const laneOffset = timelineLaneOffsets.get(id);

            return (
              <TimelineSegment
                href={href}
                type={href ? undefined : 'button'}
                title={tooltipLabel}
                aria-label={tooltipLabel}
                data-incident-id={id}
                data-status-problem
                data-status-kind={statusKind}
                data-status-service={service}
                data-start={startIso}
                data-end={endIso}
                data-geometry-start={geometryStartIso}
                data-geometry-end={geometryEndIso}
                data-tooltip-service-label={
                  tooltip?.serviceLabel ?? tooltipServiceLabel
                }
                data-tooltip-kind-label={tooltip?.kindLabel}
                data-tooltip-title={tooltip?.title}
                data-tooltip-phase-label={tooltip?.phaseLabel}
                data-tooltip-phase-icon={tooltip ? phaseIcon : undefined}
                data-tooltip-period-label={tooltip?.periodLabel}
                data-tooltip-area-label={tooltipAreaLabel}
                data-tooltip-areas={
                  tooltipAreas ? serializeAreas(tooltipAreas) : undefined
                }
                data-tooltip-group-title={tooltip ? undefined : tooltipTitle}
                data-tooltip-items={tooltipItems}
                class:list={[
                  'status-service-timeline__segment status-service-timeline__segment--problem',
                  compactMarker &&
                    'status-service-timeline__segment--compact-marker',
                  reachesRangeEnd &&
                    'status-service-timeline__segment--problem-active-end',
                  tone === 'amber'
                    ? 'status-service-timeline__segment--amber'
                    : 'status-service-timeline__segment--red',
                ]}
                hidden={hidden}
                style={
                  hidden || left === undefined || width === undefined
                    ? undefined
                    : `--segment-left: ${left}; --segment-width: ${width};${laneOffset === undefined ? '' : ` --segment-lane-offset: ${laneOffset}px;`}`
                }
              >
                <span
                  class="status-service-timeline__segment-marker"
                  aria-hidden="true"
                />
              </TimelineSegment>
            );
          },
        )
      }
    </div>
  </div>

  <div
    id={tooltipId}
    class="status-service-timeline__tooltip tooltip-glass"
    data-status-timeline-tooltip
    role="tooltip"
    aria-hidden="true"
    hidden
  >
    <p class="status-service-timeline__tooltip-title">
      <span
        class="status-service-timeline__tooltip-phase-icon status-service-timeline__tooltip-phase-icon--alert"
        data-status-tooltip-phase-icon-alert
        aria-hidden="true"
        hidden
      >
        <AlertCircleIcon class="size-4" />
      </span>
      <span
        class="status-service-timeline__tooltip-phase-icon status-service-timeline__tooltip-phase-icon--check"
        data-status-tooltip-phase-icon-check
        aria-hidden="true"
        hidden
      >
        <CheckCircleIcon class="size-4" />
      </span>
      <span data-status-tooltip-title></span>
      <span
        class="status-service-timeline__tooltip-areas"
        data-status-tooltip-title-areas
        hidden></span>
    </p>
    <p class="status-service-timeline__tooltip-row" data-status-tooltip-period>
    </p>
    <div
      class="status-service-timeline__tooltip-list"
      data-status-tooltip-list
      hidden
    >
    </div>
    <div data-status-tooltip-area-templates hidden>
      {
        STATUS_AREAS.map((area) => (
          <span data-status-tooltip-area-template={area}>
            <ShelkovoAreaIcon area={area} />
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .status-service-timeline {
    position: relative;
    z-index: 0;
    display: grid;
    gap: 0.45rem;
    isolation: isolate;
  }

  .status-service-timeline[data-status-tooltip-open='true'] {
    z-index: 30;
  }

  .status-service-timeline__track {
    position: relative;
    margin-block: var(--timeline-lane-space);
    overflow: visible;
    border: 1px solid
      color-mix(
        in oklab,
        var(--color-border) 92%,
        var(--color-surface-raised) 8%
      );
    border-radius: 999px;
    background: color-mix(
      in oklab,
      var(--color-success) 14%,
      var(--color-surface-raised) 86%
    );
    box-shadow: inset 0 1px 2px oklch(24% 0.04 145 / 0.05);
    height: 1rem;
  }

  .status-service-timeline__segments {
    position: absolute;
    inset: 0 0.2rem;
    container-type: inline-size;
    height: 100%;
  }

  .status-service-timeline__segment {
    --segment-resolved-width: max(
      calc(var(--segment-width) * 1cqw),
      var(--segment-min-width, 0.45rem)
    );
    --segment-bleed-end: 0px;
    position: absolute;
    top: 50%;
    left: max(
      0px,
      min(
        calc(var(--segment-left) * 1%),
        calc(100% - var(--segment-resolved-width))
      )
    );
    width: calc(var(--segment-resolved-width) + var(--segment-bleed-end));
    height: 0.62rem;
    border-radius: 999px;
    transform: translateY(-50%) scaleY(var(--segment-scale, 1));
    transform-origin: center;
    margin: 0;
    border: 0;
    padding: 0;
    font: inherit;
    text-decoration: none;
    appearance: none;
  }

  .status-service-timeline__segment--green {
    background: color-mix(
      in oklab,
      var(--color-success) 82%,
      var(--color-surface-raised) 18%
    );
    pointer-events: none;
    z-index: 1;
  }

  .status-service-timeline__segment--amber {
    --segment-marker-color: var(--color-warning);
    background: var(--segment-marker-color);
    z-index: 2;
  }

  .status-service-timeline__segment--red {
    --segment-marker-color: var(--color-danger);
    background: var(--segment-marker-color);
    z-index: 3;
  }

  .status-service-timeline__segment--problem {
    --segment-hit-size: var(--timeline-hit-size);
    --segment-hit-inline-padding: max(
      0px,
      calc(
        (
            var(--segment-hit-size) - var(--segment-resolved-width) -
              var(--segment-bleed-end)
          ) /
          2
      )
    );
    height: 0.62rem;
    padding: calc((var(--segment-hit-size) - 0.62rem) / 2)
      var(--segment-hit-inline-padding);
    box-sizing: content-box;
    margin-left: calc(var(--segment-hit-inline-padding) * -1);
    background: transparent;
    box-shadow: none;
    cursor: pointer;
    transform: translateY(calc(-50% + var(--segment-lane-offset, 0px)));
    transition: filter 160ms ease;
  }

  .status-service-timeline__segment-marker {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--segment-marker-color);
    box-shadow: 0 0 0 1px
      color-mix(
        in oklab,
        var(--color-success) 14%,
        var(--color-surface-raised) 86%
      );
    pointer-events: none;
    transform: scaleY(var(--segment-scale, 1));
    transform-origin: center;
    transition: transform 160ms ease;
  }

  .status-service-timeline__segment--problem:hover,
  .status-service-timeline__segment--problem:focus-visible {
    --segment-scale: 1.16;
    filter: saturate(1.15) brightness(0.97);
  }

  .status-service-timeline__segment--problem:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .status-service-timeline__segment--problem-active-end {
    --segment-bleed-end: 0.2rem;
  }

  .status-service-timeline__segment--compact-marker {
    --segment-min-width: 0.65rem;
  }

  .status-service-timeline__tooltip {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    z-index: 20;
    display: grid;
    gap: 0.4rem;
    width: min(22rem, calc(100% - 0.5rem));
    max-width: calc(100vw - 1.5rem);
    padding: 0.75rem 0.85rem;
    border: 1px solid
      color-mix(
        in oklab,
        var(--color-border) 56%,
        var(--color-surface-raised) 44%
      );
    border-radius: 1rem;
    background: color-mix(
      in oklab,
      var(--color-surface-raised) 90%,
      transparent
    );
    color: var(--color-text);
    backdrop-filter: blur(5px);
    box-shadow: 0 1.1rem 2.5rem oklch(24% 0.03 230 / 0.18);
    pointer-events: none;
    transform: translateX(-50%);
  }

  .status-service-timeline__tooltip[data-side='above'] {
    top: auto;
    bottom: calc(100% + 0.6rem);
  }

  .status-service-timeline__tooltip-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
  }

  .status-service-timeline__tooltip-row {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .status-service-timeline__tooltip-areas {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.24rem;
    margin-left: 0.35rem;
    align-items: center;
    color: var(--color-text-muted);
    vertical-align: -0.15em;
  }

  .status-service-timeline__tooltip-areas[hidden] {
    display: none;
  }

  .status-service-timeline__tooltip-areas :global(span[role='img']) {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    border-radius: 999px;
    background: color-mix(
      in oklab,
      var(--color-surface-muted) 78%,
      var(--color-surface-raised) 22%
    );
  }

  .status-service-timeline__tooltip-areas :global(svg) {
    max-inline-size: 0.78rem;
    max-block-size: 0.78rem;
  }

  .status-service-timeline__tooltip-list {
    display: grid;
    gap: 0.55rem;
  }

  .status-service-timeline__tooltip-item {
    display: grid;
    gap: 0.4rem;
  }

  .status-service-timeline__tooltip-item
    + .status-service-timeline__tooltip-item {
    padding-top: 0.7rem;
    border-top: 1px solid
      color-mix(
        in oklab,
        var(--color-border) 76%,
        var(--color-surface-raised) 24%
      );
  }

  .status-service-timeline__tooltip-phase-icon {
    display: inline-flex;
    inline-size: 1rem;
    block-size: 1rem;
    flex: none;
    margin-right: 0.18rem;
    align-items: center;
    justify-content: center;
    vertical-align: -0.17em;
  }

  .status-service-timeline__tooltip-phase-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .status-service-timeline__tooltip-phase-icon--alert {
    color: var(--color-danger);
  }

  .status-service-timeline__tooltip-phase-icon--check {
    color: var(--color-success);
  }
</style>

<script>
  import { bindStatusTimelineLazyHydration } from '@/lib/status/timeline.lazy';

  bindStatusTimelineLazyHydration();
</script>

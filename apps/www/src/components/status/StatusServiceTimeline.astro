---
import { AlertCircleIcon, CheckCircleIcon } from '@shelkovo/ui/icons';
import ShelkovoAreaIcon from '@/components/ShelkovoAreaIcon.astro';
import { formatArea } from '@/lib/areas';
import { STATUS_AREAS, type StatusService } from '@/lib/status/schema';
import {
  buildStatusTimelineDays,
  formatTimelineDate,
  formatTimelineDay,
} from '@/lib/status/timeline';
import { buildStatusTimelineRecords } from '@/lib/status/timeline-data';
import type { StatusTimelineIncidentInput } from '@/lib/status/timeline.types';
import { formatStatusService } from '@/lib/status/view';

interface Props {
  readonly service: StatusService;
  readonly incidents: readonly StatusTimelineIncidentInput[];
  readonly timelineDays?: number;
}
const { service, incidents, timelineDays = 90 } = Astro.props;
const nowMs = Date.now();
const records = buildStatusTimelineRecords(
  incidents,
  nowMs,
  Math.max(30, timelineDays),
);
const serviceLabel = formatStatusService(service);
const balloonId = `status-day-${service}`;
const views = [
  { mode: 'mobile', count: 30 },
  { mode: 'desktop', count: timelineDays },
].map((view) => ({
  ...view,
  days: buildStatusTimelineDays(records, nowMs, view.count),
}));
---

<div
  class="status-service-timeline"
  data-status-timeline
  data-status-service={service}
  data-timeline-records={JSON.stringify(records)}
  data-range-days={timelineDays}
>
  {views.map(({ mode, count, days }) => (
    <div data-timeline-view={mode}>
      <div class="status-service-timeline__track" style={`--days: ${count}`}>
        <div
          class="status-service-timeline__grid"
          data-timeline-grid
          aria-hidden="true"
        >
          {days.map((day) => (
            <span data-day={day.id} data-tone={day.tone} />
          ))}
        </div>
        {mode === 'desktop' && (
          <input
            type="range"
            min="0"
            max={count - 1}
            value={count - 1}
            step="1"
            data-timeline-control
            aria-label={`${serviceLabel}: выбрать день`}
            aria-valuetext={formatTimelineDay(days.at(-1)!, records)}
            aria-controls={balloonId}
            aria-haspopup="dialog"
            hidden
          />
        )}
      </div>
      <div class="status-service-timeline__dates">
        <span data-timeline-start>{formatTimelineDate(days[0].id, true)}</span>
        <span>{count} дней</span>
        <span data-timeline-end>
          {formatTimelineDate(days.at(-1)!.id, true)}
        </span>
      </div>
      <ol
        class="ui-visually-hidden"
        data-timeline-text
        aria-label={`${serviceLabel}: хронология по дням`}
      >
        {days.map((day) => (
          <li>{formatTimelineDay(day, records)}</li>
        ))}
      </ol>
    </div>
  ))}
  <section
    id={balloonId}
    class="ui-floating-surface status-service-timeline__balloon"
    data-timeline-balloon
    role="dialog"
    aria-labelledby={`${balloonId}-title`}
    hidden
  >
    <header>
      <h3
        id={`${balloonId}-title`}
        class="ui-floating-surface__context"
        data-timeline-balloon-title
      />
      <button
        type="button"
        class="ui-btn ui-btn-ghost"
        data-timeline-close
        aria-label="Закрыть подробности дня"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div data-timeline-balloon-list />
  </section>
  <p
    class="status-service-timeline__error"
    data-timeline-error
    role="status"
    hidden
  >
    Не удалось открыть подробности, попробуйте обновить страницу
  </p>
  <template data-timeline-icons>
    <span data-phase-icon="alert" aria-hidden="true">
      <AlertCircleIcon />
    </span>
    <span data-phase-icon="check" aria-hidden="true">
      <CheckCircleIcon />
    </span>
    {STATUS_AREAS.map((area) => (
      <span data-area-icon={area}>
        <span aria-hidden="true">
          <ShelkovoAreaIcon area={area} />
        </span>
        <span>{formatArea(area).replace(/^Шелково /u, '')}</span>
      </span>
    ))}
  </template>
</div>

<style is:global>
  .status-service-timeline {
    position: relative;
    min-width: 0;
  }
  .status-service-timeline [hidden] {
    display: none !important;
  }
  .status-service-timeline [data-timeline-view='desktop'] {
    display: none;
  }
  .status-service-timeline__track {
    position: relative;
    height: 24px;
    container-type: inline-size;
  }
  .status-service-timeline__grid {
    position: absolute;
    inset: 3px 0;
    display: grid;
    grid-template-columns: repeat(var(--days), minmax(0, 1fr));
    gap: 3px;
  }
  .status-service-timeline__grid > span {
    border-radius: 2px;
    background: color-mix(
      in oklab,
      var(--color-success) 27%,
      var(--color-surface) 73%
    );
  }
  .status-service-timeline__grid [data-tone='amber'] {
    background: var(--color-warning);
    box-shadow: inset 0 -3px var(--color-warning-graphic);
  }
  .status-service-timeline__grid [data-tone='red'] {
    background: var(--color-danger);
  }
  .status-service-timeline__grid [data-selected] {
    outline: 2px solid var(--color-text);
    outline-offset: 1px;
  }
  .status-service-timeline input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 24px;
    border: 0;
    margin: 0;
    padding: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
    --thumb: calc((100cqw - (var(--days) - 1) * 3px) / var(--days));
  }
  .status-service-timeline input::-webkit-slider-runnable-track {
    height: 24px;
    border: 0;
    background: transparent;
  }
  .status-service-timeline input::-webkit-slider-thumb {
    appearance: none;
    width: var(--thumb);
    height: 24px;
    border: 0;
    background: transparent;
  }
  .status-service-timeline input::-moz-range-track {
    height: 24px;
    border: 0;
    background: transparent;
  }
  .status-service-timeline input::-moz-range-thumb {
    width: var(--thumb);
    height: 24px;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .status-service-timeline input:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .status-service-timeline__dates {
    display: flex;
    justify-content: space-between;
    gap: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    margin-top: 0.25rem;
  }

  .status-service-timeline__error {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .status-service-timeline__balloon {
    position: fixed;
    z-index: 50;
    width: 348px;
    max-width: calc(100vw - 16px);
  }
  .status-service-timeline__balloon::before {
    content: '';
    position: absolute;
    left: var(--arrow-left);
    top: -5px;
    width: 8px;
    height: 8px;
    background: var(--color-surface);
    border-left: 1px solid var(--surface-glass-border);
    border-top: 1px solid var(--surface-glass-border);
    transform: rotate(45deg);
  }
  .status-service-timeline__balloon[data-side='above']::before {
    top: auto;
    bottom: -5px;
    transform: rotate(225deg);
  }
  .status-service-timeline__balloon header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .status-service-timeline__balloon button {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    padding: 3px;
    color: var(--color-text);
  }
  .status-service-timeline__balloon [data-timeline-close] > span {
    display: block;
    line-height: 1;
  }
  .status-service-timeline__balloon [data-timeline-balloon-list] {
    overflow-y: auto;
    overscroll-behavior: contain;
    max-height: var(--list-height, 50vh);
  }
  .status-service-timeline__event + .status-service-timeline__event {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .status-service-timeline__event-title {
    overflow-wrap: anywhere;
  }
  .status-service-timeline__event-meta {
    margin-top: 0.25rem;
    overflow-wrap: anywhere;
  }
  .status-service-timeline__event-phase {
    display: block;
  }
  .status-service-timeline__event-areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.375rem;
  }
  .status-service-timeline__event-title svg {
    width: 1rem;
    height: 1rem;
    display: inline-block;
    vertical-align: -0.15em;
    margin-right: 0.25rem;
  }
  .status-service-timeline__event [data-phase-icon='alert'] {
    color: var(--color-danger);
  }
  .status-service-timeline__event [data-phase-icon='check'] {
    color: var(--color-success);
  }
  .status-service-timeline__event [data-area-icon] {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .status-service-timeline__event [data-area-icon] > [aria-hidden='true'] {
    position: relative;
    top: 1px;
  }
  @media (min-width: 64rem) {
    .status-service-timeline [data-timeline-view='mobile'] {
      display: none;
    }
    .status-service-timeline [data-timeline-view='desktop'] {
      display: block;
    }
  }
  @media (max-width: 63.999rem) {
    .status-service-timeline__balloon {
      display: none;
    }
  }
</style>

<script>
  import { bindStatusTimelineLazyHydration } from '@/lib/status/timeline.lazy';
  bindStatusTimelineLazyHydration();
</script>

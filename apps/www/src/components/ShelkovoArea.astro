---
import {
  ForestIcon,
  ParkIcon,
  RiverIcon,
  VillageIcon,
} from '@shelkovo/ui/icons';

import { formatShortArea } from '@/lib/areas';
import type { ShelkovoAreaProps as Props } from './shelkovo-area.types';

const { area }: Props = Astro.props;

const AREA_ICONS = {
  river: RiverIcon,
  forest: ForestIcon,
  park: ParkIcon,
  village: VillageIcon,
} as const;

const label = formatShortArea(area);
const Icon = AREA_ICONS[area];
---

<span class="shelkovo-area">
  {' '}
  <Icon />
  <span>{label}</span>{' '}
</span>

<style>
  .shelkovo-area {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375em;
    white-space: nowrap;
  }

  .shelkovo-area > :global(svg) {
    display: block;
    width: auto;
    height: 1em;
    flex-shrink: 0;
  }
</style>

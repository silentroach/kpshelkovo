---
import { CalendarPlusIcon, MapPinIcon } from '@shelkovo/ui/icons';
import ResourceLink from '@shelkovo/ui/ResourceLink.astro';
import { formatDynamicHtml } from '@shelkovo/markdown';
import MapCardShell from '@/components/MapCardShell.astro';
import { EVENT_STATUS_LABELS } from '@/lib/events/view';
import type { NewsEvent } from '@/lib/news/types';
import {
  buildNewsEventMapEmbedUrl,
  buildNewsEventMapUrl,
  formatNewsEventMonth,
  formatNewsEventRange,
} from '@/lib/news/view';

interface Props {
  readonly event: NewsEvent;
}
const { event } = Astro.props;
const mapUrl = buildNewsEventMapUrl(event);
const eventDay = String(Number(event.startsDate.slice(8, 10)));
const eventMonth = formatNewsEventMonth(event.startsIso);
const eventTime = event.endsTime
  ? `${event.startsTime}–${event.endsTime}`
  : (event.startsTime ?? 'Время уточняется');
const eventRange =
  event.through ||
  (event.endsIso && event.endsIso.slice(0, 10) !== event.startsIso.slice(0, 10))
    ? formatNewsEventRange(event)
    : eventTime;
const titleId = `news-event-title-${event.slug}`;
---

<aside aria-labelledby={titleId} data-pagefind-body>
  <MapCardShell
    treatment="compact"
    embedUrl={buildNewsEventMapEmbedUrl(event, { centerOffsetYPx: 50 })}
  >
    <div class="news-event-content">
      <div class="news-event-date">
        {
          event.status === 'cancelled' && (
            <span
              class="news-event-cancelled"
              role="img"
              aria-label={EVENT_STATUS_LABELS.cancelled}
              title={EVENT_STATUS_LABELS.cancelled}
              data-pagefind-ignore
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="m9 9 6 6m0-6-6 6" />
              </svg>
            </span>
          )
        }
        <time datetime={event.startsIso}>
          <span class="news-event-day">{eventDay}</span>{' '}
          <span class="news-event-month">{eventMonth}</span>
        </time>
      </div>
      <h2 id={titleId} class="news-event-title">
        <a href={event.url} set:html={formatDynamicHtml(event.title)} />
      </h2>
      <ul class="news-event-meta">
        <li>
          <svg
            viewBox="0 0 24 24"
            class="news-event-icon"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="8.25"></circle><path
              d="M12 7.75v4.75l3 1.75"></path></svg
          >
          <span>{formatDynamicHtml(eventRange)}</span>
        </li>
        <li>
          <MapPinIcon class="news-event-icon" />
          <span>
            {
              event.place ? (
                <a
                  href={event.place.url}
                  class="site-text-link"
                  set:html={formatDynamicHtml(event.place.name)}
                />
              ) : (
                <span
                  set:html={formatDynamicHtml(
                    event.location ??
                      (event.coordinates
                        ? 'Место на карте'
                        : 'Место уточняется'),
                  )}
                />
              )
            }
            {
              event.locationDetails && (
                <span
                  set:html={formatDynamicHtml(`, ${event.locationDetails}`)}
                />
              )
            }
          </span>
        </li>
      </ul>
      {
        event.status === 'conditional' && (
          <p>
            <strong data-status={event.status}>
              {EVENT_STATUS_LABELS[event.status]}
            </strong>
          </p>
        )
      }
      <div class="news-event-actions" data-pagefind-ignore>
        {
          event.icsUrl && event.status !== 'cancelled' && (
            <ResourceLink
              href={event.icsUrl}
              download={`${event.slug}.ics`}
              class="news-event-action news-event-action--calendar"
              aria-label="Добавить в календарь"
              title="Добавить в календарь"
            >
              <CalendarPlusIcon class="news-event-icon news-event-icon--calendar" />
            </ResourceLink>
          )
        }
        {
          mapUrl && (
            <a
              href={mapUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="news-event-action"
              aria-label="Открыть на Яндекс Картах"
              title="Открыть на Яндекс Картах"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="news-event-icon"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M19 10.2c0 5.1-7 10.05-7 10.05s-7-4.95-7-10.05a7 7 0 1 1 14 0Z" />
                <circle cx="12" cy="10.2" r="2.35" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </MapCardShell>
</aside>

<style>
  aside {
    min-width: 0;
  }
  .news-event-content {
    display: grid;
    gap: 0.85rem;
  }
  .news-event-date {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-border) 78%, var(--color-accent) 22%);
    padding-bottom: 0.75rem;
    color: var(--color-primary);
  }
  .news-event-date time {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .news-event-cancelled {
    display: flex;
    flex: none;
    color: var(--color-danger-text);
  }
  .news-event-cancelled svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .news-event-day {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.9;
  }
  .news-event-month {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
  }
  .news-event-title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 0.98rem + 0.42vw, 1.22rem);
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .news-event-title a {
    color: inherit;
    text-decoration: none;
  }
  .news-event-title a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .news-event-meta {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .news-event-meta li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }
  [data-status='conditional'] {
    color: var(--color-warning-text);
  }
  .news-event-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.55rem;
    padding-top: 0.15rem;
  }
  .news-event-actions :global(.news-event-action) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.45rem;
    height: 2.45rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.62rem;
    background: color-mix(
      in oklab,
      var(--color-surface-raised) 82%,
      transparent
    );
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }
  .news-event-actions :global(.news-event-action--calendar) {
    border-color: color-mix(
      in oklab,
      var(--color-accent) 62%,
      var(--color-border) 38%
    );
    color: var(--color-accent-text);
  }
  .news-event-actions :global(a:hover) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  aside :global(a:focus-visible) {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 2px;
  }
  .news-event-icon,
  aside :global(.news-event-icon) {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }
  aside :global(.news-event-icon--calendar) {
    transform: translateY(-0.04rem);
  }
</style>

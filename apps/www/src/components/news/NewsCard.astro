---
import { StarIcon } from '@shelkovo/ui/icons';
import type { NewsListArticle } from '../../lib/news/types';
import NewsMeta from './NewsMeta.astro';
import NewsTagList from './NewsTagList.astro';

interface Props {
  readonly article: NewsListArticle;
  readonly featured?: boolean;
}

const { article, featured = false } = Astro.props;
---

<article class:list={[featured ? 'ui-shell-strong' : 'ui-shell', 'news-card']}>
  {
    featured && article.cover && (
      <img
        src={article.cover.url}
        alt={article.cover.alt}
        loading="lazy"
        width={article.cover.width}
        height={article.cover.height}
        class="news-card__cover"
      />
    )
  }

  <div class="news-card__content">
    <div class="news-card__header">
      <h3 class="ui-entry-title news-card__title">
        <a href={article.url} class="ui-link">{article.title}</a>
        {
          article.pinned && (
            <>
              <span
                class="news-card__pinned-icon"
                title="закреплено сверху"
                aria-hidden="true"
              >
                <StarIcon />
              </span>
              <span class="news-card__pinned-label">Закреплено сверху</span>
            </>
          )
        }
      </h3>

      <NewsMeta
        publishedIso={article.publishedIso}
        author={article.author}
        fullAuthorName
      />
    </div>

    <p class="ui-copy news-card__summary">{article.summary}</p>

    <NewsTagList items={article.tags} compact />
  </div>
</article>

<style>
  .news-card {
    height: 100%;
    overflow: hidden;
  }

  .news-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-border-strong);
    object-fit: cover;
  }

  .news-card__content {
    padding: 1.25rem;
  }

  .news-card__content > :global(* + *) {
    margin-block-start: 1rem;
  }

  .news-card__header > :global(* + *) {
    margin-block-start: 0.75rem;
  }

  .news-card__title {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .news-card__pinned-icon {
    display: inline-flex;
    flex-shrink: 0;
    margin-block-start: 0.25rem;
    color: var(--color-star);
  }

  .news-card__pinned-icon > :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .news-card__pinned-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .news-card__summary {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .news-card__content {
      padding: 1.5rem;
    }
  }
</style>

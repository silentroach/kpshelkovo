---
import { formatTextHtml } from '@shelkovo/typography';
import type { NewsListArticle } from '../../lib/news/types';
import NewsMeta from './NewsMeta.astro';
import NewsTagList from './NewsTagList.astro';

interface Props {
  readonly article: NewsListArticle;
  readonly featured?: boolean;
}

const { article, featured = false } = Astro.props;
---

<article
  class:list={[
    featured ? 'ui-shell-strong' : 'ui-shell',
    'news-card',
    { 'news-card--pinned': article.pinned },
  ]}
>
  <div class="news-card__content">
    <div class="news-card__header">
      <h3 class="ui-entry-title news-card__title">
        <a
          href={article.url}
          class="ui-link"
          set:html={formatTextHtml(article.title)}
        />
      </h3>

      <div class="news-card__meta">
        {article.pinned && (
          <span class="news-card__pinned-label">Закреплено</span>
        )}
        <NewsMeta
          publishedIso={article.publishedIso}
          author={article.author}
          fullAuthorName
          className="news-meta--list"
        />
      </div>
    </div>

    <p
      class="ui-copy news-card__summary"
      set:html={formatTextHtml(article.summary)}
    />

    <NewsTagList items={article.tags} compact />
  </div>
</article>

<style>
  .news-card {
    height: 100%;
    overflow: hidden;
  }

  .news-card--pinned {
    background: color-mix(
      in oklab,
      var(--color-accent-soft) 35%,
      var(--color-bg)
    );
  }

  .news-card__content {
    padding: 1.25rem;
  }

  .news-card__content > :global(* + *) {
    margin-block-start: 1rem;
  }

  .news-card__header > :global(* + *) {
    margin-block-start: 0.75rem;
  }

  .news-card__title {
    font-size: 1.5rem;
  }

  .news-card__title a {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    text-decoration-line: none;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: none;
  }

  .news-card__title a:is(:hover, :focus-visible) {
    color: var(--color-primary);
    text-decoration-line: underline;
  }

  .news-card__title a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .news-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }

  .news-card__pinned-label {
    color: var(--color-accent-text);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5rem;
  }

  .news-card__summary {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .news-card__content {
      padding: 1.5rem;
    }
  }
</style>

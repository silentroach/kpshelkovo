---
import { Image } from 'astro:assets';
import { renderMarkdown } from '@/lib/markdown/render';
import type { NewsPhoto } from '@/lib/news/types';

interface Props {
  readonly photos: readonly NewsPhoto[];
  readonly title?: string;
  readonly heading?: 'h2' | 'h3' | 'h4';
}

const { photos, title = 'Фото', heading = 'h2' } = Astro.props;

const Heading = heading;
const MAX_FULL_WIDTH = 1132;
const MAX_RENDERED_WIDTH = 1600;
const MAX_FULL_RENDERED_WIDTH = 2560;
const RESPONSIVE_WIDTHS = [480, 768, 960, 1280, MAX_RENDERED_WIDTH];
const FULL_RESPONSIVE_WIDTHS = [
  ...RESPONSIVE_WIDTHS,
  MAX_FULL_WIDTH * 2,
  MAX_FULL_RENDERED_WIDTH,
];
const galleryPhotos = photos.map((photo, index) => {
  const fullWidth =
    photos.length >= 3 &&
    (index === 0 || (photos.length % 2 === 0 && index === photos.length - 1));
  const maxRenderedWidth = fullWidth
    ? MAX_FULL_RENDERED_WIDTH
    : MAX_RENDERED_WIDTH;
  const width = Math.min(photo.width, maxRenderedWidth);

  return {
    url: photo.url,
    alt: photo.alt,
    captionHtml: photo.caption ? renderMarkdown(photo.caption) : undefined,
    fullWidth,
    renderedWidth: width,
    renderedHeight: Math.round((photo.height * width) / photo.width),
    widths: (fullWidth ? FULL_RESPONSIVE_WIDTHS : RESPONSIVE_WIDTHS).filter(
      (candidate) => candidate <= width,
    ),
    sizes: fullWidth
      ? `(min-width: 1180px) ${MAX_FULL_WIDTH}px, calc(100vw - 2.5rem)`
      : '(min-width: 1180px) 558px, (min-width: 768px) calc((100vw - 3.5rem) / 2), calc(100vw - 2.5rem)',
  };
});
---

{
  photos.length > 0 && (
    <section class="border-t border-border px-5 pt-6 md:px-6 md:pt-8">
      <div class="space-y-4" data-pagefind-body>
        <Heading
          id="news-photos"
          class="ui-prose-title"
          data-pagefind-weight="0"
        >
          {title}
        </Heading>

        <div class="grid gap-x-4 gap-y-6 md:grid-cols-2">
          {galleryPhotos.map((photo) => (
            <figure
              class:list={[
                'space-y-2',
                photo.fullWidth ? 'md:col-span-2' : undefined,
              ]}
            >
              <a
                href={photo.url}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`Открыть фото: ${photo.alt}`}
                class:list={[
                  'block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
                  photo.fullWidth
                    ? undefined
                    : 'md:aspect-[3/4] md:overflow-hidden',
                ]}
              >
                <Image
                  src={photo.url}
                  width={photo.renderedWidth}
                  height={photo.renderedHeight}
                  widths={photo.widths}
                  sizes={photo.sizes}
                  format="webp"
                  quality={82}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'h-auto w-full border border-border bg-surface-muted',
                    photo.fullWidth ? undefined : 'md:h-full md:object-cover',
                  ]}
                />
              </a>
              {photo.captionHtml && (
                <figcaption
                  class="ui-media-caption"
                  data-pagefind-weight="0.7"
                  set:html={photo.captionHtml}
                />
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

---
import { Image } from 'astro:assets';
import { renderMarkdown } from '@/lib/markdown/render';
import type { NewsPhoto } from '@/lib/news/types';

interface Props {
  readonly photos: readonly NewsPhoto[];
  readonly title?: string;
  readonly heading?: 'h2' | 'h3' | 'h4';
}

const { photos, title = 'Фото', heading = 'h2' } = Astro.props;

const Heading = heading;
const MAX_FULL_WIDTH = 1132;
const MAX_RENDERED_WIDTH = 1600;
const MAX_FULL_RENDERED_WIDTH = 2560;
const RESPONSIVE_WIDTHS = [480, 768, 960, 1280, MAX_RENDERED_WIDTH];
const FULL_RESPONSIVE_WIDTHS = [
  ...RESPONSIVE_WIDTHS,
  MAX_FULL_WIDTH * 2,
  MAX_FULL_RENDERED_WIDTH,
];
const galleryPhotos = photos.map((photo, index) => {
  const fullWidth =
    photos.length >= 3 &&
    (index === 0 || (photos.length % 2 === 0 && index === photos.length - 1));
  const maxRenderedWidth = fullWidth
    ? MAX_FULL_RENDERED_WIDTH
    : MAX_RENDERED_WIDTH;
  const width = Math.min(photo.width, maxRenderedWidth);

  return {
    url: photo.url,
    alt: photo.alt,
    captionHtml: photo.caption ? renderMarkdown(photo.caption) : undefined,
    fullWidth,
    renderedWidth: width,
    renderedHeight: Math.round((photo.height * width) / photo.width),
    widths: (fullWidth ? FULL_RESPONSIVE_WIDTHS : RESPONSIVE_WIDTHS).filter(
      (candidate) => candidate <= width,
    ),
    sizes: fullWidth
      ? `(min-width: 1180px) ${MAX_FULL_WIDTH}px, calc(100vw - 2.5rem)`
      : '(min-width: 1180px) 558px, (min-width: 768px) calc((100vw - 3.5rem) / 2), calc(100vw - 2.5rem)',
  };
});
---

{
  photos.length > 0 && (
    <section class="news-photos">
      <div class="news-photos__body" data-pagefind-body>
        <Heading
          id="news-photos"
          class="ui-prose-title"
          data-pagefind-weight="0"
        >
          {title}
        </Heading>

        <div class="news-photos__gallery">
          {galleryPhotos.map((photo) => (
            <figure
              class:list={[
                'news-photos__figure',
                photo.fullWidth ? 'news-photos__figure--full' : undefined,
              ]}
            >
              <a
                href={photo.url}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`Открыть фото: ${photo.alt}`}
                class:list={[
                  'news-photos__link',
                  photo.fullWidth ? undefined : 'news-photos__link--cropped',
                ]}
              >
                <Image
                  src={photo.url}
                  width={photo.renderedWidth}
                  height={photo.renderedHeight}
                  widths={photo.widths}
                  sizes={photo.sizes}
                  format="webp"
                  quality={82}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'news-photos__image',
                    photo.fullWidth ? undefined : 'news-photos__image--cropped',
                  ]}
                />
              </a>
              {photo.captionHtml && (
                <figcaption
                  class="ui-media-caption"
                  data-pagefind-weight="0.7"
                  set:html={photo.captionHtml}
                />
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .news-photos {
    padding: 1.5rem 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  .news-photos__body,
  .news-photos__figure {
    display: flex;
    flex-direction: column;
  }

  .news-photos__body {
    gap: 1rem;
  }

  .news-photos__gallery {
    display: grid;
    column-gap: 1rem;
    row-gap: 1.5rem;
  }

  .news-photos__figure {
    gap: 0.5rem;
    margin: 0;
  }

  .news-photos__link {
    display: block;
  }

  .news-photos__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .news-photos__image {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }

  @media (min-width: 48rem) {
    .news-photos {
      padding: 2rem 1.5rem 0;
    }

    .news-photos__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .news-photos__figure--full {
      grid-column: span 2 / span 2;
    }

    .news-photos__link--cropped {
      overflow: hidden;
      aspect-ratio: 3 / 4;
    }

    .news-photos__image--cropped {
      height: 100%;
      object-fit: cover;
    }
  }
</style>

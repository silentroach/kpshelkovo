---
import type { NewsListArticle } from '../../lib/news/types';
import NewsCard from './NewsCard.astro';

interface Props {
  readonly articles: readonly NewsListArticle[];
  readonly featured?: boolean;
  readonly empty?: string;
  readonly hideFirstBorder?: boolean;
}

const {
  articles,
  featured = false,
  empty,
  hideFirstBorder = false,
} = Astro.props;
const flushFirstBorder = !featured && hideFirstBorder;
---

{
  articles.length > 0 ? (
    <ul
      role={featured ? 'list' : undefined}
      class:list={[
        featured ? 'news-list--grid' : 'news-list--stacked',
        flushFirstBorder && 'news-list--flush-first',
      ]}
    >
      {articles.map((article) => (
        <li>
          <NewsCard article={article} featured={featured} />
        </li>
      ))}
    </ul>
  ) : (
    empty && (
      <div class="ui-shell news-list__empty">
        <p class="ui-copy news-list__empty-message">{empty}</p>
      </div>
    )
  )
}

<style>
  .news-list--grid {
    display: grid;
    gap: 1rem;
  }

  .news-list--stacked > li:not(:last-child) {
    margin-block-end: 1rem;
  }

  .news-list__empty {
    padding: 1.5rem 1.25rem;
  }

  .news-list__empty-message {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .news-list__empty {
      padding: 1.75rem 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .news-list--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import ShelkovoAreaIcon from '../ShelkovoAreaIcon.astro';
import LinkWithIcon from '@shelkovo/ui/LinkWithIcon.astro';
import type { NewsArea } from '../../lib/news/schema';
import type { NewsAuthor } from '../../lib/news/types';
import { formatNewsAuthor, formatNewsDate } from '../../lib/news/view';

interface Props {
  readonly publishedIso: string;
  readonly author?: Pick<NewsAuthor, 'name' | 'shortName' | 'url' | 'kind'>;
  readonly fullAuthorName?: boolean;
  readonly areas?: readonly NewsArea[];
  readonly appliesToAllAreas?: boolean;
  readonly sourceUrl?: string;
  readonly className?: string;
}

const {
  publishedIso,
  author,
  fullAuthorName = false,
  areas = [],
  appliesToAllAreas = true,
  sourceUrl,
  className,
} = Astro.props;

const visibleAreas = appliesToAllAreas ? [] : areas;
---

<div class:list={['news-meta', className]}>
  <time datetime={publishedIso} class="news-meta-date">
    {formatNewsDate(publishedIso)}
  </time>
  {author &&
    author.kind !== 'editorial' &&
    (author.url ? (
      <a href={author.url} class="ui-link news-meta-author">
        {formatNewsAuthor(author, { short: !fullAuthorName })}
      </a>
    ) : (
      <span>{formatNewsAuthor(author, { short: !fullAuthorName })}</span>
    ))}
  {visibleAreas.map((area) => (
    <ShelkovoAreaIcon area={area} />
  ))}
  {sourceUrl && <LinkWithIcon href={sourceUrl} ariaLabelPrefix="Источник" />}
</div>

<style>
  .news-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .news-meta-date {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .news-meta--list {
    min-width: 0;
    gap: 0.25rem 1rem;
    overflow-wrap: anywhere;
  }

  .news-meta-author,
  .news-meta :global(.link-with-icon) {
    color: var(--color-text-muted);
    font-weight: 400;
    text-decoration-line: none;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .news-meta-author:is(:hover, :focus-visible),
  .news-meta :global(.link-with-icon:is(:hover, :focus-visible)) {
    color: var(--color-primary);
    text-decoration-line: underline;
  }

  .news-meta-author:focus-visible,
  .news-meta :global(.link-with-icon:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>

---
import {
  ForestIcon,
  ParkIcon,
  RiverIcon,
  VillageIcon,
} from '@shelkovo/ui/icons';

import { formatArea, type Area } from '@/lib/areas';

interface Props {
  readonly area: Area;
}

const { area }: Props = Astro.props;

const AREA_ICONS = {
  river: RiverIcon,
  forest: ForestIcon,
  park: ParkIcon,
  village: VillageIcon,
} as const;

const label = formatArea(area);
const Icon = AREA_ICONS[area];
---

<span
  title={label}
  aria-label={label}
  data-pagefind-index-attrs="aria-label"
  role="img"
  class="area-icon"
>
  <Icon />
</span>

<style>
  .area-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .area-icon > :global(svg) {
    display: block;
    width: auto;
    height: 1rem;
  }
</style>

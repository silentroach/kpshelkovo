---
import { formatTextHtml } from '@shelkovo/typography';

import { getPlaceStatusContext } from '@/lib/places/related';
import type { PlaceRelatedMaterials } from '@/lib/places/related-types';

interface Props {
  readonly items: PlaceRelatedMaterials['priority'];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section
    class="place-alerts"
    aria-label="Ограничения и работы"
    data-pagefind-ignore="all"
  >
    <ul>
      {items.map(({ ref, incident }) => {
        const { state, period } = getPlaceStatusContext(incident);
        return (
          <li class:list={['place-alert', `place-alert--${state.tone}`]}>
            <p class="place-alert__state">{state.label}</p>
            <a
              class="site-text-link place-alert__title"
              href={ref.htmlUrl}
              set:html={formatTextHtml(ref.title)}
            />
            <p class="place-alert__period" set:html={formatTextHtml(period)} />
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .place-alerts ul {
    display: grid;
    gap: 0.75rem;
  }
  .place-alert {
    padding: 0.875rem 1rem;
    border-inline-start: 3px solid var(--color-info-border);
    background: var(--color-info-soft);
    overflow-wrap: anywhere;
  }
  .place-alert--danger {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
  }
  .place-alert--warning {
    border-color: var(--color-warning);
    background: var(--color-warning-soft);
  }
  .place-alert__state {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    margin-block-end: 0.25rem;
  }
  .place-alert__title {
    font-weight: 600;
    line-height: 1.5;
  }
  .place-alert__period {
    margin-block-start: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
</style>

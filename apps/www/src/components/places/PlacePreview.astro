---
import MapPreview from '@/components/maps/MapPreview.astro';
import type { MapPreviewData } from '@/components/maps/map-preview.types';

import { PLACE_MARKER_IMAGES } from './marker-images';
import type { PlacePreviewProps as Props } from './place-preview.types';

const { place } = Astro.props;
const marker = place.marker ? PLACE_MARKER_IMAGES[place.marker] : undefined;
const preview = {
  coordinates: place.coordinates,
  geometry: place.geometry,
  openingHours: place.openingHours,
  interactive: true,
  copyrightsPosition: 'bottom right',
} satisfies MapPreviewData;
---

<div class="place-preview">
  <MapPreview
    preview={preview}
    label={`Местоположение: ${place.name}`}
    mapUrl={place.mapUrl}
  >
    <div class="place-preview__marker" aria-hidden="true">
      {
        marker ? (
          <img
            src={marker.src}
            width={marker.width}
            height={marker.height}
            alt=""
            draggable="false"
          />
        ) : (
          <span class="ui-map-marker" />
        )
      }
      {place.openingHours && <span class="place-preview__closed-indicator" />}
    </div>
  </MapPreview>
</div>

<style>
  .place-preview {
    height: 15rem;
    overflow: hidden;
    border: 1px solid
      color-mix(
        in oklab,
        var(--color-border-strong) 76%,
        var(--color-primary) 24%
      );
    border-radius: 1rem;
    background: var(--color-surface-raised);
    box-shadow: 0 0.65rem 1.55rem var(--color-shadow);
  }

  .place-preview__marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .place-preview__marker img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: var(--place-preview-marker-filter, saturate(1))
      drop-shadow(0 1px 1px white) drop-shadow(0 2px 3px rgb(0 0 0 / 18%));
    transition: filter 0.15s ease;
  }

  .place-preview__marker[data-open='false'] {
    --place-preview-marker-filter: grayscale(1);
  }

  .place-preview__marker .ui-map-marker {
    filter: var(--place-preview-marker-filter, saturate(1));
    transition: filter 0.15s ease;
  }

  .place-preview__closed-indicator {
    position: absolute;
    top: -0.375rem;
    right: -0.375rem;
    z-index: 1;
    display: none;
    box-sizing: border-box;
    width: 0.75rem;
    height: 0.75rem;
    border: 0.09375rem solid currentColor;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 0.0625rem var(--color-surface-raised);
    color: var(--color-text);
    pointer-events: none;
  }

  .place-preview__closed-indicator::before,
  .place-preview__closed-indicator::after {
    position: absolute;
    left: 50%;
    border-radius: 999px;
    background: currentColor;
    content: '';
    transform-origin: left center;
  }

  .place-preview__closed-indicator::before {
    top: 0.125rem;
    width: 0.09375rem;
    height: 0.25rem;
    transform: translateX(-50%);
  }

  .place-preview__closed-indicator::after {
    top: calc(50% - 0.046875rem);
    width: 0.21875rem;
    height: 0.09375rem;
    transform: rotate(30deg);
  }

  .place-preview__marker[data-open='false'] .place-preview__closed-indicator {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .place-preview__marker img,
    .place-preview__marker .ui-map-marker {
      transition: none;
    }
  }

  @media (min-width: 60rem) {
    .place-preview {
      height: 20rem;
    }
  }
</style>

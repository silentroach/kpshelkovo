---
import { PLACE_MARKER_IMAGES } from './marker-images';
import type {
  PlacePreviewProps as Props,
  PlacePreviewData,
} from './place-preview.types';

const { place } = Astro.props;
const marker = place.marker ? PLACE_MARKER_IMAGES[place.marker] : undefined;
const preview = {
  coordinates: place.coordinates,
  geometry: place.geometry,
  openingHours: place.openingHours,
} satisfies PlacePreviewData;
---

<place-map-preview
  class="place-preview"
  data-preview={JSON.stringify(preview)}
  role="group"
  aria-label={`Местоположение: ${place.name}`}
>
  <div class="place-preview__canvas" data-canvas inert></div>
  <div class="place-preview__message" data-fallback>
    <p data-message role="status">Местоположение доступно в Яндекс Картах.</p>
    <a href={place.mapUrl} class="site-text-link">Открыть в Яндекс Картах ↗</a>
  </div>
  <template>
    <div class="place-preview__marker" aria-hidden="true">
      {
        marker ? (
          <img
            src={marker.src}
            width={marker.width}
            height={marker.height}
            alt=""
            draggable="false"
          />
        ) : (
          <span class="ui-map-marker" />
        )
      }
      {place.openingHours && <span class="place-preview__closed-indicator" />}
    </div>
  </template>
</place-map-preview>

<script>
  import { PlacePreviewElement } from './place-preview';

  if (!customElements.get('place-map-preview')) {
    customElements.define('place-map-preview', PlacePreviewElement);
  }
</script>

<style>
  .place-preview {
    display: block;
    position: relative;
    height: 15rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }

  .place-preview__canvas {
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .place-preview__canvas :global(canvas) {
    filter: saturate(0.7);
  }

  .place-preview__canvas :global(.ymaps3--map) {
    /* The SDK sets touch-action: none inline even with behaviors disabled. */
    touch-action: pan-y !important;
  }

  .place-preview__canvas :global(:is(a, button):focus-visible) {
    outline: 0.1875rem solid var(--color-focus);
    outline-offset: 0.125rem;
  }

  .place-preview__message {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .place-preview__message[hidden] {
    display: none;
  }

  .place-preview__message a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
  }

  .place-preview__marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .place-preview__marker img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: var(--place-preview-marker-filter, saturate(1))
      drop-shadow(0 1px 1px white) drop-shadow(0 2px 3px rgb(0 0 0 / 18%));
    transition: filter 0.15s ease;
  }

  .place-preview__marker[data-open='false'] {
    --place-preview-marker-filter: grayscale(1);
  }

  .place-preview__marker .ui-map-marker {
    filter: var(--place-preview-marker-filter, saturate(1));
    transition: filter 0.15s ease;
  }

  .place-preview__closed-indicator {
    position: absolute;
    top: -0.375rem;
    right: -0.375rem;
    z-index: 1;
    display: none;
    box-sizing: border-box;
    width: 0.75rem;
    height: 0.75rem;
    border: 0.09375rem solid currentColor;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 0.0625rem var(--color-surface-raised);
    color: var(--color-text);
    pointer-events: none;
  }

  .place-preview__closed-indicator::before,
  .place-preview__closed-indicator::after {
    position: absolute;
    left: 50%;
    border-radius: 999px;
    background: currentColor;
    content: '';
    transform-origin: left center;
  }

  .place-preview__closed-indicator::before {
    top: 0.125rem;
    width: 0.09375rem;
    height: 0.25rem;
    transform: translateX(-50%);
  }

  .place-preview__closed-indicator::after {
    top: calc(50% - 0.046875rem);
    width: 0.21875rem;
    height: 0.09375rem;
    transform: rotate(30deg);
  }

  .place-preview__marker[data-open='false'] .place-preview__closed-indicator {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .place-preview__marker img,
    .place-preview__marker .ui-map-marker {
      transition: none;
    }
  }

  @media (min-width: 60rem) {
    .place-preview {
      height: 20rem;
    }
  }
</style>

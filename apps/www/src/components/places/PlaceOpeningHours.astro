---
import { formatDynamicHtml } from '@shelkovo/markdown';

import { formatPlaceOpeningHours } from '@/lib/places/opening-hours';
import type { PlaceOpeningHours } from '@/lib/places/types';

interface Props {
  readonly openingHours?: PlaceOpeningHours;
}

const { openingHours } = Astro.props;
const rows = openingHours ? formatPlaceOpeningHours(openingHours) : [];
const descriptionHtml = openingHours?.description
  ? formatDynamicHtml(openingHours.description)
  : undefined;
---

{
  openingHours && (
    <div class="place-opening-hours-row">
      <dt class="place-opening-hours-label">
        Время работы
        <place-opening-hours data-opening-hours={JSON.stringify(openingHours)}>
          <span
            data-place-opening-status
            class="place-opening-hours-status"
            aria-hidden="true"
            hidden
          />
          <span class="ui-visually-hidden" aria-live="polite" />
        </place-opening-hours>
      </dt>
      <dd class="place-opening-hours-value">
        <ul class="place-opening-hours-week">
          {rows.map((row) => (
            <li class="place-opening-hours-day" data-closed={row.closed}>
              <span>{row.days}</span>
              <span class="ui-num">
                {row.hours.split(', ').map((interval, index) => (
                  <>
                    {index > 0 && ', '}
                    <span class="place-opening-hours-interval">{interval}</span>
                  </>
                ))}
              </span>
            </li>
          ))}
        </ul>
        {descriptionHtml && (
          <p
            class="place-opening-hours-description"
            set:html={descriptionHtml}
          />
        )}
      </dd>
    </div>
  )
}

<script>
  import { getPlaceClosingTime } from '@/lib/places/opening-hours';
  import type { PlaceOpeningHours } from '@/lib/places/types';

  class PlaceOpeningHoursElement extends HTMLElement {
    updateTimer?: number;

    connectedCallback(): void {
      const value = this.dataset.openingHours;
      const status = this.querySelector<HTMLElement>(
        '[data-place-opening-status]',
      );

      const announcement = this.querySelector<HTMLElement>('[aria-live]');
      if (!value || !status || !announcement) return;

      const openingHours = JSON.parse(value) as PlaceOpeningHours;
      const update = (): void => {
        const closingTime = getPlaceClosingTime(openingHours);
        const label = closingTime
          ? `Открыто до ${closingTime}`
          : 'Сейчас закрыто';

        status.dataset.open = String(Boolean(closingTime));
        status.title = label;
        if (announcement.textContent !== label)
          announcement.textContent = label;
        status.hidden = false;
      };

      update();
      this.updateTimer = window.setInterval(update, 60_000);
    }

    disconnectedCallback(): void {
      if (this.updateTimer === undefined) return;

      window.clearInterval(this.updateTimer);
      this.updateTimer = undefined;
    }
  }

  if (!customElements.get('place-opening-hours')) {
    customElements.define('place-opening-hours', PlaceOpeningHoursElement);
  }
</script>

<style>
  .place-opening-hours-row {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .place-opening-hours-label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    white-space: nowrap;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.75rem;
  }

  .place-opening-hours-value {
    display: grid;
    min-width: 0;
    padding-inline-start: 12px;
    justify-items: start;
    gap: 0.5rem;
    color: var(--color-text);
  }

  .place-opening-hours-week {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    max-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .place-opening-hours-day {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  .place-opening-hours-interval {
    white-space: nowrap;
  }

  .place-opening-hours-day[data-closed='true'] {
    color: var(--color-text-muted);
  }

  .place-opening-hours-description {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .place-opening-hours-status {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-danger);
  }

  .place-opening-hours-status[hidden] {
    display: none;
  }

  .place-opening-hours-status[data-open='true'] {
    background: var(--color-success);
  }

  @media (min-width: 40rem) {
    .place-opening-hours-value {
      padding-inline-start: 0;
    }

    .place-opening-hours-row {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>

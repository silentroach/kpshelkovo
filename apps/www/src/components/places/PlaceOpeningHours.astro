---
import { formatDynamicHtml } from '@shelkovo/markdown';

import type { PlaceOpeningHours } from '@/lib/places/types';

interface Props {
  readonly openingHours: PlaceOpeningHours;
}

const { openingHours } = Astro.props;
const descriptionHtml = formatDynamicHtml(openingHours.description);
---

<div class="place-opening-hours-row">
  <dt class="place-opening-hours-label">Время работы</dt>
  <dd class="place-opening-hours-value">
    <span
      class="ui-num place-opening-hours-description"
      set:html={descriptionHtml}
    />
    <place-opening-hours data-opening-hours={JSON.stringify(openingHours)}>
      <span
        data-place-opening-status
        data-open="false"
        class="place-opening-hours-status"
        aria-live="polite"
        hidden></span>
    </place-opening-hours>
  </dd>
</div>

<script>
  import { isPlaceOpen } from '@/lib/places/opening-hours';
  import type { PlaceOpeningHours } from '@/lib/places/types';

  class PlaceOpeningHoursElement extends HTMLElement {
    updateTimer?: number;

    connectedCallback(): void {
      const value = this.dataset.openingHours;
      const status = this.querySelector<HTMLElement>(
        '[data-place-opening-status]',
      );

      if (!value || !status) return;

      const openingHours = JSON.parse(value) as PlaceOpeningHours;
      const update = (): void => {
        const open = isPlaceOpen(openingHours);

        status.dataset.open = String(open);
        status.textContent = open ? 'Открыто сейчас' : 'Сейчас закрыто';
        status.hidden = false;
      };

      update();
      this.updateTimer = window.setInterval(update, 60_000);
    }

    disconnectedCallback(): void {
      if (this.updateTimer === undefined) return;

      window.clearInterval(this.updateTimer);
      this.updateTimer = undefined;
    }
  }

  if (!customElements.get('place-opening-hours')) {
    customElements.define('place-opening-hours', PlaceOpeningHoursElement);
  }
</script>

<style>
  .place-opening-hours-row {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .place-opening-hours-label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.75rem;
  }

  .place-opening-hours-value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.5rem;
  }

  .place-opening-hours-description {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .place-opening-hours-status {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25rem;
    white-space: nowrap;
  }

  .place-opening-hours-status[data-open='true'] {
    border-color: var(--color-success-border);
    background: var(--color-success-soft);
    color: var(--color-success-text);
  }

  @media (min-width: 40rem) {
    .place-opening-hours-row {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>

---
import { formatDynamicHtml } from '@shelkovo/markdown';
import LinkWithIcon from '@shelkovo/ui/LinkWithIcon.astro';
import { CalendarPlusIcon, MapPinIcon } from '@shelkovo/ui/icons';
import ResourceLink from '@shelkovo/ui/ResourceLink.astro';
import { isDomylandUrl, isTelegramUrl } from '@shelkovo/url';
import type { EventRecord } from '@/lib/events/types';
import {
  EVENT_CATEGORY_LABELS,
  EVENT_STATUS_LABELS,
  formatEventRange,
} from '@/lib/events/view';
import { renderMarkdown } from '@/lib/markdown/render';
import {
  buildNewsEventMapEmbedUrl,
  buildNewsEventMapUrl,
} from '@/lib/news/view';

interface Props {
  readonly event: EventRecord;
}
const { event } = Astro.props;
const titleId = `event-title-${event.id}`;
const mapUrl = buildNewsEventMapUrl(event);
const mapEmbedUrl = buildNewsEventMapEmbedUrl(event);
const bodyHtml = renderMarkdown(event.body);
const sourceUrl = new URL(event.sourceUrl);
const telegramChannel = isTelegramUrl(event.sourceUrl)
  ? sourceUrl.pathname.match(/^\/(?:s\/)?([a-zA-Z][\w]{4,})(?:\/|$)/)?.[1]
  : undefined;
const sourceLabel = telegramChannel
  ? telegramChannel.toLowerCase() === 'green_events'
    ? 'GREEN.EVENTS'
    : `@${telegramChannel}`
  : isTelegramUrl(event.sourceUrl)
    ? 'Telegram'
    : isDomylandUrl(event.sourceUrl)
      ? 'Домиленд'
      : sourceUrl.hostname === 'kpshelkovo.online'
        ? 'Шелково Онлайн'
        : sourceUrl.hostname.replace(/^www\./, '');
---

<article
  id={event.id}
  class="event-card"
  aria-labelledby={titleId}
  data-pagefind-body
>
  <header>
    <div class="event-labels">
      <span>{EVENT_CATEGORY_LABELS[event.category]}</span>
      {' '}
      {
        event.status !== 'cancelled' && (
          <strong class="event-status" data-status={event.status}>
            {EVENT_STATUS_LABELS[event.status]}
          </strong>
        )
      }
    </div>
    <h2 id={titleId} class="ui-entry-title">
      {
        event.status === 'cancelled' && (
          <>
            <span class="event-status" data-status="cancelled">
              Отменено:
            </span>{' '}
          </>
        )
      }
      {formatDynamicHtml(event.title)}
    </h2>
    <div class="event-meta">
      <time datetime={event.startsIso} class="event-date ui-num"
        >{formatDynamicHtml(formatEventRange(event))}</time
      >
      {' '}
      <LinkWithIcon
        href={event.sourceUrl}
        label={sourceLabel}
        ariaLabel={`Источник: ${sourceLabel}`}
        class="event-source"
      />
    </div>
  </header>

  <dl class="event-facts">
    <div>
      <dt>Место</dt>{' '}<dd>
        {formatDynamicHtml(event.location ?? 'Место не указано')}
      </dd>
    </div>
    {
      event.price && (
        <div>
          <>
            <dt>Стоимость</dt> <dd>{formatDynamicHtml(event.price)}</dd>
          </>
        </div>
      )
    }
    {
      event.audience && (
        <div>
          <>
            <dt>Для кого</dt> <dd>{formatDynamicHtml(event.audience)}</dd>
          </>
        </div>
      )
    }
    {
      event.organizer && (
        <div>
          <>
            <dt>Организатор</dt>{' '}
            <dd>{formatDynamicHtml(event.organizer.name)}</dd>
          </>
        </div>
      )
    }
    {
      event.performer && event.performer.length > 0 && (
        <div>
          <>
            <dt>Участники программы</dt>{' '}
            <dd>
              {formatDynamicHtml(
                event.performer.map((person) => person.name).join(', '),
              )}
            </dd>
          </>
        </div>
      )
    }
  </dl>

  <div class="ui-prose event-body" set:html={bodyHtml} />

  {
    (mapUrl || (event.icsUrl && event.status !== 'cancelled')) && (
      <div class="event-actions" data-pagefind-ignore>
        {event.icsUrl && event.status !== 'cancelled' && (
          <ResourceLink
            href={event.icsUrl}
            download={`${event.id}.ics`}
            class="ui-link event-action"
          >
            <CalendarPlusIcon class="event-action-icon" />
            <span>Добавить в календарь</span>
          </ResourceLink>
        )}
        {mapUrl && (
          <a
            href={mapUrl}
            target="_blank"
            rel="noreferrer noopener"
            class="ui-link event-action"
          >
            <MapPinIcon class="event-action-icon" />
            <span>Открыть на Яндекс Картах</span>
          </a>
        )}
      </div>
    )
  }
  {
    mapEmbedUrl && (
      <div class="event-map" aria-hidden="true">
        <iframe
          src={mapEmbedUrl}
          title={`Карта места события: ${event.location ?? event.title}`}
          loading="lazy"
          tabindex="-1"
        />
        <span class="ui-map-marker" />
      </div>
    )
  }
</article>

<style>
  .event-card {
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
    overflow-wrap: anywhere;
  }
  .event-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .event-status[data-status='conditional'] {
    color: var(--color-warning-text);
  }
  .event-status[data-status='cancelled'] {
    color: var(--color-danger-text);
  }
  .event-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1rem;
    margin-top: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
  .event-date {
    color: var(--color-text);
    font-weight: 600;
  }
  .event-facts {
    display: grid;
    gap: 0.5rem;
    margin-block: 1rem;
  }
  .event-facts > div {
    display: grid;
    gap: 0.15rem;
  }
  dt {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  dd {
    margin: 0;
  }
  .event-body {
    max-width: 72ch;
  }
  .event-meta :global(.event-source) {
    color: var(--color-text-muted);
  }
  .event-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .event-actions :global(.event-action) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding-block: 0.375rem;
    font-weight: 600;
    white-space: normal;
  }
  .event-actions :global(.event-action-icon) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  .event-meta :global(a:hover),
  .event-actions :global(a:hover) {
    color: var(--color-primary-hover);
  }
  .event-meta :global(a:focus-visible),
  .event-actions :global(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .event-map {
    position: relative;
    height: 14rem;
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
  .event-map .ui-map-marker {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  @media (min-width: 40rem) {
    .event-facts > div {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>

---
import { formatDynamicHtml } from '@shelkovo/markdown';
import LinkWithIcon from '@shelkovo/ui/LinkWithIcon.astro';
import { CalendarPlusIcon, MapPinIcon } from '@shelkovo/ui/icons';
import ResourceLink from '@shelkovo/ui/ResourceLink.astro';
import { isDomylandUrl, isTelegramUrl } from '@shelkovo/url';
import MapCardShell from '@/components/MapCardShell.astro';
import type { EventRecord } from '@/lib/events/types';
import {
  EVENT_CATEGORY_LABELS,
  EVENT_STATUS_LABELS,
  formatEventRange,
} from '@/lib/events/view';
import { renderMarkdown } from '@/lib/markdown/render';
import {
  buildNewsEventMapEmbedUrl,
  buildNewsEventMapUrl,
} from '@/lib/news/view';

interface Props {
  readonly event: EventRecord;
}
const { event } = Astro.props;
const mapUrl = buildNewsEventMapUrl(event);
const sourceUrl = new URL(event.sourceUrl);
const telegramChannel = isTelegramUrl(event.sourceUrl)
  ? sourceUrl.pathname.match(/^\/(?:s\/)?([a-zA-Z][\w]{4,})(?:\/|$)/)?.[1]
  : undefined;
const sourceLabel = telegramChannel
  ? telegramChannel.toLowerCase() === 'green_events'
    ? 'GREEN.EVENTS'
    : `@${telegramChannel}`
  : isTelegramUrl(event.sourceUrl)
    ? 'Telegram'
    : isDomylandUrl(event.sourceUrl)
      ? 'Домиленд'
      : sourceUrl.hostname === 'kpshelkovo.online'
        ? 'Шелково Онлайн'
        : sourceUrl.hostname.replace(/^www\./, '');
---

<article
  id={event.id}
  class:list={['event-detail', { 'event-detail--located': !!mapUrl }]}
  aria-labelledby="event-title"
  data-pagefind-body
>
  <header class="event-header">
    <div class="event-labels">
      <span>{EVENT_CATEGORY_LABELS[event.category]}</span>{' '}
      {
        event.status !== 'cancelled' && (
          <strong class="event-status" data-status={event.status}>
            {EVENT_STATUS_LABELS[event.status]}
          </strong>
        )
      }
    </div>
    <h1
      id="event-title"
      class="ui-page-title"
      data-status={event.status === 'cancelled' ? event.status : undefined}
      set:html={formatDynamicHtml(
        event.status === 'cancelled' ? `Отменено: ${event.title}` : event.title,
      )}
    />
    <div class="event-date-actions">
      <time datetime={event.startsIso} class="event-date ui-num"
        >{formatDynamicHtml(formatEventRange(event))}</time
      >
      {
        event.icsUrl && event.status !== 'cancelled' && (
          <ResourceLink
            href={event.icsUrl}
            download={`${event.id}.ics`}
            class="event-calendar"
            data-pagefind-ignore
          >
            <>
              <CalendarPlusIcon class="event-icon" />
              <span>Добавить в календарь</span>
            </>
          </ResourceLink>
        )
      }
    </div>
    <div class="event-source">
      <span>Источник:</span>{' '}<LinkWithIcon
        href={event.sourceUrl}
        label={sourceLabel}
        ariaLabel={`Источник: ${sourceLabel}`}
      />
    </div>
    {!mapUrl && <p class="event-unknown">Место уточняется</p>}
  </header>

  {
    mapUrl && (
      <aside class="event-location" aria-label="Место мероприятия">
        <MapCardShell embedUrl={buildNewsEventMapEmbedUrl(event)}>
          <div
            class:list={[
              'location-content',
              { 'location-content--mapped': !!event.coordinates },
            ]}
          >
            <p class="location-label">Место</p>
            <h2
              class="ui-entry-title"
              set:html={formatDynamicHtml(event.location ?? 'Место на карте')}
            />
            <a
              href={mapUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="location-action"
              data-pagefind-ignore
            >
              <>
                <MapPinIcon class="event-icon" />
                <span>Открыть на Яндекс Картах</span>
              </>
            </a>
          </div>
        </MapCardShell>
      </aside>
    )
  }

  <div class="event-main">
    {
      (event.price ||
        event.audience ||
        event.organizer ||
        !!event.performer?.length) && (
        <dl class="event-facts">
          {event.price && (
            <div>
              <dt>Стоимость</dt>{' '}
              <dd set:html={formatDynamicHtml(event.price)} />
            </div>
          )}
          {event.audience && (
            <div>
              <dt>Для кого</dt>{' '}
              <dd set:html={formatDynamicHtml(event.audience)} />
            </div>
          )}
          {event.organizer && (
            <div>
              <dt>Организатор</dt>{' '}
              <dd set:html={formatDynamicHtml(event.organizer.name)} />
            </div>
          )}
          {event.performer && event.performer.length > 0 && (
            <div>
              <dt>Участники программы</dt>{' '}
              <dd
                set:html={formatDynamicHtml(
                  event.performer.map((person) => person.name).join(', '),
                )}
              />
            </div>
          )}
        </dl>
      )
    }
    <div class="ui-prose event-body" set:html={renderMarkdown(event.body)} />
  </div>
</article>

<style>
  .event-detail {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    scroll-margin-top: 6rem;
    overflow-wrap: anywhere;
  }
  .event-header,
  .event-main {
    min-width: 0;
  }
  .event-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .event-status[data-status='conditional'] {
    color: var(--color-warning-text);
  }
  .event-status[data-status='cancelled'] {
    color: var(--color-danger-text);
  }
  .event-date-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
  }
  .event-date {
    font-weight: 600;
  }
  .event-date-actions :global(.event-calendar) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: normal;
  }
  .event-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .event-unknown {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }
  .event-location {
    --map-opacity: 0.8;
    --map-clear-height: 3rem;
    --map-solid-height: 6rem;
    --map-side-wash: transparent;
    min-width: 0;
    align-self: start;
  }
  .location-content {
    display: grid;
    gap: 0.65rem;
  }
  .location-content--mapped {
    padding: 5rem 0 0;
  }
  .location-label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .location-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .event-detail :global(.event-icon) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  .event-detail :global(a:focus-visible) {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 3px;
  }
  .event-facts {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
  }
  .event-facts > div {
    display: grid;
    gap: 0.15rem;
  }
  dt {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  dd {
    margin: 0;
  }
  .event-body {
    max-width: 72ch;
  }
  @media (min-width: 40rem) {
    .event-facts > div {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
  @media (min-width: 64rem) {
    .event-detail--located {
      grid-template-columns: minmax(0, 1fr) 19rem;
      column-gap: 2rem;
    }
    .event-header {
      grid-column: 1;
      grid-row: 1;
    }
    .event-main {
      grid-column: 1;
      grid-row: 2;
    }
    .event-location {
      --map-clear-height: 5rem;
      --map-solid-height: 8rem;
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .location-content--mapped {
      min-height: 14rem;
      align-content: end;
      padding-top: 7rem;
    }
  }
</style>

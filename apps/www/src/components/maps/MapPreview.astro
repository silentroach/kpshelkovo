---
import type { MapPreviewProps as Props } from './map-preview.types';

const { preview, label, class: className, ...rest } = Astro.props;
---

<map-preview
  {...rest}
  class:list={[
    'map-preview',
    className,
    { 'map-preview--muted': preview.muted },
  ]}
  data-preview={JSON.stringify(preview)}
  role="group"
  aria-label={label}
>
  <div class="map-preview__canvas" data-canvas></div>
  <p class="map-preview__error" data-message role="alert" hidden>
    Карта не загрузилась.
  </p>
  <template><slot /></template>
</map-preview>

<script>
  import { MapPreviewElement } from './map-preview';

  if (!customElements.get('map-preview')) {
    customElements.define('map-preview', MapPreviewElement);
  }
</script>

<style>
  .map-preview {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-surface-muted);
  }

  .map-preview__canvas {
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .map-preview__canvas :global(.ymaps3--map) {
    /* The SDK sets touch-action: none inline even with behaviors disabled. */
    touch-action: pan-y !important;
  }

  .map-preview--muted .map-preview__canvas :global(.ymaps3--map) {
    /* Composite the opaque marker over the map before fading their shared scene.
       Native controls and attribution are siblings outside this scene. */
    opacity: 0.4;
  }

  .map-preview__canvas :global(:is(a, button):focus-visible) {
    outline: 0.1875rem solid var(--color-focus);
    outline-offset: 0.125rem;
  }

  .map-preview__canvas :global(button[data-preview-auto-action]) {
    display: none !important;
  }

  .map-preview__canvas
    :global(
      button:disabled:is(
          .ymaps3--open-maps-button,
          :has(.ymaps3--open-maps-button)
        )
    ) {
    display: none !important;
  }

  .map-preview__error[hidden] {
    display: none;
  }

  .map-preview__error {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    font-size: 0.875rem;
    box-shadow: var(--shadow-1);
  }
</style>

---
import { formatTextHtml } from '@shelkovo/typography';
import ContactMethods from '@/components/contacts/ContactMethods.astro';
import type { InventoryOffer } from '@/lib/inventory/types';
import { formatInventoryPrice } from '@/lib/inventory/view';
import InventoryPreview from './InventoryPreview.astro';
interface Props {
  readonly offer: InventoryOffer;
}
const { offer } = Astro.props;
const photo = offer.photos[0];
---

<article
  id={offer.anchorId}
  class:list={['inventory-offer', { 'inventory-offer--photo': !!photo }]}
  aria-labelledby={`${offer.anchorId}-title`}
>
  {photo && <InventoryPreview photo={photo} href={offer.url} />}
  <header class="inventory-offer__heading">
    <h2 id={`${offer.anchorId}-title`} class="ui-card-title">
      <a
        href={offer.url}
        class="ui-title-link"
        set:html={formatTextHtml(offer.title)}
      />
    </h2>
    <p
      class="inventory-offer__price ui-num"
      set:html={formatTextHtml(formatInventoryPrice(offer.price))}
    />
  </header>
  <p
    class="inventory-offer__summary"
    set:html={formatTextHtml(offer.summary)}
  />
  <p class="inventory-offer__owner">
    <span set:html={formatTextHtml(offer.owner.name)} />
    {' · '}
    <a class="site-text-link" href={offer.owner.parcel.url}>
      {offer.owner.parcel.code}
    </a>
  </p>
  <div class="inventory-offer__actions">
    <ContactMethods
      contacts={offer.owner.contacts}
      headingId={`${offer.anchorId}-contacts`}
      headingLevel="h3"
      compact
    />
    <a
      class="site-text-link inventory-offer__details"
      href={offer.url}
      aria-label={`Подробнее: ${offer.title}`}
    >
      Подробнее
    </a>
  </div>
</article>

<style>
  .inventory-offer {
    display: grid;
    grid-template-areas: 'heading' 'summary' 'owner' 'actions';
    gap: 0.625rem 1rem;
    max-width: 52rem;
    padding-block: 1.25rem;
    border-block-start: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--site-sticky-offset) + 1rem);
  }
  .inventory-offer--photo {
    grid-template-columns: 6rem minmax(0, 1fr);
    grid-template-areas: 'photo heading' 'summary summary' 'owner owner' 'actions actions';
  }
  .inventory-offer__heading {
    grid-area: heading;
    min-width: 0;
  }
  .inventory-offer__price {
    margin-top: 0.375rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .inventory-offer__summary {
    grid-area: summary;
  }
  .inventory-offer__owner {
    grid-area: owner;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .inventory-offer__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
  }
  .inventory-offer__details {
    padding-block: 0.25rem;
  }
  @media (min-width: 48rem) {
    .inventory-offer--photo {
      grid-template-columns: 10rem minmax(0, 1fr);
      grid-template-areas: 'photo heading' 'photo summary' 'photo owner' 'photo actions';
    }
  }
</style>

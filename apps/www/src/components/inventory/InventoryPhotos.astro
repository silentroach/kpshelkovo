---
import { Image } from 'astro:assets';
import { formatText } from '@shelkovo/typography';
import type { InventoryPhoto } from '@/lib/inventory/types';
interface Props {
  readonly photos: readonly InventoryPhoto[];
}
const { photos } = Astro.props;
const gallery = photos.map((photo) => {
  const width = Math.min(photo.width, 1600);
  return {
    photo,
    width,
    height: Math.round((photo.height * width) / photo.width),
    widths: [
      ...new Set(
        [480, 768, 960, 1280, width].filter((candidate) => candidate <= width),
      ),
    ],
  };
});
---

{gallery.length > 0 && (
  <div class="inventory-photos" data-pagefind-ignore="all">
    {gallery.map(({ photo, width, height, widths }) => (
      <figure>
        <a
          href={photo.url}
          aria-label={formatText(`Открыть фото: ${photo.alt}`)}
        >
          <Image
            src={photo.url}
            width={width}
            height={height}
            widths={widths}
            sizes="(min-width: 1180px) 558px, (min-width: 768px) calc((100vw - 4rem) / 2), calc(100vw - 2.5rem)"
            format="webp"
            quality={82}
            alt={formatText(photo.alt)}
            loading="lazy"
            decoding="async"
          />
        </a>
        {photo.caption && (
          <figcaption class="ui-media-caption">
            {formatText(photo.caption)}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
)}

<style>
  .inventory-photos {
    display: grid;
    gap: 1.5rem 1rem;
  }
  figure {
    min-width: 0;
    margin: 0;
  }
  a {
    display: block;
    width: fit-content;
    max-width: 100%;
  }
  a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }
  img {
    display: block;
    max-width: 100%;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }
  figcaption {
    margin-block-start: 0.5rem;
  }
  @media (min-width: 48rem) {
    .inventory-photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

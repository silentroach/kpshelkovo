---
import { formatTextHtml } from '@shelkovo/typography';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import { withHomeBreadcrumbs } from '@/lib/breadcrumbs';

interface Props {
  readonly title: string;
  readonly breadcrumbLabel?: string;
  readonly parents?: readonly {
    readonly label: string;
    readonly href: string;
  }[];
  readonly searchable?: boolean;
}
const {
  title,
  breadcrumbLabel = title,
  parents = [],
  searchable = false,
} = Astro.props;
const breadcrumbs = withHomeBreadcrumbs([
  ...parents,
  { label: breadcrumbLabel },
]);
---

<main class="ui-page inventory-page">
  <header class="ui-page-header">
    <div class="ui-page-header-stack">
      <Breadcrumbs items={breadcrumbs} />
      <div>
        <h1
          class="ui-page-title"
          data-pagefind-body={searchable || undefined}
          set:html={formatTextHtml(title)}
        />
        <div class="inventory-page__intro">
          <slot name="intro" />
        </div>
      </div>
    </div>
  </header>
  <div class="inventory-page__content">
    <slot />
  </div>
</main>

<style>
  .inventory-page {
    padding-block-end: 3rem;
    overflow-wrap: anywhere;
  }
  .inventory-page .ui-page-header {
    padding-block-end: 1.5rem;
  }
  .inventory-page .ui-page-title {
    max-width: 48rem;
    font-size: clamp(2rem, calc(0.857142857rem + 5.714285714vw), 2.25rem);
    overflow-wrap: anywhere;
  }
  .inventory-page__intro:not(:empty) {
    max-width: 48rem;
    margin-block-start: 0.75rem;
  }
  .inventory-page__content {
    padding-inline: 1.25rem;
  }
  .inventory-page__content > :global(:not(:last-child)) {
    margin-block-end: 2rem;
  }
  @media (min-width: 48rem) {
    .inventory-page .ui-page-title {
      font-size: 3rem;
    }
    .inventory-page__content {
      padding-inline: 1.5rem;
    }
  }
</style>

---
import { formatTextHtml } from '@shelkovo/typography';
import type { InventoryKind } from '@/lib/inventory/types';
interface Props {
  readonly kinds: readonly InventoryKind[];
}
const { kinds } = Astro.props;
---

<ul class="inventory-kinds">
  {kinds.map((kind) => (
    <li>
      <a
        class="site-text-link"
        href={kind.url}
        set:html={formatTextHtml(kind.title)}
      />
    </li>
  ))}
</ul>

<style>
  .inventory-kinds {
    max-width: 48rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }
  .inventory-kinds li {
    padding-block: 0.75rem;
  }
  .inventory-kinds li + li {
    border-block-start: 1px solid var(--color-border);
  }
</style>

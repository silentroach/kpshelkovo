---
import { count } from '@shelkovo/format';
import { formatText, formatTextHtml } from '@shelkovo/typography';
import type { InventoryKind } from '@/lib/inventory/types';
interface Props {
  readonly kinds: readonly InventoryKind[];
}
const { kinds } = Astro.props;
---

<ul class="inventory-kinds">
  {kinds.map((kind) => (
    <li>
      <a
        class="site-text-link"
        href={kind.url}
        set:html={formatTextHtml(kind.title)}
      />
      <span class="inventory-kinds__count">
        {formatText(
          count(kind.offers.length, [
            'предложение',
            'предложения',
            'предложений',
          ]),
        )}
      </span>
    </li>
  ))}
</ul>

<style>
  .inventory-kinds {
    max-width: 48rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }
  .inventory-kinds li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-block: 0.75rem;
    border-block-end: 1px solid var(--color-border);
  }
  .inventory-kinds__count {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>

---
import type { GetStaticPaths } from 'astro';

import { formatTextHtml } from '@shelkovo/typography';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import { PhoneIcon, TelegramIcon } from '@shelkovo/ui/icons';
import PersonRelatedLinks from '@/components/people/PersonRelatedLinks.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import {
  loadPeopleProfiles,
  loadPersonProfileWithBacklinks,
} from '@/lib/people/load';
import { personProfilePageSchema } from '@/lib/people/seo';
import { selectPersonRelatedMaterials } from '@/lib/people/related';
import {
  describePersonProfile,
  formatPersonContactCompactDisplay,
  formatPersonContactType,
  PEOPLE_PROSE,
} from '@/lib/people/view';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const profiles = await loadPeopleProfiles();

  return profiles.map((profile) => ({
    params: {
      slug: profile.slug,
    },
  }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;

if (!slug) {
  throw new Error('person slug is required');
}

const profile = await loadPersonProfileWithBacklinks(slug);

if (!profile) {
  throw new Error(`person profile "${slug}" not found`);
}

const bodyHtml = profile.body ? renderMarkdown(profile.body) : undefined;
const description = profile.seo?.description ?? describePersonProfile(profile);
const positionHtml = profile.position
  ? formatTextHtml(profile.position)
  : undefined;
const companyHtml = profile.company
  ? formatTextHtml(profile.company)
  : undefined;
const title = `${profile.name} — Люди — Шелково Онлайн`;
const search = {
  scope: 'manual',
  title: profile.name,
  description,
  section: SEARCH_SECTIONS.people,
} satisfies SearchDocument;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Люди' },
  { label: profile.name },
]);
const related = selectPersonRelatedMaterials(profile.backlinks);
const schema = personProfilePageSchema({
  name: profile.name,
  description,
  company: profile.company,
  position: profile.position,
  image: profile.photo?.src,
  url: profile.url,
  contacts: profile.contacts,
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: profile.name, url: profile.url },
  ]),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={profile.url}
  type="profile"
  keywords={['люди Шелково', profile.name]}
  schema={schema}
  search={search}
>
  <main class="ui-page person-profile">
    <div class="ui-page-header">
      <div class="person-profile__header-inner">
        <div class="ui-breadcrumbs person-profile__breadcrumbs">
          <Breadcrumbs items={breadcrumbs} />
        </div>
        <header class="person-profile__heading">
          <h1 class="ui-page-title" data-pagefind-ignore="all">
            {profile.name}
          </h1>

          {(positionHtml || companyHtml) && (
            <div class="person-profile__role" data-pagefind-body>
              {positionHtml && (
                <p class="person-profile__position" set:html={positionHtml} />
              )}
              {companyHtml && (
                <p class="person-profile__company" set:html={companyHtml} />
              )}
            </div>
          )}
        </header>

        {profile.contacts.length > 0 && (
          <section
            aria-labelledby="person-contacts"
            class="person-profile__contacts"
            data-pagefind-ignore="all"
          >
            <h2 id="person-contacts" class="ui-section-label">
              Контакты
            </h2>

            <ul class="person-profile__contact-list">
              {profile.contacts.map((contact) => (
                <li class="person-profile__contact">
                  {contact.type === 'telegram' ? (
                    <TelegramIcon class="person-profile__contact-icon person-profile__contact-icon--telegram" />
                  ) : contact.type === 'phone' ? (
                    <PhoneIcon class="person-profile__contact-icon person-profile__contact-icon--phone" />
                  ) : (
                    <span class="person-profile__contact-type">
                      {formatPersonContactType(contact.type)}
                    </span>
                  )}

                  <a href={contact.href} class="person-profile__contact-link">
                    {formatPersonContactCompactDisplay(contact)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {profile.photo && (
          <figure class="person-profile__photo">
            <img
              src={profile.photo.src}
              width={profile.photo.width}
              height={profile.photo.height}
              alt={profile.name}
            />
            {profile.photo.source && (
              <figcaption>
                Фото:{' '}
                <a class="site-text-link" href={profile.photo.source.url}>
                  {profile.photo.source.label}
                </a>
              </figcaption>
            )}
          </figure>
        )}

        {profile.body && (
          <article class="person-profile__article">
            <div
              class={`person-profile__body ${PEOPLE_PROSE}`}
              data-pagefind-body
              set:html={bodyHtml}
            />
          </article>
        )}
      </div>
    </div>

    <PersonRelatedLinks items={related} />
  </main>
</BaseLayout>

<style>
  .person-profile {
    padding-block-end: 2rem;
  }

  .person-profile__header-inner,
  .person-profile__body {
    max-width: 56rem;
  }

  .person-profile__header-inner:has(.person-profile__photo) {
    max-width: none;
  }

  .person-profile__header-inner {
    display: grid;
    gap: 1rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .person-profile__breadcrumbs {
    margin-block-end: 0.25rem;
  }

  .person-profile__photo {
    width: min(14rem, 100%);
    margin: 0;
    align-self: start;
  }

  .person-profile__photo img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .person-profile__photo figcaption {
    margin-block-start: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .person-profile__role {
    display: grid;
    gap: 0.125rem;
    max-width: 48rem;
    margin-block-start: 0.75rem;
  }

  .person-profile__position {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .person-profile__company {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .person-profile__contacts > :not(:last-child) {
    margin-block-end: 0.75rem;
  }

  .person-profile__contact-list {
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .person-profile__contact-list > :not(:last-child) {
    margin-block-end: 0.625rem;
  }

  .person-profile__contact {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 0.625rem;
  }

  .person-profile__contact :global(.person-profile__contact-icon) {
    width: 1rem;
    height: 1rem;
    align-self: center;
  }

  .person-profile__contact :global(.person-profile__contact-icon--telegram) {
    color: var(--color-telegram);
  }

  .person-profile__contact :global(.person-profile__contact-icon--phone) {
    color: var(--color-primary);
  }

  .person-profile__contact-type {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .person-profile__contact-link {
    justify-self: start;
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 400;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .person-profile__contact-link:is(:hover, :focus-visible) {
    color: var(--color-primary-hover);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .person-profile__contact-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .person-profile__article {
    align-self: start;
  }

  @media (min-width: 48rem) {
    .person-profile__header-inner:has(.person-profile__photo) {
      grid-template-columns: minmax(0, 1fr) 14rem;
      grid-template-rows: auto auto auto 1fr;
      column-gap: 2rem;
    }

    .person-profile__photo {
      grid-column: 2;
      grid-row: 1 / 5;
    }

    .person-profile__header-inner:has(.person-profile__photo):not(
        :has(.person-profile__contacts)
      ) {
      grid-template-rows: auto auto 1fr;
    }

    .person-profile__header-inner:not(:has(.person-profile__contacts))
      .person-profile__photo {
      grid-row: 1 / 4;
    }

    .person-profile__contacts {
      align-self: start;
    }

    .person-profile {
      padding-block-end: 3rem;
    }
  }

  @media (min-width: 64rem) {
    .person-profile {
      padding-block-end: 3.5rem;
    }
  }
</style>

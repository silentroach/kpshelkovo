---
import type { GetStaticPaths } from 'astro';

import { formatDynamicHtml } from '@shelkovo/markdown';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import { PhoneIcon, TelegramIcon } from '@shelkovo/ui/icons';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import {
  loadPeopleProfiles,
  loadPersonProfileWithBacklinks,
} from '@/lib/people/load';
import { personProfilePageSchema } from '@/lib/people/seo';
import {
  describePersonProfile,
  formatPersonBacklinkDate,
  formatPersonBacklinkKind,
  formatPersonBacklinkSection,
  formatPersonContactCompactDisplay,
  formatPersonContactType,
  formatPersonHeadline,
  personBacklinkGroups,
  PEOPLE_PROSE,
} from '@/lib/people/view';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const profiles = await loadPeopleProfiles();

  return profiles.map((profile) => ({
    params: {
      slug: profile.slug,
    },
  }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;

if (!slug) {
  throw new Error('person slug is required');
}

const profile = await loadPersonProfileWithBacklinks(slug);

if (!profile) {
  throw new Error(`person profile "${slug}" not found`);
}

const bodyHtml = profile.body ? renderMarkdown(profile.body) : undefined;
const description = profile.seo?.description ?? describePersonProfile(profile);
const headline = formatPersonHeadline(profile);
const headlineHtml = headline ? formatDynamicHtml(headline) : undefined;
const title = `${profile.name} — Люди — Шелково Онлайн`;
const search = {
  scope: 'manual',
  title: profile.name,
  description,
  section: SEARCH_SECTIONS.people,
} satisfies SearchDocument;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Люди' },
  { label: profile.name },
]);
// Future: reopen public backlinks on person pages once editorial rules are finalized.
const showBacklinks = false;
const backlinkGroups = personBacklinkGroups(profile.backlinks);
const schema = personProfilePageSchema({
  name: profile.name,
  description,
  company: profile.company,
  position: profile.position,
  url: profile.url,
  contacts: profile.contacts,
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: profile.name, url: profile.url },
  ]),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={profile.url}
  type="profile"
  keywords={['люди Шелково', profile.name]}
  schema={schema}
  search={search}
>
  <main class="ui-page person-profile">
    <header class="ui-page-header">
      <div class="ui-page-header-stack person-profile__header-inner">
        <Breadcrumbs items={breadcrumbs} />

        <div class="person-profile__intro">
          <div class="person-profile__heading">
            <h1 class="ui-page-title" data-pagefind-ignore="all">
              {profile.name}
            </h1>

            {
              headlineHtml && (
                <p
                  class="person-profile__headline"
                  data-pagefind-body
                  set:html={headlineHtml}
                />
              )
            }
          </div>

          <section
            aria-labelledby="person-contacts"
            class="person-profile__contacts"
            data-pagefind-ignore="all"
          >
            <h2 id="person-contacts" class="ui-section-label">Контакты</h2>

            {
              profile.contacts.length > 0 ? (
                <ul class="person-profile__contact-list">
                  {profile.contacts.map((contact) => (
                    <li class="person-profile__contact">
                      {contact.type === 'telegram' ? (
                        <TelegramIcon class="person-profile__contact-icon person-profile__contact-icon--telegram" />
                      ) : contact.type === 'phone' ? (
                        <PhoneIcon class="person-profile__contact-icon person-profile__contact-icon--phone" />
                      ) : (
                        <span class="person-profile__contact-type">
                          {formatPersonContactType(contact.type)}
                        </span>
                      )}

                      <a
                        href={contact.href}
                        class="person-profile__contact-link"
                      >
                        {formatPersonContactCompactDisplay(contact)}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="person-profile__empty person-profile__empty--contacts">
                  Контакты пока не опубликованы.
                </div>
              )
            }
          </section>
        </div>
      </div>
    </header>

    {
      profile.body && (
        <article class="person-profile__article">
          <div
            class={`person-profile__body ${PEOPLE_PROSE}`}
            data-pagefind-body
            set:html={bodyHtml}
          />
        </article>
      )
    }

    {
      showBacklinks && (
        <section class="person-profile__backlinks" data-pagefind-ignore="all">
          <div class="person-profile__backlinks-inner">
            <div class="person-profile__backlinks-heading">
              <h2 class="ui-section-label">Где упоминается</h2>
              <p class="person-profile__backlinks-description">
                Упоминания в новостях, статусе поселка, отзывах, карте мест,
                других публичных профилях и сарафане.
              </p>
            </div>

            {backlinkGroups.length > 0 ? (
              <div class="person-profile__backlink-groups">
                {backlinkGroups.map((group) => (
                  <section
                    aria-labelledby={`person-backlinks-${group.section}`}
                    class="person-profile__backlink-group"
                  >
                    <h3
                      id={`person-backlinks-${group.section}`}
                      class="person-profile__backlink-section"
                    >
                      {formatPersonBacklinkSection(group.section)}
                    </h3>

                    <ul class="person-profile__backlink-list">
                      {group.items.map((backlink) => (
                        <li>
                          <a
                            href={backlink.htmlUrl}
                            class="person-profile__backlink-card"
                          >
                            <div class="person-profile__backlink-meta">
                              <span class="person-profile__backlink-kind">
                                {formatPersonBacklinkKind(backlink.kind)}
                              </span>
                              {backlink.mentionedAt && (
                                <time datetime={backlink.mentionedAt}>
                                  {formatPersonBacklinkDate(backlink)}
                                </time>
                              )}
                            </div>

                            <h4 class="person-profile__backlink-title">
                              {backlink.title}
                            </h4>

                            {backlink.excerpt && (
                              <p class="person-profile__backlink-excerpt">
                                {backlink.excerpt}
                              </p>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            ) : (
              <div class="person-profile__empty person-profile__empty--backlinks">
                Публичных упоминаний пока не найдено.
              </div>
            )}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .person-profile {
    padding-block-end: 2rem;
  }

  .person-profile__header-inner,
  .person-profile__body,
  .person-profile__backlinks-inner {
    max-width: 56rem;
  }

  .person-profile__intro > :not(:last-child) {
    margin-block-end: 1rem;
  }

  .person-profile__heading > :not(:last-child) {
    margin-block-end: 0.625rem;
  }

  .person-profile__headline,
  .person-profile__backlinks-description,
  .person-profile__backlink-excerpt,
  .person-profile__empty {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .person-profile__headline {
    max-width: 48rem;
  }

  .person-profile__contacts > :not(:last-child) {
    margin-block-end: 0.75rem;
  }

  .person-profile__contact-list {
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .person-profile__contact-list > :not(:last-child) {
    margin-block-end: 0.625rem;
  }

  .person-profile__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.375rem;
  }

  .person-profile__contact :global(.person-profile__contact-icon) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .person-profile__contact :global(.person-profile__contact-icon--telegram) {
    color: var(--color-telegram);
  }

  .person-profile__contact :global(.person-profile__contact-icon--phone) {
    color: var(--color-primary);
  }

  .person-profile__contact-type {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .person-profile__contact-link {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .person-profile__contact-link:hover {
    color: var(--color-primary);
  }

  .person-profile__empty {
    border: 1px dashed color-mix(in oklab, var(--color-border) 80%, transparent);
    border-radius: var(--radius-2xl);
  }

  .person-profile__empty--contacts {
    padding: 0.75rem 1rem;
  }

  .person-profile__article {
    padding-inline: 1.25rem;
  }

  .person-profile__backlinks {
    padding: 2rem 1.25rem 0;
  }

  .person-profile__backlinks-inner > :not(:last-child) {
    margin-block-end: 1.25rem;
  }

  .person-profile__backlinks-heading > :not(:last-child) {
    margin-block-end: 0.375rem;
  }

  .person-profile__backlink-groups > :not(:last-child) {
    margin-block-end: 1.5rem;
  }

  .person-profile__backlink-group > :not(:last-child) {
    margin-block-end: 0.75rem;
  }

  .person-profile__backlink-section {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .person-profile__backlink-list {
    display: grid;
    gap: 0.75rem;
  }

  .person-profile__backlink-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in oklab, var(--color-border) 80%, transparent);
    border-radius: var(--radius-2xl);
    background: color-mix(in oklab, var(--color-surface) 70%, transparent);
    transition:
      background-color 150ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .person-profile__backlink-card:hover {
    border-color: color-mix(in oklab, var(--color-text) 20%, transparent);
    background: var(--color-surface);
  }

  .person-profile__backlink-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .person-profile__backlink-kind {
    display: inline-flex;
    padding: 0.25rem 0.625rem;
    border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(
      in oklab,
      var(--color-surface-muted) 40%,
      transparent
    );
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .person-profile__backlink-title {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .person-profile__backlink-card:hover .person-profile__backlink-title {
    color: var(--color-primary);
  }

  .person-profile__empty--backlinks {
    padding: 1rem;
  }

  @media (min-width: 48rem) {
    .person-profile {
      padding-block-end: 3rem;
    }

    .person-profile__headline {
      font-size: 1rem;
    }

    .person-profile__article {
      padding-inline: 1.5rem;
    }

    .person-profile__backlinks {
      padding-block-start: 2.5rem;
      padding-inline: 1.5rem;
    }

    .person-profile__empty--backlinks {
      padding-inline: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .person-profile {
      padding-block-end: 3.5rem;
    }
  }
</style>

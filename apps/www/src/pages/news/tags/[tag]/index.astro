---
import { pluralize } from '@shelkovo/format';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import NewsList from '@/components/news/NewsList.astro';
import { collectionPageSchema } from '@/lib/json-ld';
import { NEWS_LATEST_LIMIT } from '@/lib/news/config';
import { loadNewsTag } from '@/lib/news/load';
import { newsUrl, tagUrl, tagsUrl } from '@/lib/news/routes';
import { newsTagStaticPaths } from '@/lib/news/static-paths';

export const getStaticPaths = newsTagStaticPaths;

const key = Astro.params.tag;

if (!key) {
  throw new Error('news tag key is required');
}

const tag = await loadNewsTag(key);

if (!tag) {
  throw new Error(`news tag page "${key}" not found`);
}

const title = `Тема: ${tag.label} — Новости — Шелково Онлайн`;
const latestPublicationsLabel = `${NEWS_LATEST_LIMIT} ${pluralize(NEWS_LATEST_LIMIT, ['публикация', 'публикации', 'публикаций'])}`;
const description = `Последние новости Шелково по теме «${tag.label}»: ${latestPublicationsLabel}, а более ранние материалы доступны в архивах.`;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Новости', href: newsUrl() },
  { label: 'Теги', href: tagsUrl() },
  { label: tag.label },
]);
const schema = collectionPageSchema({
  name: title,
  description,
  url: tagUrl(tag.key),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Новости', url: newsUrl() },
    { name: 'Теги', url: tagsUrl() },
    { name: tag.label, url: tagUrl(tag.key) },
  ]),
  items: tag.latest.map((item) => ({ name: item.title, url: item.url })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={tag.url}
  keywords={['тег новостей', tag.label, 'Шелково']}
  schema={schema}
>
  <main class="ui-page news-tag-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />

        <div class="news-tag-heading">
          <h1 class="ui-page-title">
            #{tag.label}
          </h1>
          <p class="ui-copy news-tag-heading__summary">
            Последние новости по тегу
          </p>
        </div>
      </div>
    </section>

    <section class="news-tag-feed">
      <h2 class="ui-visually-hidden">Публикации по тегу {tag.label}</h2>
      {
        tag.count > tag.latest.length && (
          <p class="news-tag-feed__note">
            На этой странице показаны последние {latestPublicationsLabel} по
            тегу. Более ранние материалы доступны в месячных и годовых архивах.
          </p>
        )
      }

      <NewsList articles={tag.latest} empty="" />
    </section>
  </main>
</BaseLayout>

<style>
  .news-tag-page {
    padding-block-end: 1.5rem;
  }

  .news-tag-heading > :global(:not(:last-child)) {
    margin-block-end: 0.75rem;
  }

  .news-tag-heading__summary {
    max-width: 48rem;
    color: var(--color-text-muted);
  }

  .news-tag-feed {
    margin-block-start: 2rem;
  }

  .news-tag-feed > :global(:not(:last-child)) {
    margin-block-end: 1rem;
  }

  .news-tag-feed__note {
    padding-inline: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.75rem;
  }

  @media (min-width: 48rem) {
    .news-tag-page {
      padding-block-end: 2.5rem;
    }

    .news-tag-feed__note {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .news-tag-page {
      padding-block-end: 3rem;
    }
  }
</style>

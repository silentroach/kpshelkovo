---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsTagList from '@/components/news/NewsTagList.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import { loadNewsTags } from '@/lib/news/load';
import { newsUrl, tagsUrl } from '@/lib/news/routes';

const tags = await loadNewsTags();
const title = 'Темы новостей — Шелково Онлайн';
const description =
  'Темы новостей Шелково: события, сервисы и локальные сюжеты с быстрым переходом к публикациям по каждой теме.';
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Новости', href: newsUrl() },
  { label: 'Теги' },
]);
const schema = collectionPageSchema({
  name: title,
  description,
  url: tagsUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Новости', url: newsUrl() },
    { name: 'Теги', url: tagsUrl() },
  ]),
  items: tags.map((item) => ({ name: item.label, url: item.url })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={tagsUrl()}
  keywords={['теги новостей', 'Шелково', 'темы новостей Шелково']}
  schema={schema}
>
  <main class="ui-page pb-6 md:pb-10 lg:pb-12">
    <section class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />

        <div class="space-y-3">
          <h1 class="ui-page-title">Теги новостей</h1>
        </div>
      </div>
    </section>

    <section class="mt-8 space-y-4 px-5 md:px-6">
      <NewsTagList
        items={tags.map((item) => ({
          label: item.label,
          url: item.url,
          count: item.count,
        }))}
      />

      {
        tags.length === 0 && (
          <div class="ui-shell px-5 py-6 md:px-6 md:py-7">
            <p class="ui-copy text-muted-foreground">
              Пока ни одна публикация не получила редакционный тег. Индекс
              появится автоматически после первых новостей.
            </p>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>

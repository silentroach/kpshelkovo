---
import { count } from '@shelkovo/format';
import { formatDynamicHtml } from '@shelkovo/markdown';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import { loadNewsArchives } from '@/lib/news/load';
import { newsArchiveUrl, newsUrl } from '@/lib/news/routes';

const archives = await loadNewsArchives();
const title = 'Архив новостей — Шелково Онлайн';
const description =
  'Архив новостей Шелково по годам с переходом к публикациям каждого месяца.';
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Новости', href: newsUrl() },
  { label: 'Архив' },
]);
const schema = collectionPageSchema({
  name: title,
  description,
  url: newsArchiveUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Новости', url: newsUrl() },
    { name: 'Архив', url: newsArchiveUrl() },
  ]),
  items: archives.years.map((item) => ({
    name: `Новости за ${item.year} год`,
    url: item.url,
  })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={newsArchiveUrl()}
  keywords={['архив новостей Шелково', 'новости по годам']}
  schema={schema}
>
  <main class="ui-page news-archive-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />

        <h1 class="ui-page-title">Архив новостей</h1>
      </div>
    </section>

    <section class="news-archive-content" aria-label="Новости по годам">
      <div class="news-archive-container">
        {
          archives.years.length > 0 ? (
            <ul class="news-archive-list">
              {archives.years.map((item) => (
                <li>
                  <a href={item.url} class="news-archive-row">
                    <span class="news-archive-row__content">
                      <span class="ui-card-title news-archive-row__title">
                        {item.year}
                      </span>
                      <span
                        class="news-archive-row__count"
                        set:html={formatDynamicHtml(
                          count(item.count, ['новость', 'новости', 'новостей']),
                        )}
                      />
                    </span>
                    <span class="news-archive-row__arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="ui-copy news-archive-empty">Публикаций пока нет.</p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .news-archive-page {
    padding-block-end: 1.5rem;
  }

  .news-archive-content {
    margin-block-start: 2rem;
    padding-inline: 1.25rem;
  }

  .news-archive-container {
    max-width: 48rem;
  }

  .news-archive-list > li + li {
    margin-block-start: 0.25rem;
  }

  .news-archive-row {
    display: flex;
    align-items: center;
    min-height: 4rem;
    gap: 1rem;
    margin-inline: -0.75rem;
    padding: 1rem 0.75rem;
    transition: background-color 150ms ease;
  }

  .news-archive-row:hover {
    background: var(--color-primary-soft-2);
  }

  .news-archive-row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .news-archive-row__content {
    min-width: 0;
  }

  .news-archive-row__title {
    display: block;
    color: var(--color-primary);
    transition: color 150ms ease;
  }

  .news-archive-row__count {
    display: block;
    margin-block-start: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .news-archive-row__arrow {
    flex-shrink: 0;
    margin-inline-start: auto;
    color: var(--color-primary);
    font-size: 1.25rem;
    line-height: 1.75rem;
    transition: color 150ms ease;
  }

  .news-archive-row:hover
    :is(.news-archive-row__title, .news-archive-row__arrow) {
    color: var(--color-primary-hover);
  }

  .news-archive-empty {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .news-archive-page {
      padding-block-end: 2.5rem;
    }

    .news-archive-content {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .news-archive-page {
      padding-block-end: 3rem;
    }
  }
</style>

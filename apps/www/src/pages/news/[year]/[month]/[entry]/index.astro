---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsAttachments from '@/components/news/NewsAttachments.astro';
import NewsEventCard from '@/components/news/NewsEventCard.astro';
import NewsMeta from '@/components/news/NewsMeta.astro';
import NewsPhotos from '@/components/news/NewsPhotos.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import { loadNewsArticle } from '@/lib/news/load';
import { newsArticleSchema } from '@/lib/news/seo';
import { newsArticleStaticPaths } from '@/lib/news/static-paths';
import { NEWS_PROSE, formatNewsMonth } from '@/lib/news/view';
import { articleUrl, monthUrl, newsUrl, yearUrl } from '@/lib/news/routes';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = newsArticleStaticPaths;

const HERO_COVER_WIDTHS = [480, 768, 960, 1280, 1600, 2200] as const;

const year = Astro.params.year;
const month = Astro.params.month;
const entry = Astro.params.entry;

if (!year || !month || !entry) {
  throw new Error('news article params are required');
}

const id = `${year}/${month}/${entry}`;
const article = await loadNewsArticle(id);
const source = await getEntry('newsArticles', id);

if (!article || !source) {
  throw new Error(`news article "${id}" not found`);
}

const bodyHtml = article.body ? renderMarkdown(article.body) : undefined;
const monthName = formatNewsMonth(article.year, article.month, {
  capitalize: true,
});
const monthBreadcrumbName = formatNewsMonth(article.year, article.month, {
  capitalize: true,
  includeYear: false,
});
const heroCoverWidth = source.data.cover
  ? Math.min(source.data.cover.width, 2200)
  : undefined;
const heroCover =
  source.data.cover && heroCoverWidth
    ? {
        src: source.data.cover,
        width: heroCoverWidth,
        height: Math.round(
          (source.data.cover.height * heroCoverWidth) / source.data.cover.width,
        ),
        widths: [
          ...HERO_COVER_WIDTHS.filter(
            (candidate) => candidate < heroCoverWidth,
          ),
          heroCoverWidth,
        ],
      }
    : undefined;
const hasHeroCover = Boolean(heroCover);
const hasEvents = article.events.length > 0;
const title = `${article.seo?.title ?? article.title} — Новости — Шелково Онлайн`;
const description = article.seo?.description ?? article.summary;
const search = {
  scope: 'manual',
  title: article.title,
  description,
  section: SEARCH_SECTIONS.news,
  publishedAt: article.publishedIso.slice(0, 10),
  tags: article.tags.map((tag) => tag.label),
  aliases: article.searchAliases,
} satisfies SearchDocument;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Новости', href: newsUrl() },
  { label: String(article.year), href: yearUrl(article.year) },
  {
    label: monthBreadcrumbName,
    href: monthUrl(article.year, article.month),
  },
  { label: article.title },
]);
const author = {
  '@type': article.author.kind === 'official' ? 'Organization' : 'Person',
  name: article.author.name,
  ...(article.author.url ? { url: article.author.url } : {}),
};
const images = [
  ...new Set([
    ...(article.cover ? [article.cover.url] : []),
    ...article.photos.map((photo) => photo.url),
  ]),
];
const schema = newsArticleSchema({
  name: article.title,
  description,
  url: articleUrl(article),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Новости', url: newsUrl() },
    { name: String(article.year), url: yearUrl(article.year) },
    { name: monthBreadcrumbName, url: monthUrl(article.year, article.month) },
    { name: article.title, url: articleUrl(article) },
  ]),
  datePublished: article.publishedIso,
  image: images.length > 0 ? images : undefined,
  author,
  ...(hasEvents ? { events: article.events } : {}),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={article.url}
  image={article.cover?.url}
  imageAlt={article.cover?.alt}
  type="article"
  keywords={[
    'новости Шелково',
    article.title,
    ...article.tags.map((item) => item.label),
  ]}
  schema={schema}
  search={search}
>
  <main class="news-article-page">
    {
      hasHeroCover ? (
        <header class="news-hero">
          <Image
            src={heroCover.src}
            width={heroCover.width}
            height={heroCover.height}
            widths={heroCover.widths}
            sizes="100vw"
            format="webp"
            quality={82}
            alt=""
            aria-hidden="true"
            priority
            class="news-hero__image"
          />
          <div class="news-hero-overlay-top" />
          <div class="news-hero-overlay-side" />

          <div class="ui-page news-hero__layout">
            <div class="news-hero__breadcrumbs">
              <Breadcrumbs items={breadcrumbs} linkLast />
            </div>

            <div class="news-hero__content">
              <div class="news-hero__content-inner">
                <div class="news-article-heading">
                  <h1 class="ui-page-title">{article.title}</h1>

                  {article.tags.length > 0 && (
                    <ul class="news-article-tags">
                      {article.tags.map((item) => (
                        <li>
                          <a
                            href={item.url}
                            aria-label={`Тег ${item.label}`}
                            class="news-tag-inline-link"
                          >
                            #{item.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <NewsMeta
                  publishedIso={article.publishedIso}
                  author={article.author}
                  fullAuthorName
                  areas={article.areas}
                  appliesToAllAreas={article.appliesToAllAreas}
                  sourceUrl={article.sourceUrl}
                  variant="prominent"
                />
              </div>
            </div>
          </div>
        </header>
      ) : (
        <header class="ui-page ui-page-header">
          <div class="ui-page-header-stack news-article-header__inner">
            <Breadcrumbs items={breadcrumbs} linkLast />

            <div class="news-article-header__content">
              <div class="news-article-heading">
                <h1 class="ui-page-title">{article.title}</h1>

                {article.tags.length > 0 && (
                  <ul class="news-article-tags">
                    {article.tags.map((item) => (
                      <li>
                        <a
                          href={item.url}
                          aria-label={`Тег ${item.label}`}
                          class="news-tag-inline-link"
                        >
                          #{item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <NewsMeta
                publishedIso={article.publishedIso}
                author={article.author}
                fullAuthorName
                areas={article.areas}
                appliesToAllAreas={article.appliesToAllAreas}
                sourceUrl={article.sourceUrl}
              />
            </div>
          </div>
        </header>
      )
    }

    <article
      class:list={[
        'ui-page news-article-content',
        hasHeroCover ? 'news-article-content--with-cover' : undefined,
      ]}
    >
      {
        article.body && (
          <section
            class:list={[
              'news-article-body-section',
              hasHeroCover
                ? 'news-article-body-section--with-cover'
                : undefined,
            ]}
          >
            <div
              class:list={[
                'news-article-body-layout',
                hasEvents ? 'news-article-body-layout--with-event' : undefined,
              ]}
            >
              <div class={NEWS_PROSE} data-pagefind-body set:html={bodyHtml} />

              {hasEvents && (
                <div class="news-article-event-aside">
                  {article.events.map((event) => (
                    <NewsEventCard event={event} variant="compact" />
                  ))}
                </div>
              )}
            </div>
          </section>
        )
      }

      {
        !article.body && hasEvents && (
          <section
            class:list={[
              'news-article-event-section',
              hasHeroCover
                ? 'news-article-event-section--with-cover'
                : undefined,
            ]}
          >
            <div class="news-article-event-only">
              {article.events.map((event) => (
                <NewsEventCard event={event} variant="compact" />
              ))}
            </div>
          </section>
        )
      }

      <NewsPhotos photos={article.photos} />
      <NewsAttachments items={article.attachments} />
    </article>
  </main>
</BaseLayout>

<style>
  .news-article-page {
    padding-block-end: 1.5rem;
  }

  .news-hero {
    --news-hero-foreground: oklch(97.2% 0.004 130);
    --news-hero-muted-foreground: oklch(88.8% 0.012 130);
    --news-hero-primary: oklch(90.5% 0.022 142);
    --news-hero-primary-hover: oklch(96.4% 0.01 140);
    --news-hero-border: color-mix(
      in oklab,
      var(--news-hero-foreground) 24%,
      transparent
    );
    --news-hero-border-strong: color-mix(
      in oklab,
      var(--news-hero-foreground) 52%,
      transparent
    );
    --news-hero-ring: oklch(97% 0.01 140);
    --news-hero-overlay-top: oklch(24% 0.04 145 / 0.14);
    --news-hero-overlay-side-strong: oklch(24% 0.04 145 / 0.36);
    --news-hero-overlay-side-mid: oklch(24% 0.04 145 / 0.18);
    --news-hero-overlay-side-soft: oklch(24% 0.04 145 / 0.06);
    --color-text: var(--news-hero-foreground);
    --color-text-muted: var(--news-hero-muted-foreground);
    --color-foreground: var(--news-hero-foreground);
    --color-muted-foreground: var(--news-hero-muted-foreground);
    --color-primary: var(--news-hero-primary);
    --color-primary-hover: var(--news-hero-primary-hover);
    --color-border: var(--news-hero-border);
    --color-border-strong: var(--news-hero-border-strong);
    --color-ring: var(--news-hero-ring);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-bg);
  }

  .news-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 64%;
    filter: brightness(1.05);
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0) 0%,
      rgb(0 0 0) 68%,
      rgb(0 0 0 / 86%) 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0) 0%,
      rgb(0 0 0) 68%,
      rgb(0 0 0 / 86%) 82%,
      transparent 100%
    );
  }

  .news-hero-overlay-top,
  .news-hero-overlay-side {
    position: absolute;
  }

  .news-hero-overlay-top {
    inset-block-start: 0;
    inset-inline: 0;
    height: 6rem;
    background: linear-gradient(
      to bottom,
      var(--news-hero-overlay-top),
      transparent
    );
  }

  .news-hero-overlay-side {
    inset-block: 0;
    inset-inline-start: 0;
    width: min(54rem, 100%);
    background: linear-gradient(
      90deg,
      var(--news-hero-overlay-side-strong) 0%,
      var(--news-hero-overlay-side-mid) 52%,
      var(--news-hero-overlay-side-soft) 78%,
      transparent 100%
    );
  }

  .news-hero__layout {
    position: relative;
    display: flex;
    min-height: 20rem;
    flex-direction: column;
    padding-block-start: 1rem;
  }

  .news-hero__breadcrumbs,
  .news-hero__content,
  .news-article-body-section,
  .news-article-event-section {
    padding-inline: 1.25rem;
  }

  .news-hero__content {
    margin-block-start: auto;
    padding-block-end: 1rem;
  }

  .news-hero__content-inner,
  .news-article-header__inner {
    max-width: 56rem;
  }

  .news-hero__content-inner > :global(:not(:last-child)),
  .news-article-header__content > :global(:not(:last-child)) {
    margin-block-end: 1rem;
  }

  .news-article-heading > :global(:not(:last-child)) {
    margin-block-end: 0.875rem;
  }

  .news-article-tags {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    row-gap: 0.375rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25rem;
  }

  .news-tag-inline-link {
    color: color-mix(
      in oklab,
      var(--color-primary) 38%,
      var(--color-muted-foreground) 62%
    );
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease,
      text-underline-offset 0.2s ease;
  }

  .news-tag-inline-link:is(:hover, :focus-visible) {
    color: color-mix(
      in oklab,
      var(--color-primary-hover) 52%,
      var(--color-muted-foreground) 48%
    );
    text-decoration-color: color-mix(in oklab, currentColor 30%, transparent);
    text-underline-offset: 0.18em;
  }

  .news-article-content {
    position: relative;
    z-index: 10;
  }

  .news-article-content--with-cover {
    padding-block-start: 0;
  }

  .news-article-content > :global(:not(:last-child)) {
    margin-block-end: 1.5rem;
  }

  .news-article-body-section {
    padding-block-end: 1.5rem;
  }

  .news-article-body-section--with-cover {
    padding-block-start: 1.5rem;
  }

  .news-article-event-section--with-cover {
    margin-block-start: -2rem;
  }

  .news-article-body-layout {
    display: grid;
    align-items: start;
    gap: 1.25rem;
  }

  .news-article-event-aside,
  .news-article-event-only {
    display: grid;
    gap: 1rem;
    width: min(100%, 24rem);
  }

  @media (min-width: 48rem) {
    .news-article-page {
      padding-block-end: 2.5rem;
    }

    .news-hero-overlay-top {
      height: 7rem;
    }

    .news-hero__layout {
      min-height: 24rem;
      padding-block-start: 1.25rem;
    }

    .news-hero__breadcrumbs,
    .news-hero__content,
    .news-article-body-section,
    .news-article-event-section {
      padding-inline: 1.5rem;
    }

    .news-hero__content {
      padding-block-end: 1.5rem;
    }

    .news-article-tags {
      column-gap: 1rem;
    }

    .news-article-body-section {
      padding-block-end: 2rem;
    }

    .news-article-body-section--with-cover {
      padding-block-start: 2rem;
    }

    .news-article-event-section--with-cover {
      margin-block-start: -2.5rem;
    }
  }

  @media (min-width: 64rem) {
    .news-article-page {
      padding-block-end: 3rem;
    }

    .news-hero-overlay-top {
      height: 8rem;
    }

    .news-hero__layout {
      min-height: 28rem;
      padding-block-start: 1.5rem;
    }

    .news-hero__content {
      padding-block-end: 2rem;
    }

    .news-article-body-section {
      padding-block-end: 2.5rem;
    }

    .news-article-body-section--with-cover {
      padding-block-start: 2.5rem;
    }

    .news-article-event-section--with-cover {
      margin-block-start: -3rem;
    }
  }

  @media (min-width: 72rem) {
    .news-article-body-layout--with-event {
      grid-template-columns: minmax(0, 70ch) minmax(14rem, 17.5rem);
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .news-article-event-aside {
      width: 100%;
    }
  }

  @media (max-width: 47.999rem) {
    .news-article-event-aside,
    .news-article-event-only {
      width: 100%;
    }
  }
</style>

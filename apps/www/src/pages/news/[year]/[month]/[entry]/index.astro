---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsAttachments from '@/components/news/NewsAttachments.astro';
import EventWidget from '@/components/events/EventWidget.astro';
import NewsMeta from '@/components/news/NewsMeta.astro';
import NewsPhotos from '@/components/news/NewsPhotos.astro';
import EditorialMapScript from '@/components/maps/EditorialMapScript.astro';
import '@/components/maps/editorial-map.css';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import { loadNewsArticle } from '@/lib/news/load';
import { newsArticleSchema } from '@/lib/news/seo';
import { newsArticleStaticPaths } from '@/lib/news/static-paths';
import { NEWS_PROSE, formatNewsMonth } from '@/lib/news/view';
import { articleUrl, monthUrl, newsUrl, yearUrl } from '@/lib/news/routes';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = newsArticleStaticPaths;

const year = Astro.params.year;
const month = Astro.params.month;
const entry = Astro.params.entry;
if (!year || !month || !entry) {
  throw new Error('news article params are required');
}

const id = `${year}/${month}/${entry}`;
const article = await loadNewsArticle(id);
if (!article) {
  throw new Error(`news article "${id}" not found`);
}

const bodyHtml = article.body
  ? renderMarkdown(article.body, { eagerImages: true, editorialMaps: true })
  : undefined;
const hasEditorialMap = bodyHtml?.includes('<editorial-map') ?? false;
const monthBreadcrumbName = formatNewsMonth(article.year, article.month, {
  capitalize: true,
  includeYear: false,
});
const hasEvents = article.events.length > 0;
const title = `${article.seo?.title ?? article.title} — Новости — Шелково Онлайн`;
const description = article.seo?.description ?? article.summary;
const search = {
  scope: 'manual',
  title: article.title,
  description,
  section: SEARCH_SECTIONS.news,
  publishedAt: article.publishedIso.slice(0, 10),
  tags: article.tags.map((tag) => tag.label),
  aliases: article.searchAliases,
} satisfies SearchDocument;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Новости', href: newsUrl() },
  { label: String(article.year), href: yearUrl(article.year) },
  { label: monthBreadcrumbName, href: monthUrl(article.year, article.month) },
  { label: article.title },
]);
const author =
  article.author.kind === 'editorial'
    ? undefined
    : {
        '@type': article.author.kind === 'official' ? 'Organization' : 'Person',
        name: article.author.name,
        url: article.author.url,
      };
const images = [...new Set(article.photos.map((photo) => photo.url))];
const schema = newsArticleSchema({
  name: article.title,
  description,
  url: articleUrl(article),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Новости', url: newsUrl() },
    { name: String(article.year), url: yearUrl(article.year) },
    { name: monthBreadcrumbName, url: monthUrl(article.year, article.month) },
    { name: article.title, url: articleUrl(article) },
  ]),
  datePublished: article.publishedIso,
  image: images.length > 0 ? images : undefined,
  author,
  events: hasEvents ? article.events : undefined,
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={article.url}
  type="article"
  keywords={[
    'новости Шелково',
    article.title,
    ...article.tags.map((item) => item.label),
  ]}
  schema={schema}
  search={search}
>
  <main class="news-article-page">
    <article
      class:list={[
        'ui-page ui-page-header-stack news-article-layout',
        { 'news-article-layout--with-events': hasEvents },
      ]}
    >
      <div class="ui-page-header ui-breadcrumbs news-article-breadcrumbs">
        <Breadcrumbs items={breadcrumbs} linkLast />
      </div>
      <header class="news-article-header__content">
        <div class="news-article-heading">
          <h1 class="ui-page-title">{article.title}</h1>
          {article.tags.length > 0 && (
            <ul class="news-article-tags">
              {article.tags.map((item) => (
                <li>
                  <a
                    href={item.url}
                    aria-label={`Тег ${item.label}`}
                    class="news-tag-inline-link"
                  >
                    #{item.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
        <NewsMeta
          publishedIso={article.publishedIso}
          author={article.author}
          fullAuthorName
          areas={article.areas}
          appliesToAllAreas={article.appliesToAllAreas}
          sourceUrl={article.sourceUrl}
        />
      </header>
      {bodyHtml && (
        <div class="news-article-body">
          <div class={NEWS_PROSE} data-pagefind-body set:html={bodyHtml} />
        </div>
      )}
      {hasEvents && (
        <div class="news-article-event-aside">
          {article.events.map((event) => (
            <EventWidget event={event} newsSlug={event.slug} />
          ))}
        </div>
      )}
      {(article.photos.length > 0 || article.attachments.length > 0) && (
        <div class="news-article-media">
          <NewsPhotos photos={article.photos} />
          <NewsAttachments items={article.attachments} />
        </div>
      )}
    </article>
  </main>
  {hasEditorialMap && <EditorialMapScript />}
</BaseLayout>

<style>
  .news-article-page {
    padding-block-end: 1.5rem;
  }

  .news-article-header__content {
    max-width: 56rem;
  }

  .news-article-header__content > :global(:not(:last-child)) {
    margin-block-end: 1rem;
  }

  .news-article-heading > :global(:not(:last-child)) {
    margin-block-end: 0.875rem;
  }

  .news-article-tags {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    row-gap: 0.375rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.25rem;
  }

  .news-tag-inline-link {
    color: color-mix(
      in oklab,
      var(--color-primary) 38%,
      var(--color-text-muted) 62%
    );
    font-weight: 400;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease,
      text-underline-offset 0.2s ease;
  }

  .news-tag-inline-link:is(:hover, :focus-visible) {
    color: color-mix(
      in oklab,
      var(--color-primary-hover) 52%,
      var(--color-text-muted) 48%
    );
    text-decoration-color: color-mix(in oklab, currentColor 30%, transparent);
    text-underline-offset: 0.18em;
  }

  .news-article-layout {
    position: relative;
    z-index: 10;
    display: grid;
    align-items: start;
    padding-inline: 1.25rem;
  }
  .news-article-breadcrumbs {
    padding-inline: 0;
    padding-bottom: 0;
  }
  .news-article-body {
    min-width: 0;
  }
  .news-article-media {
    min-width: 0;
    margin-inline: -1.25rem;
  }
  .news-article-media > :global(:not(:last-child)) {
    margin-block-end: 1.5rem;
  }
  .news-article-event-aside {
    display: grid;
    gap: 1rem;
    width: 100%;
  }

  @media screen {
    .news-article-body > .ui-prose > :global(p:first-child:not(:has(img))) {
      color: var(--color-text);
      font-size: 1.125rem;
      line-height: 1.6;
    }
  }

  @media screen and (min-width: 48rem) {
    .news-article-body > .ui-prose > :global(p:first-child:not(:has(img))) {
      font-size: 1.25rem;
    }
  }

  @media screen and (width < 40rem) {
    .news-article-header__content .ui-page-title {
      overflow-wrap: anywhere;
    }
  }

  @media (min-width: 48rem) {
    .news-article-page {
      padding-block-end: 2.5rem;
    }
    .news-article-layout {
      padding-inline: 1.5rem;
    }
    .news-article-tags {
      column-gap: 1rem;
    }
    .news-article-media {
      margin-inline: -1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .news-article-page {
      padding-block-end: 3rem;
    }
    .news-article-layout--with-events {
      grid-template-columns: minmax(0, 1fr) 19rem;
      grid-template-rows: auto auto 1fr auto;
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }
    .news-article-breadcrumbs,
    .news-article-media {
      grid-column: 1 / -1;
    }
    .news-article-header__content {
      grid-column: 1;
      grid-row: 2;
    }
    .news-article-body {
      grid-column: 1;
      grid-row: 3;
    }
    .news-article-event-aside {
      width: 100%;
      grid-column: 2;
      grid-row: 2 / 4;
    }
  }
</style>

---
import { count } from '@shelkovo/format';
import { formatDynamicHtml } from '@shelkovo/markdown';
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import NewsArchiveSummary from '@/components/news/NewsArchiveSummary.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { loadNewsArchives } from '@/lib/news/load';
import { collectionPageSchema } from '@/lib/news/seo';
import { formatNewsMonth } from '@/lib/news/view';
import { newsArchiveUrl, yearUrl } from '@/lib/news/routes';

export const getStaticPaths = (async () => {
  const archives = await loadNewsArchives();

  return archives.years.map((item) => ({
    params: { year: String(item.year) },
  }));
}) satisfies GetStaticPaths;

const year = Number(Astro.params.year);
const archives = await loadNewsArchives();
const archive = archives.byYear.get(year);

if (!archive) {
  throw new Error(`news year archive "${Astro.params.year}" not found`);
}

const title = `Новости за ${archive.year} год — Шелково Онлайн`;
const description = `Архив новостей Шелково за ${archive.year} год с переходами к публикациям каждого месяца.`;
const months = [...archive.months].sort((a, b) => a.month - b.month);
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Новости', href: newsArchiveUrl() },
  { label: String(archive.year) },
]);

const schema = collectionPageSchema({
  name: title,
  description,
  url: yearUrl(archive.year),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Новости', url: newsArchiveUrl() },
    { name: String(archive.year), url: yearUrl(archive.year) },
  ]),
  items: months.map((item) => ({
    name: formatNewsMonth(item.year, item.month, { capitalize: true }),
    url: item.url,
  })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={yearUrl(archive.year)}
  keywords={[
    'архив новостей Шелково',
    String(archive.year),
    'новости по месяцам',
  ]}
  schema={schema}
>
  <main class="ui-page pb-6 md:pb-10 lg:pb-12">
    <section class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />

        <h1 class="ui-page-title">
          Новости за {archive.year} год
        </h1>

        <NewsArchiveSummary
          summary={archive.summary}
          label={`Краткий обзор новостей за ${archive.year} год`}
        />
      </div>
    </section>

    <section
      class="mt-8 px-5 md:px-6"
      aria-label={`Новости за ${archive.year} год по месяцам`}
    >
      <div class="max-w-3xl">
        <ul class="space-y-1">
          {
            months.map((item) => (
              <li>
                <a
                  href={item.url}
                  class="group -mx-3 flex min-h-16 items-center gap-4 px-3 py-4 transition-colors hover:bg-primary-soft-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  <span class="min-w-0">
                    <span class="ui-card-title block text-primary transition-colors group-hover:text-primary-hover">
                      {formatNewsMonth(item.year, item.month, {
                        capitalize: true,
                        includeYear: false,
                      })}
                    </span>
                    <span
                      class="mt-1 block text-sm text-muted-foreground"
                      set:html={formatDynamicHtml(
                        count(item.count, ['новость', 'новости', 'новостей']),
                      )}
                    />
                  </span>
                  <span
                    class="ml-auto shrink-0 text-xl text-primary transition-colors group-hover:text-primary-hover"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

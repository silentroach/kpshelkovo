---
import { count } from '@shelkovo/format';
import { formatDynamicHtml } from '@shelkovo/markdown';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import NewsArchiveSummary from '@/components/news/NewsArchiveSummary.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import { loadNewsArchives } from '@/lib/news/load';
import { newsYearStaticPaths } from '@/lib/news/static-paths';
import { formatNewsMonth } from '@/lib/news/view';
import { newsArchiveUrl, yearUrl } from '@/lib/news/routes';

export const getStaticPaths = newsYearStaticPaths;

const year = Number(Astro.params.year);
const archives = await loadNewsArchives();
const archive = archives.byYear.get(year);

if (!archive) {
  throw new Error(`news year archive "${Astro.params.year}" not found`);
}

const title = `Новости за ${archive.year} год — Шелково Онлайн`;
const description = `Архив новостей Шелково за ${archive.year} год с переходами к публикациям каждого месяца.`;
const months = [...archive.months].sort((a, b) => a.month - b.month);
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Новости', href: newsArchiveUrl() },
  { label: String(archive.year) },
]);

const schema = collectionPageSchema({
  name: title,
  description,
  url: yearUrl(archive.year),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Новости', url: newsArchiveUrl() },
    { name: String(archive.year), url: yearUrl(archive.year) },
  ]),
  items: months.map((item) => ({
    name: formatNewsMonth(item.year, item.month, { capitalize: true }),
    url: item.url,
  })),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={yearUrl(archive.year)}
  keywords={[
    'архив новостей Шелково',
    String(archive.year),
    'новости по месяцам',
  ]}
  schema={schema}
>
  <main class="ui-page news-year-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />

        <h1 class="ui-page-title">
          Новости за {archive.year} год
        </h1>

        <NewsArchiveSummary
          summary={archive.summary}
          label={`Краткий обзор новостей за ${archive.year} год`}
        />
      </div>
    </section>

    <section
      class="news-year-content"
      aria-label={`Новости за ${archive.year} год по месяцам`}
    >
      <div class="news-archive-container">
        <ul class="news-archive-list">
          {
            months.map((item) => (
              <li>
                <a href={item.url} class="news-archive-row">
                  <span class="news-archive-row__content">
                    <span class="ui-card-title news-archive-row__title">
                      {formatNewsMonth(item.year, item.month, {
                        capitalize: true,
                        includeYear: false,
                      })}
                    </span>
                    <span
                      class="news-archive-row__count"
                      set:html={formatDynamicHtml(
                        count(item.count, ['новость', 'новости', 'новостей']),
                      )}
                    />
                  </span>
                  <span class="news-archive-row__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .news-year-page {
    padding-block-end: 1.5rem;
  }

  .news-year-content {
    margin-block-start: 2rem;
    padding-inline: 1.25rem;
  }

  .news-archive-container {
    max-width: 48rem;
  }

  .news-archive-list > li + li {
    margin-block-start: 0.25rem;
  }

  .news-archive-row {
    display: flex;
    align-items: center;
    min-height: 4rem;
    gap: 1rem;
    margin-inline: -0.75rem;
    padding: 1rem 0.75rem;
    transition: background-color 150ms ease;
  }

  .news-archive-row:hover {
    background: var(--color-primary-soft-2);
  }

  .news-archive-row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .news-archive-row__content {
    min-width: 0;
  }

  .news-archive-row__title {
    display: block;
    color: var(--color-primary);
    transition: color 150ms ease;
  }

  .news-archive-row__count {
    display: block;
    margin-block-start: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .news-archive-row__arrow {
    flex-shrink: 0;
    margin-inline-start: auto;
    color: var(--color-primary);
    font-size: 1.25rem;
    line-height: 1.75rem;
    transition: color 150ms ease;
  }

  .news-archive-row:hover
    :is(.news-archive-row__title, .news-archive-row__arrow) {
    color: var(--color-primary-hover);
  }

  @media (min-width: 48rem) {
    .news-year-page {
      padding-block-end: 2.5rem;
    }

    .news-year-content {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .news-year-page {
      padding-block-end: 3rem;
    }
  }
</style>

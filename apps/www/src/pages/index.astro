---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SHELKOVO_SITE_ALTERNATE_NAMES, type SchemaDoc } from '@shelkovo/seo';
import dayHero from '@/assets/home/home-hero-day.png';
import nightHero from '@/assets/home/home-hero-night.png';
import socialCover from '@/assets/home/home-social.jpg';
import HomeNewsArticle from '@/components/home/HomeNewsArticle.astro';
import HomeServiceSummary from '@/components/home/HomeServiceSummary.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getHomeHeroMode } from '@/lib/home/hero';
import { selectHomeNews } from '@/lib/home/news';
import { loadNewsArticles } from '@/lib/news/load';
import { canon } from '@/lib/site';
import { loadStatusIncidents } from '@/lib/status/load';

const title = 'Шелково Онлайн';
const description =
  'Главный сайт поселка Шелково: новости, статус сервисов, сравнение тарифов и справочная информация по связанным проектам.';
const keywords = [
  'КП Шелково',
  'коттеджный поселок Шелково',
  'Шелково Эко Клаб',
  'Shelkovo Eco Club',
  'сайт жителей Шелково',
  'новости Шелково',
  'статус КП Шелково',
];
const siteUrl = canon('/');
const organizationId = `${siteUrl}#organization`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: title,
    alternateName: SHELKOVO_SITE_ALTERNATE_NAMES,
    url: siteUrl,
    inLanguage: 'ru-RU',
    publisher: {
      '@id': organizationId,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: title,
    alternateName: SHELKOVO_SITE_ALTERNATE_NAMES,
    url: siteUrl,
  },
] satisfies readonly SchemaDoc[];

const [news, incidents] = await Promise.all([
  loadNewsArticles(),
  loadStatusIncidents(),
]);
const { lead, secondary } = selectHomeNews(news);
const buildNow = Date.now();

const heroWidths = [960, 1280, 1536, 1916, 2172] as const;
const heroSizes = '100vw';
const buildHeroImage = async (src: ImageMetadata) => {
  const images = await Promise.all(
    heroWidths.map((width) =>
      getImage({ src, width, format: 'webp', quality: 84 }),
    ),
  );

  return {
    src: images[images.length - 1]?.src ?? src.src,
    srcset: images
      .map((image, index) => `${image.src} ${heroWidths[index]}w`)
      .join(', '),
  };
};
const [dayHeroImage, nightHeroImage] = await Promise.all([
  buildHeroImage(dayHero),
  buildHeroImage(nightHero),
]);
const heroMode = getHomeHeroMode();
const heroImage = heroMode === 'day' ? dayHeroImage : nightHeroImage;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schema={schema}
  image={socialCover.src}
  imageAlt="Иллюстрация Шелково: дорога к домам среди зелёных холмов и деревьев"
  imageWidth={socialCover.width}
  imageHeight={socialCover.height}
  overlaySiteHeader
>
  <main class="home-main">
    <section class="home-hero" data-home-hero-mode={heroMode}>
      <div class="home-hero__media">
        <img
          sizes={heroSizes}
          alt="Панорама поселка Шелково"
          width={dayHero.width}
          height={dayHero.height}
          class="home-hero__image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          hidden
          data-home-hero-image
          data-day-src={dayHeroImage.src}
          data-day-srcset={dayHeroImage.srcset}
          data-night-src={nightHeroImage.src}
          data-night-srcset={nightHeroImage.srcset}
        />
        <noscript>
          <img
            src={heroImage.src}
            srcset={heroImage.srcset}
            sizes={heroSizes}
            alt="Панорама поселка Шелково"
            width={dayHero.width}
            height={dayHero.height}
            class="home-hero__image"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-home-hero-fallback
          />
        </noscript>
        <script>
          import { installHomeHeroHydration } from '@/lib/home/hero';

          installHomeHeroHydration();
        </script>
      </div>
      <HomeServiceSummary incidents={incidents} buildNow={buildNow} />
    </section>

    <section class="ui-page home-news" aria-labelledby="home-news-title">
      <h1 id="home-news-title" class="ui-page-title home-news__title">
        Новости
      </h1>
      {lead && (
        <div
          class:list={[
            'home-news__grid',
            { 'home-news__grid--split': secondary.length > 0 },
          ]}
        >
          <HomeNewsArticle article={lead} lead />
          {secondary.length > 0 && (
            <div class="home-news__secondary">
              {secondary.map((article) => (
                <HomeNewsArticle article={article} />
              ))}
            </div>
          )}
        </div>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .home-main {
    padding-block-end: 0.5rem;
  }

  .home-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface-muted);
  }

  .home-hero__media {
    width: 100%;
    height: clamp(20rem, 37vw, 36rem);
    overflow: hidden;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
  }

  .home-news {
    width: min(calc(100% - 2.5rem), 70.75rem);
    padding-block: 1.5rem 2rem;
  }

  .home-news__title {
    padding-block-end: 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 2rem;
  }

  .home-news__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    padding-block-start: 1.25rem;
  }

  .home-news__secondary {
    min-width: 0;
    padding-block-start: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 48rem) {
    .home-main {
      padding-block-end: 0.75rem;
    }

    .home-hero__image {
      object-position: center;
    }

    .home-news {
      padding-block: 2rem 3rem;
    }

    .home-news__title {
      font-size: 2.625rem;
    }

    .home-news__grid {
      gap: 2rem;
      padding-block-start: 1.75rem;
    }

    .home-news__grid--split {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }

    .home-news__secondary {
      padding-block-start: 0;
      padding-inline-start: 2rem;
      border-top: 0;
      border-inline-start: 1px solid var(--color-border);
    }
  }

  @media (min-width: 64rem) {
    .home-main {
      padding-block-end: 1rem;
    }
  }
</style>

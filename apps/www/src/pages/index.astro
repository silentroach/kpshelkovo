---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SHELKOVO_SITE_ALTERNATE_NAMES, type SchemaDoc } from '@shelkovo/seo';
import dayHero from '@/assets/home/home-hero-day.png';
import nightHero from '@/assets/home/home-hero-night.png';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getHomeHeroMode } from '@/lib/home/hero';
import { loadNewsArticles } from '@/lib/news/load';
import { articleUrl } from '@/lib/news/routes';
import { formatNewsDate } from '@/lib/news/view';
import { canon } from '@/lib/site';

const title = 'Шелково Онлайн';
const description =
  'Главный сайт поселка Шелково: новости, статус сервисов, сравнение тарифов и справочная информация по связанным проектам.';
const keywords = [
  'КП Шелково',
  'коттеджный поселок Шелково',
  'Шелково Эко Клаб',
  'Shelkovo Eco Club',
  'сайт жителей Шелково',
  'новости Шелково',
  'статус КП Шелково',
];
const siteUrl = canon('/');
const organizationId = `${siteUrl}#organization`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: title,
    alternateName: SHELKOVO_SITE_ALTERNATE_NAMES,
    url: siteUrl,
    inLanguage: 'ru-RU',
    publisher: {
      '@id': organizationId,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: title,
    alternateName: SHELKOVO_SITE_ALTERNATE_NAMES,
    url: siteUrl,
  },
] satisfies readonly SchemaDoc[];

const news = await loadNewsArticles();
const latestNews = news.slice(0, 3);

const heroWidths = [960, 1280, 1536, 1916, 2172] as const;
const heroSizes = '100vw';
const buildHeroImage = async (src: ImageMetadata) => {
  const images = await Promise.all(
    heroWidths.map((width) =>
      getImage({ src, width, format: 'webp', quality: 82 }),
    ),
  );

  return {
    src: images[images.length - 1]?.src ?? src.src,
    srcset: images
      .map((image, index) => `${image.src} ${heroWidths[index]}w`)
      .join(', '),
  };
};
const [dayHeroImage, nightHeroImage] = await Promise.all([
  buildHeroImage(dayHero),
  buildHeroImage(nightHero),
]);
const heroMode = getHomeHeroMode();
const heroImage = heroMode === 'day' ? dayHeroImage : nightHeroImage;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  schema={schema}
  overlaySiteHeader
>
  <main class="home-main">
    <section class="home-hero" data-home-hero-mode={heroMode}>
      <div class="home-hero__media">
        <img
          sizes={heroSizes}
          alt="Панорама поселка Шелково"
          width={dayHero.width}
          height={dayHero.height}
          class="home-hero__image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          hidden
          data-home-hero-image
          data-day-src={dayHeroImage.src}
          data-day-srcset={dayHeroImage.srcset}
          data-night-src={nightHeroImage.src}
          data-night-srcset={nightHeroImage.srcset}
        />
        <noscript>
          <img
            src={heroImage.src}
            srcset={heroImage.srcset}
            sizes={heroSizes}
            alt="Панорама поселка Шелково"
            width={dayHero.width}
            height={dayHero.height}
            class="home-hero__image"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-home-hero-fallback
          />
        </noscript>
        <script>
          import { installHomeHeroHydration } from '@/lib/home/hero';

          installHomeHeroHydration();
        </script>
      </div>
    </section>

    {
      latestNews.length > 0 && (
        <section class="ui-page home-news">
          <div class="home-news__inner">
            <h1 class="ui-page-title home-news__title">Что нового в поселке</h1>

            <div>
              {latestNews.map((article) => (
                <article class="home-news__item">
                  <p class="home-news__date">
                    <time datetime={article.publishedIso}>
                      {formatNewsDate(article.publishedIso)}
                    </time>
                  </p>

                  <div class="home-news__copy">
                    <h2 class="ui-entry-title home-news__item-title">
                      <a href={articleUrl(article)} class="ui-link">
                        {article.title}
                      </a>
                    </h2>
                    <p class="home-news__summary">{article.summary}</p>
                  </div>
                </article>
              ))}
            </div>

            <div class="home-news__footer">
              <a href="/news/" class="ui-link home-news__all-link">
                Все новости <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .home-main {
    padding-block-end: 0.5rem;
  }

  .home-hero {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface-muted);
  }

  .home-hero__media {
    width: 100%;
    height: clamp(20rem, 37vw, 36rem);
    overflow: hidden;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
  }

  .home-news {
    padding-block: 2rem 1rem;
  }

  .home-news__inner {
    padding-inline: 1.25rem;
  }

  .home-news__title {
    padding-block-end: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .home-news__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .home-news__date {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .home-news__copy {
    max-width: 48rem;
  }

  .home-news__copy > :global(:not(:last-child)) {
    margin-block-end: 0.75rem;
  }

  .home-news__item-title {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .home-news__summary {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .home-news__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: 1rem 1.25rem;
  }

  .home-news__all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    text-decoration-line: none !important;
  }

  @media (min-width: 48rem) {
    .home-main {
      padding-block-end: 0.75rem;
    }

    .home-hero__image {
      object-position: center;
    }

    .home-news {
      padding-block: 3rem 1.5rem;
    }

    .home-news__inner {
      padding-inline: 1.5rem;
    }

    .home-news__item {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 2rem;
      padding-block: 1.75rem;
    }

    .home-news__date {
      flex-direction: column;
      gap: 0.25rem;
      padding-block-start: 0.25rem;
      font-size: 1rem;
      text-align: center;
    }

    .home-news__summary {
      font-size: 1rem;
      line-height: 1.75rem;
    }

    .home-news__footer {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 2rem;
      padding-block-end: 1.5rem;
    }

    .home-news__all-link {
      grid-column-start: 2;
    }
  }

  @media (min-width: 64rem) {
    .home-main {
      padding-block-end: 1rem;
    }

    .home-news {
      padding-block: 3.5rem 2rem;
    }
  }
</style>

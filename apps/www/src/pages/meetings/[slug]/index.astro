---
import type { GetStaticPaths } from 'astro';

import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import LinkWithIcon from '@shelkovo/ui/LinkWithIcon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { loadMeeting, loadMeetings } from '@/lib/meetings/load';
import {
  describeMeeting,
  formatMeetingDate,
  formatMeetingMetaDate,
  formatMeetingSourceLabel,
  formatMeetingSpeakerAnchor,
  formatTranscriptPartLabel,
  formatTranscriptTime,
} from '@/lib/meetings/view';
import { techArticleSchema } from '@/lib/news/seo';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const meetings = await loadMeetings();

  return meetings.map((meeting) => ({
    params: {
      slug: meeting.slug,
    },
  }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;

if (!slug) {
  throw new Error('meeting slug is required');
}

const meeting = await loadMeeting(slug);

if (!meeting) {
  throw new Error(`meeting "${slug}" not found`);
}

const title = `${meeting.title} — Архив встреч — Шелково Онлайн`;
const description = describeMeeting(meeting);
const search = {
  scope: 'page',
  title: meeting.title,
  description,
  section: SEARCH_SECTIONS.meetings,
  publishedAt: meeting.date.iso.slice(0, 10),
} satisfies SearchDocument;
const hasTranscriptParts = meeting.transcript.parts.length > 1;
const sourceLinks = meeting.sourceUrls.map((href, index) => ({
  href,
  label: formatMeetingSourceLabel(meeting.sourceUrls.length, index),
}));
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Архив встреч' },
  { label: meeting.title },
]);
const schema = techArticleSchema({
  name: meeting.title,
  description,
  url: meeting.url,
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: meeting.title, url: meeting.url },
  ]),
  datePublished: meeting.date.iso,
  dateModified: meeting.updatedAt?.iso,
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={meeting.canonical}
  type="article"
  schema={schema}
  search={search}
>
  <main class="ui-page meeting-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack meeting-header">
        <Breadcrumbs items={breadcrumbs} />

        <div class="meeting-summary">
          <div class="meeting-heading">
            <h1 class="ui-page-title">
              {meeting.title}
            </h1>

            <div class="meeting-meta">
              <time
                datetime={formatMeetingMetaDate(meeting.date)}
                class="meeting-meta__date"
              >
                {formatMeetingDate(meeting.date)}
              </time>

              {
                sourceLinks.map((source) => (
                  <span data-pagefind-ignore="all">
                    <LinkWithIcon
                      href={source.href}
                      label={source.label}
                      ariaLabelPrefix={source.label}
                    />
                  </span>
                ))
              }
            </div>
          </div>

          <p class="meeting-context">
            {meeting.context}
          </p>
        </div>
      </div>
    </header>

    <div class="meeting-content">
      <div class="meeting-content__inner">
        <section class="meeting-section" aria-labelledby="meeting-speakers">
          <h2 id="meeting-speakers" class="ui-section-title">Участники</h2>

          <ul class="meeting-speakers">
            {
              meeting.transcript.speakers.map((speaker) => (
                <li
                  id={formatMeetingSpeakerAnchor(speaker)}
                  class="meeting-speaker"
                >
                  <span class="meeting-speaker__name">
                    {speaker.url ? (
                      <a href={speaker.url} class="ui-link">
                        {speaker.label}
                      </a>
                    ) : (
                      <span>{speaker.label}</span>
                    )}
                  </span>

                  {speaker.description && (
                    <span class="meeting-speaker__description">
                      {' '}
                      — {speaker.description}
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        <section class="meeting-section" aria-labelledby="meeting-transcript">
          <h2 id="meeting-transcript" class="ui-section-title">Транскрипция</h2>

          <ol class="meeting-transcript">
            {
              meeting.transcript.parts.map((part) => (
                <>
                  {hasTranscriptParts && (
                    <li class="meeting-transcript-part">
                      <h3 class="ui-card-title">
                        {formatTranscriptPartLabel(part)}
                      </h3>
                    </li>
                  )}

                  {part.segments.map((segment) => {
                    const timestamp = formatTranscriptTime(segment.start);

                    return (
                      <li class="meeting-transcript-segment">
                        <h3
                          id={segment.anchor}
                          class="meeting-transcript-anchor ui-visually-hidden"
                          aria-hidden="true"
                          data-pagefind-weight="0"
                        >
                          {segment.speaker.label} в {timestamp}
                        </h3>

                        <div
                          class="meeting-transcript-meta"
                          data-pagefind-ignore="all"
                        >
                          <a
                            href={`#${segment.anchor}`}
                            aria-label={`Ссылка на фрагмент ${timestamp}`}
                            class="ui-link ui-num meeting-transcript-time"
                          >
                            {timestamp}
                          </a>

                          <a
                            href={`#${formatMeetingSpeakerAnchor(segment.speaker)}`}
                            class="ui-link meeting-transcript-speaker"
                          >
                            {segment.speaker.label}
                          </a>
                        </div>

                        <div
                          class="meeting-transcript-text"
                          set:html={segment.textHtml}
                        />
                      </li>
                    );
                  })}
                </>
              ))
            }
          </ol>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .meeting-page {
    padding-block-end: 2rem;
  }

  .meeting-header {
    max-width: 56rem;
  }

  .meeting-summary > :global(:not(:last-child)) {
    margin-block-end: 1rem;
  }

  .meeting-heading > :global(:not(:last-child)) {
    margin-block-end: 0.75rem;
  }

  .meeting-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .meeting-meta__date {
    color: var(--color-text);
    font-weight: 600;
  }

  .meeting-context {
    max-width: 48rem;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .meeting-content {
    padding-inline: 1.25rem;
  }

  .meeting-content__inner {
    max-width: 75ch;
  }

  .meeting-content__inner > :global(:not(:last-child)) {
    margin-block-end: 1.75rem;
  }

  .meeting-section > :global(:not(:last-child)) {
    margin-block-end: 0.75rem;
  }

  .meeting-speakers {
    padding-inline-start: 1.25rem;
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.5rem;
    list-style-type: disc;
  }

  .meeting-speaker {
    padding-inline-start: 0.125rem;
    scroll-margin-block-start: 6rem;
  }

  .meeting-speaker + .meeting-speaker {
    margin-block-start: 0.375rem;
  }

  .meeting-speaker::marker {
    color: var(--color-text-muted);
  }

  .meeting-speaker__name {
    color: var(--color-text);
    font-weight: 600;
  }

  .meeting-speaker__description {
    color: var(--color-text-muted);
  }

  .meeting-transcript {
    border-block-start: 1px solid var(--color-border);
  }

  .meeting-transcript > :global(:not(:last-child)) {
    border-block-end: 1px solid var(--color-border);
  }

  .meeting-transcript-part {
    padding-block: 2.5rem 1rem;
  }

  .meeting-transcript-segment {
    --meeting-transcript-hover-bg: color-mix(
      in oklab,
      var(--color-primary-soft) 58%,
      transparent
    );
    --meeting-transcript-target-bg: color-mix(
      in oklab,
      var(--color-primary-soft) 78%,
      transparent
    );

    position: relative;
    margin-inline: -0.75rem;
    padding: 0.625rem 0.75rem;
    transition: background-color 180ms ease-out;
  }

  .meeting-transcript-anchor {
    scroll-margin-block-start: 6rem;
  }

  .meeting-transcript-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    row-gap: 0.125rem;
  }

  .meeting-transcript-time {
    display: inline-block;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .meeting-transcript-speaker {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25rem;
  }

  .meeting-transcript-text {
    min-width: 0;
    margin-block-start: 0.25rem;
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.5rem;
  }

  .meeting-transcript-segment::before {
    position: absolute;
    inset-block: 0.625rem;
    inset-inline-start: 0;
    width: 0.1875rem;
    background: transparent;
    content: '';
    transition: background-color 180ms ease-out;
  }

  .meeting-transcript-segment:focus-within {
    background: var(--meeting-transcript-hover-bg);
  }

  @media (hover: hover) {
    .meeting-transcript-segment:hover {
      background: var(--meeting-transcript-hover-bg);
    }
  }

  .meeting-transcript-segment:has(> .meeting-transcript-anchor:target) {
    background: var(--meeting-transcript-target-bg);
  }

  .meeting-transcript-segment:has(> .meeting-transcript-anchor:target)::before {
    background: var(--color-primary);
  }

  .meeting-transcript-segment:has(> .meeting-transcript-anchor:target)
    a[href^='#t-'] {
    color: var(--color-primary);
  }

  @media (min-width: 48rem) {
    .meeting-page {
      padding-block-end: 3rem;
    }

    .meeting-content {
      padding-inline: 1.5rem;
    }

    .meeting-content__inner > :global(:not(:last-child)) {
      margin-block-end: 2rem;
    }

    .meeting-speakers {
      font-size: 1rem;
    }

    .meeting-transcript-part {
      padding-block: 3rem 1.25rem;
    }

    .meeting-transcript-segment {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: 1rem;
      padding-block: 0.75rem;
    }

    .meeting-transcript-meta {
      display: block;
      padding-block-start: 0.125rem;
    }

    .meeting-transcript-meta > :global(:not(:last-child)) {
      margin-block-end: 0.125rem;
    }

    .meeting-transcript-time,
    .meeting-transcript-speaker {
      display: block;
    }

    .meeting-transcript-speaker {
      font-size: 0.875rem;
    }

    .meeting-transcript-text {
      margin-block-start: 0;
      font-size: 1rem;
      line-height: 1.75rem;
    }
  }

  @media (min-width: 64rem) {
    .meeting-page {
      padding-block-end: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meeting-transcript-segment,
    .meeting-transcript-segment::before {
      transition: none;
    }
  }
</style>

<style is:global>
  .meeting-transcript-text > * + * {
    margin-block-start: 0.625rem;
  }

  .meeting-transcript-text p {
    white-space: pre-line;
  }

  .meeting-transcript-text a {
    color: var(--color-primary);
    transition: color 0.2s ease;
  }

  .meeting-transcript-text a:hover {
    color: var(--color-primary-hover);
  }

  .meeting-transcript-text ol,
  .meeting-transcript-text ul {
    list-style: none;
    padding-inline-start: 0;
  }

  .meeting-transcript-text li {
    position: relative;
    padding-inline-start: 1.25rem;
  }

  .meeting-transcript-text li + li {
    margin-block-start: 0.25rem;
  }

  .meeting-transcript-text ul > li::before {
    position: absolute;
    inset-inline-start: 0.1rem;
    color: var(--color-primary);
    content: '•';
  }

  .meeting-transcript-text ol {
    counter-reset: transcript-list;
  }

  .meeting-transcript-text ol > li {
    counter-increment: transcript-list;
  }

  .meeting-transcript-text ol > li::before {
    position: absolute;
    inset-inline-start: 0;
    color: var(--color-text-muted);
    content: counter(transcript-list) '.';
  }
</style>

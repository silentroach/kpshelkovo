---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import { formatText } from '@shelkovo/typography';

import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbListSchema } from '@/lib/json-ld';
import { renderMarkdown } from '@/lib/markdown/render';
import { loadSiteMentionRegistry } from '@/lib/mentions/registry';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';
import {
  tariffBreadcrumbs,
  tariffSchemaBreadcrumbs,
} from '@/lib/tariff-tldr/breadcrumbs';
import {
  TARIFF_TLDR,
  TARIFF_TLDR_DESCRIPTION,
} from '@/lib/tariff-tldr/content';
import { tariffTldrPath, tariffTldrUrl } from '@/lib/tariff-tldr/routes';

const title = `${TARIFF_TLDR.title} — Шелково Онлайн`;
const search = {
  scope: 'page',
  title: TARIFF_TLDR.title,
  description: TARIFF_TLDR_DESCRIPTION,
  section: SEARCH_SECTIONS.tariff,
} satisfies SearchDocument;
const bodyHtml = renderMarkdown(TARIFF_TLDR.bodyMarkdown, {
  mentions: {
    context: tariffTldrPath(),
    registry: await loadSiteMentionRegistry(),
  },
});
const breadcrumbs = tariffBreadcrumbs();
const schema = breadcrumbListSchema(tariffSchemaBreadcrumbs(breadcrumbs));
---

<BaseLayout
  title={title}
  description={TARIFF_TLDR_DESCRIPTION}
  canonical={tariffTldrUrl()}
  schema={schema}
  search={search}
>
  <main class="ui-page tariff-tldr-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="ui-page-title">{formatText(TARIFF_TLDR.title)}</h1>
      </div>
    </header>

    <article class="tariff-tldr-body">
      <div class="ui-prose tariff-tldr-prose" set:html={bodyHtml} />
    </article>
  </main>
</BaseLayout>

<style>
  .tariff-tldr-page {
    padding-block-end: 2rem;
  }

  .tariff-tldr-body {
    padding-inline: 1.25rem;
  }

  .tariff-tldr-prose :global(> .ui-callout--note) {
    border-color: color-mix(
      in oklab,
      var(--color-warning-text) 10%,
      var(--color-bg)
    );
    background: color-mix(
      in oklab,
      var(--color-warning-soft) 55%,
      var(--color-bg)
    );
  }

  .tariff-tldr-prose :global(.ui-callout__title) {
    margin-block-end: 0;
    line-height: 1.5;
  }

  .tariff-tldr-prose :global(.ui-callout__title + p) {
    margin-block-start: 0.375rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .tariff-tldr-prose :global(> blockquote) {
    margin-inline: 0;
    padding: 0;
    border: 0;
  }

  @media (min-width: 48rem) {
    .tariff-tldr-page {
      padding-block-end: 3rem;
    }

    .tariff-tldr-body {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .tariff-tldr-page {
      padding-block-end: 3.5rem;
    }
  }
</style>

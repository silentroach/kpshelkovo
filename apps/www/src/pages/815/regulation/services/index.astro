---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import ResourceLink from '@shelkovo/ui/ResourceLink.astro';

import { fullReglamentDataset2026 } from '@/data/reglament/full-2026';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type {
  FullReglamentService,
  FullReglamentServiceToEstimateMapItem,
} from '@/lib/reglament/full-schema';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import {
  reglamentFullSourcePdfUrl,
  reglamentServicesUrl,
  reglamentUrl,
} from '@/lib/reglament/routes';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

type ServiceGroup = FullReglamentService['group'];
type MappingStatus = FullReglamentServiceToEstimateMapItem['status'];

const title = 'Услуги регламента — Регламент — Шелково Онлайн';
const description =
  'Перечень услуг из полного регламента Шелково: периодичность работ и сверка со строками текущей сметы 2026.';
const search = {
  scope: 'manual',
  title: 'Какие услуги указаны в регламенте',
  description,
  section: SEARCH_SECTIONS.regulation,
} satisfies SearchDocument;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Регламент', href: reglamentUrl() },
  { label: 'Услуги' },
]);
const groupLabels = {
  year_round: 'Круглогодично',
  winter_period: 'В зимний период',
  summer_period: 'В летний период',
} as const satisfies Record<ServiceGroup, string>;
const groupOrder = [
  'year_round',
  'winter_period',
  'summer_period',
] as const satisfies readonly ServiceGroup[];
const statusLabels = {
  explicit_found: 'явно найдено',
  partial: 'частично сопоставлено',
  not_found: 'не найдено в явной строке сметы',
  needs_check: 'требует проверки',
} as const satisfies Record<MappingStatus, string>;
const statusClasses = {
  explicit_found: 'ui-badge-success',
  partial: 'ui-badge-info',
  not_found: 'ui-badge-warning',
  needs_check: 'ui-badge-danger',
} as const satisfies Record<MappingStatus, string>;
const mappingByService = new Map(
  fullReglamentDataset2026.service_to_estimate_map.map((item) => [
    item.service_id,
    item,
  ]),
);
const groups = groupOrder.map((group) => ({
  group,
  title: groupLabels[group],
  services: fullReglamentDataset2026.services.filter(
    (service) => service.group === group,
  ),
}));
const schema = collectionPageSchema({
  name: title,
  description,
  url: reglamentServicesUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Регламент', url: reglamentUrl() },
    { name: 'Услуги', url: reglamentServicesUrl() },
  ]),
  items: groups.map((group) => ({
    name: group.title,
    url: `${reglamentServicesUrl()}#${group.group}`,
  })),
});

const estimateSourceLabel = (
  mapping: FullReglamentServiceToEstimateMapItem,
): string =>
  mapping.estimate_source_refs.length > 0
    ? `Смета: ${mapping.estimate_source_refs
        .map((ref) => ref.fragment.replace(/^Сводная смета\s*\/\s*/u, ''))
        .join(', ')}`
    : 'Явная строка сметы не найдена';
const mappingVerificationNote = (
  mapping: FullReglamentServiceToEstimateMapItem,
): string | null =>
  mapping.verification_note === statusLabels[mapping.status]
    ? null
    : mapping.verification_note;
const serviceSearchText = (
  service: FullReglamentService,
  group: string,
  mapping?: FullReglamentServiceToEstimateMapItem,
): string => {
  const verificationNote = mapping
    ? mappingVerificationNote(mapping)
    : undefined;

  return [
    `Период выполнения: ${group}.`,
    `Периодичность: ${service.frequency_raw}.`,
    service.frequency_note,
    mapping
      ? `Статус сопоставления: ${statusLabels[mapping.status]}.`
      : undefined,
    mapping ? `${estimateSourceLabel(mapping)}.` : undefined,
    mapping?.explanation,
    verificationNote,
  ]
    .filter((part): part is string => Boolean(part))
    .join(' ');
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={reglamentServicesUrl()}
  keywords={[
    'услуги регламента Шелково',
    'смета 2026 услуги Шелково',
    'Шелково полный регламент услуги',
  ]}
  schema={schema}
  search={search}
>
  <main class="ui-page services-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack services-header">
        <Breadcrumbs items={breadcrumbs} />

        <div class="services-intro" data-pagefind-body>
          <h1 class="ui-page-title services-title">
            Какие услуги указаны в регламенте
          </h1>
          <div class="services-intro-copy">
            <p>
              Перечень взят из Приложения №4 полного регламента, стр. 135. Ниже
              показана сверка со строками текущей сметы. Частичное совпадение
              или отсутствие явной строки не является юридическим выводом.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="services-content" aria-labelledby="services-title">
      <div class="services-groups">
        <h2 id="services-title" class="ui-visually-hidden">
          Таблицы услуг регламента
        </h2>

        {
          groups.map((group) => (
            <section class="services-group" aria-labelledby={group.group}>
              <div class="services-group-header" data-pagefind-body>
                <h3
                  id={group.group}
                  class="ui-section-title"
                  data-pagefind-weight="1.5"
                >
                  {group.title}
                </h3>
                <p class="services-source" data-pagefind-weight="0.3">
                  Источник:{' '}
                  <ResourceLink
                    class="ui-link"
                    href={reglamentFullSourcePdfUrl()}
                    type="application/pdf"
                    reload
                  >
                    полный регламент
                  </ResourceLink>
                  , Приложение №4, стр. 135. Услуги и периодичность перенесены
                  из полного регламента; годовые кратности сметы здесь не
                  пересчитываются автоматически.
                </p>
              </div>

              <div
                class="reglament-table-shell ui-sticky-table-shell services-table-shell"
                data-ui-sticky-table-shell
              >
                <table class="services-table">
                  <caption class="ui-visually-hidden">{group.title}</caption>
                  <thead class="services-table-head">
                    <tr>
                      <th class="services-table-heading services-table-service-heading">
                        Услуга
                      </th>
                      <th class="services-table-heading services-table-frequency-heading">
                        Периодичность
                      </th>
                      <th class="services-table-heading services-table-status-heading">
                        Статус
                      </th>
                      <th class="services-table-heading services-table-mapping-heading">
                        Сопоставление
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.services.map((service) => {
                      const mapping = mappingByService.get(service.id);
                      const verificationNote = mapping
                        ? mappingVerificationNote(mapping)
                        : null;

                      return (
                        <tr>
                          <td class="services-table-cell">
                            <div class="services-item" data-pagefind-body>
                              <h4
                                id={`reglament-service-${service.id}`}
                                class="services-item-title"
                                data-pagefind-weight="2"
                              >
                                {service.title}
                              </h4>
                              <p class="ui-visually-hidden" aria-hidden="true">
                                {serviceSearchText(
                                  service,
                                  group.title,
                                  mapping,
                                )}
                              </p>
                            </div>
                          </td>
                          <td class="services-table-cell services-table-muted">
                            <span class="services-frequency">
                              {service.frequency_raw}
                            </span>
                            {service.frequency_note && (
                              <span class="services-frequency-note">
                                {service.frequency_note}
                              </span>
                            )}
                          </td>
                          <td class="services-table-cell">
                            {mapping && (
                              <span
                                class:list={[
                                  'ui-badge',
                                  statusClasses[mapping.status],
                                ]}
                              >
                                {statusLabels[mapping.status]}
                              </span>
                            )}
                          </td>
                          <td class="services-table-cell services-table-muted">
                            {mapping && (
                              <div class="services-mapping">
                                <p>
                                  <span class="services-estimate-source">
                                    {estimateSourceLabel(mapping)}
                                  </span>
                                </p>
                                <p class="services-mapping-note">
                                  {mapping.explanation}
                                </p>
                                {verificationNote && (
                                  <p class="services-verification-note">
                                    {verificationNote}
                                  </p>
                                )}
                              </div>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>

  <style>
    .services-page {
      padding-block-end: 2rem;
    }

    .services-header {
      max-width: 64rem;
    }

    .services-intro > * + * {
      margin-block-start: 1rem;
    }

    .services-title {
      max-width: 56rem;
    }

    .services-intro-copy,
    .services-group-header {
      max-width: 48rem;
    }

    .services-intro-copy {
      color: var(--color-text-muted);
      font-size: 0.875rem;
      line-height: 1.5rem;
    }

    .services-intro-copy > * + * {
      margin-block-start: 0.75rem;
    }

    .services-content {
      padding-inline: 1.25rem;
    }

    .services-groups {
      max-width: 72rem;
    }

    .services-groups > section + section {
      margin-block-start: 2.5rem;
    }

    .services-group > * + * {
      margin-block-start: 1rem;
    }

    .services-group-header > * + * {
      margin-block-start: 0.375rem;
    }

    .services-source {
      color: var(--color-text-muted);
      font-size: 0.875rem;
      line-height: 1.5rem;
    }

    .services-verification-note {
      color: var(--color-primary);
    }

    .services-table-shell {
      margin-inline: -1.25rem;
      border-block: 1px solid var(--color-border);
      background-color: var(--color-surface);
    }

    .services-table {
      width: 100%;
      min-width: 58rem;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 0.875rem;
      line-height: 1.25rem;
      text-align: left;
    }

    .services-table-head {
      color: var(--color-text-muted);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      line-height: 1rem;
      text-transform: uppercase;
    }

    .services-table-heading {
      position: sticky;
      top: var(--ui-sticky-table-header-top);
      z-index: 10;
      padding: 0.625rem 1rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface-muted);
      vertical-align: bottom;
    }

    .services-table-service-heading {
      width: 34%;
    }

    .services-table-frequency-heading {
      width: 16%;
    }

    .services-table-status-heading {
      width: 18%;
    }

    .services-table-mapping-heading {
      width: 32%;
    }

    .services-table-cell {
      padding: 0.75rem 1rem;
      border-top: 1px solid var(--color-border);
      vertical-align: top;
    }

    .services-item > * + *,
    .services-mapping > * + * {
      margin-block-start: 0.375rem;
    }

    .services-item-title,
    .services-frequency,
    .services-estimate-source {
      color: var(--color-text);
      font-weight: 600;
    }

    .services-table-muted {
      color: var(--color-text-muted);
    }

    .services-frequency-note {
      display: block;
      margin-block-start: 0.25rem;
      font-size: 0.75rem;
      line-height: 1.25rem;
    }

    .services-mapping-note,
    .services-verification-note {
      font-size: 0.75rem;
      line-height: 1.25rem;
    }

    .services-verification-note {
      font-weight: 600;
    }

    @media (min-width: 40rem) {
      .services-table-shell {
        margin-inline: 0;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
      }

      .services-table-service-heading {
        border-top-left-radius: var(--radius-xl);
      }

      .services-table-mapping-heading {
        border-top-right-radius: var(--radius-xl);
      }
    }

    @media (min-width: 48rem) {
      .services-page {
        padding-block-end: 3rem;
      }

      .services-intro-copy {
        font-size: 0.9375rem;
      }

      .services-content {
        padding-inline: 1.5rem;
      }

      .services-source {
        font-size: 1rem;
        line-height: 1.75rem;
      }
    }

    @media (min-width: 64rem) {
      .services-page {
        padding-block-end: 4rem;
      }
    }
  </style>

  <script>
    import { hydrateStickyTableHeaders } from '@/lib/sticky-table-headers';

    const hydrate = () => hydrateStickyTableHeaders();

    hydrate();
    document.addEventListener('astro:after-swap', hydrate);
    document.addEventListener('astro:page-load', hydrate);
  </script>
</BaseLayout>

      width: 1rem;
      cursor: help;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border-strong);
      background: var(--color-surface);
      color: var(--color-text-muted);
      font-size: 0.6875rem;
      font-weight: 600;
      line-height: 1;
    }

    .reglament-missing-help-button:focus-visible {
      outline: 2px solid
        color-mix(in oklch, var(--color-primary), transparent 70%);
      outline-offset: 2px;
    }

    .reglament-missing-tooltip {
      position: absolute;
      left: 0;
      top: calc(100% + 0.35rem);
      z-index: 30;
      width: min(18rem, calc(100vw - 2rem));
      border-radius: 0.625rem;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      box-shadow: 0 0.75rem 1.6rem oklch(27% 0.05 142 / 0.12);
      color: var(--color-text);
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.45;
      opacity: 0;
      padding: 0.625rem 0.75rem;
      pointer-events: none;
      transform: translateY(-0.2rem);
      transition:
        opacity 120ms ease,
        transform 120ms ease,
        visibility 120ms ease;
      visibility: hidden;
    }

    .reglament-missing-help:hover .reglament-missing-tooltip,
    .reglament-missing-help:focus-within .reglament-missing-tooltip {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }

    [data-reglament-delta-tone='negative'] {
      color: var(--color-success);
    }

    [data-reglament-delta-tone='positive'] {
      color: var(--color-danger);
    }

    [data-reglament-delta-tone='zero'] {
      color: var(--color-text-muted);
    }

    @media (min-width: 40rem) {
      .reglament-reset__long {
        display: inline;
      }

      .reglament-reset__short {
        display: none;
      }

      .reglament-table-shell {
        margin-inline: 0;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
      }

      .reglament-table__header--work {
        border-start-start-radius: var(--radius-xl);
      }

      .reglament-table__header--contribution {
        border-start-end-radius: var(--radius-xl);
      }

      .reglament-details {
        max-width: calc(100vw - 6.375rem);
      }

      .reglament-details__summary,
      .reglament-breakdown,
      .reglament-expert-fields__list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 48rem) {
      .reglament-page {
        padding-block-end: 3rem;
      }

      .reglament-lead {
        font-size: 0.9375rem;
      }

      .reglament-totals {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .reglament-total {
        padding: 1.25rem;
      }

      .reglament-total--divided {
        border-inline-end: 1px solid var(--color-border);
        border-block-end: 0;
      }

      .reglament-sticky-total,
      .reglament-sections {
        padding-inline: 1.5rem;
      }

      .reglament-sticky-total__inner,
      .reglament-reset {
        font-size: 0.875rem;
        line-height: 1.25rem;
      }

      .reglament-reset {
        padding-inline: 0.75rem;
      }

      .reglament-sticky-total-original {
        font-size: 0.875rem;
      }

      .reglament-sticky-total-arrow,
      .reglament-sticky-total__current {
        font-size: 1rem;
        line-height: 1.5rem;
      }

      .reglament-sticky-total__current {
        font-size: 1.125rem;
        line-height: 1.75rem;
      }

      .reglament-sections__description {
        font-size: 1rem;
        line-height: 1.75rem;
      }

      .reglament-section-header {
        margin-block-end: 1.25rem;
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
      }

      .reglament-section-total {
        text-align: end;
      }

      .reglament-details__content {
        padding-inline-start: 1rem;
      }
    }

    @media (min-width: 64rem) {
      .reglament-page {
        padding-block-end: 4rem;
      }

      .reglament-table__header {
        top: calc(var(--ui-sticky-table-header-top) + 2.875rem - 1px);
      }

      .reglament-details {
        max-width: none;
      }
    }
  </style>

  <script>
    import { bindReglamentCalculatorLazyHydration } from '@/lib/reglament/calculator-loader';
    import { hydrateStickyTableHeaders } from '@/lib/sticky-table-headers';

    const hydrateCalculator = bindReglamentCalculatorLazyHydration();
    const hydrate = () => {
      hydrateCalculator();
      hydrateStickyTableHeaders();
    };

    hydrate();
    document.addEventListener('astro:after-swap', hydrate);
    document.addEventListener('astro:page-load', hydrate);
  </script>
</BaseLayout>

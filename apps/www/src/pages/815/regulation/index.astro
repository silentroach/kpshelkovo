---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import ResourceLink from '@shelkovo/ui/ResourceLink.astro';

import { estimate2026 } from '@/data/reglament/estimate-2026';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import { projectEstimateCalculationInput } from '@/lib/reglament/calculation-projection';
import type { ReglamentEditorConfig } from '@/lib/reglament/calculator-editor.types';
import { buildReglamentPayload } from '@/lib/reglament/discovery';
import {
  formatReglamentAnnualMoney,
  formatReglamentInputNumber,
  formatReglamentMoneyDelta,
  formatReglamentNumber,
  formatReglamentTariff,
  formatReglamentTariffValue,
} from '@/lib/reglament/format';
import {
  reglamentAssetsUrl,
  reglamentServicesUrl,
  reglamentUrl,
} from '@/lib/reglament/routes';
import { reglamentSectionsByOfficialTariff } from '@/lib/reglament/section-order';
import type { CostBreakdown, EditableFieldKey } from '@/lib/reglament/schema';
import { formatEstimateSourceRefLabel } from '@/lib/reglament/source-labels';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const prerender = true;

const payload = buildReglamentPayload(estimate2026);
const calculationInputJson = JSON.stringify(
  projectEstimateCalculationInput(estimate2026),
).replaceAll('<', '\\u003c');
const htmlSections = reglamentSectionsByOfficialTariff(payload.sections);
const title = 'Смета 2026: калькулятор тарифа — Шелково Онлайн';
const description =
  'Интерактивная смета регламента 2026: тариф за сотку в месяц, строки расходов, источники из PDF и быстрый пересчет итогов.';
const search = {
  scope: 'manual',
  title: 'Тариф 815: калькулятор по смете 2026',
  description,
  section: SEARCH_SECTIONS.regulation,
  aliases: ['815 рублей за сотку'],
} satisfies SearchDocument;
const keywords = [
  'смета 2026 Шелково',
  'калькулятор тарифа Шелково',
  'регламент Шелково',
  'тариф 815 Шелково',
  'КП Шелково тариф',
  'ОК Комфорт Шелково тариф',
  'регламент Шелково 2026',
  'публичный договор ОК Шелково',
  'спор по тарифу Шелково',
];
const breadcrumbs = withHomeBreadcrumbs([{ label: 'Регламент' }]);
const schema = collectionPageSchema({
  name: title,
  description,
  url: reglamentUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Регламент', url: reglamentUrl() },
  ]),
  items: htmlSections.map((section) => ({
    name: section.title,
    url: `${reglamentUrl()}#${section.id}`,
  })),
});

type ReglamentPayload = ReturnType<typeof buildReglamentPayload>;
type PayloadRow = ReglamentPayload['sections'][number]['rows'][number];
type DisplayValue =
  ReglamentPayload['sections'][number]['rows'][number]['baseline']['base'];
type BasicDisplayFieldKey = 'base' | 'frequency' | 'price';
type BasicNumberFieldKey = Extract<
  EditableFieldKey,
  'volume' | 'frequency' | 'rate'
>;
type ExpertNumberFieldKey = Exclude<
  EditableFieldKey,
  'enabled' | BasicNumberFieldKey
>;
type BreakdownFieldKey = keyof CostBreakdown;

interface NumberControl<Key extends EditableFieldKey = BasicNumberFieldKey> {
  readonly key: Key;
  readonly label: string;
  readonly value: number;
  readonly unit?: string;
}

interface MissingFieldHint {
  readonly label: string;
  readonly reason: string;
  readonly detail?: string;
  readonly tooltipId: string;
}

const formatDisplayValue = (value: NonNullable<DisplayValue>): string =>
  `${formatReglamentNumber(value.value)} ${value.unit}${value.label ? `, ${value.label}` : ''}`;
const estimateRowSearchText = (row: PayloadRow): string =>
  [
    row.description,
    row.baseline.base
      ? `База по исходной смете: ${formatDisplayValue(row.baseline.base)}.`
      : undefined,
    row.baseline.frequency
      ? `Периодичность по исходной смете: ${formatDisplayValue(row.baseline.frequency)}.`
      : undefined,
    row.baseline.price
      ? `Ставка по исходной смете: ${formatDisplayValue(row.baseline.price)}.`
      : undefined,
    `Вклад в тариф по исходной смете: ${formatReglamentTariffValue(row.baseline.tariff_per_sotka_month)}.`,
    `Сумма за год по исходной смете: ${formatReglamentAnnualMoney(row.baseline.annual_gross)}.`,
  ]
    .filter((part): part is string => Boolean(part))
    .join(' ');
const estimateRowSearchSources = (row: PayloadRow): string =>
  `Источники: ${row.source_refs.map(formatEstimateSourceRefLabel).join('; ')}.`;
const missingFieldHint = (
  row: PayloadRow,
  key: BasicDisplayFieldKey,
): MissingFieldHint => {
  const tooltipId = `reglament-missing-${key}-${row.id}`;

  if (key === 'price') {
    return {
      label: 'нет ставки',
      reason:
        'В исходной смете нет отдельной цены за единицу. Позиция хранится как официальная годовая сумма; менять ее можно в деталях через состав расчета.',
      detail: formatReglamentAnnualMoney(row.baseline.annual_gross),
      tooltipId,
    };
  }

  if (key === 'frequency') {
    return {
      label: 'нет кратности',
      reason:
        'В исходной смете нет одной периодичности для всей строки. Строка считается по годовому расчету или составу работ.',
      tooltipId,
    };
  }

  return {
    label: 'нет единой базы',
    reason:
      'В исходной смете эта позиция собрана из нескольких работ или объектов, поэтому нет одного объема, который можно безопасно менять как множитель.',
    tooltipId,
  };
};
const breakdownFields = [
  { key: 'primary_salary', label: 'Основная зарплата' },
  { key: 'machinist_salary', label: 'Зарплата машинистов' },
  { key: 'fot', label: 'ФОТ' },
  { key: 'machines', label: 'Машины и механизмы' },
  { key: 'materials', label: 'Материалы' },
  { key: 'contractors', label: 'Услуги подрядчиков' },
  { key: 'insurance', label: 'Страховые взносы' },
  { key: 'overhead', label: 'Общеэксплуатационные расходы' },
  { key: 'profit', label: 'Прибыль' },
  { key: 'usn', label: 'УСН' },
  { key: 'income', label: 'Доходы всего' },
  { key: 'vat', label: 'НДС' },
  { key: 'gross', label: 'Итого с НДС' },
] as const satisfies readonly {
  readonly key: BreakdownFieldKey;
  readonly label: string;
}[];
const inlineBreakdownFieldKeys = [
  'primary_salary',
  'machinist_salary',
  'machines',
  'materials',
  'contractors',
] as const satisfies readonly ExpertNumberFieldKey[];
const inlineBreakdownFieldKeySet: ReadonlySet<EditableFieldKey> = new Set(
  inlineBreakdownFieldKeys,
);
const expertFieldKeys = [
  'fixed_price',
  'primary_salary',
  'machinist_salary',
  'machines',
  'materials',
  'contractors',
  'insurance_rate',
  'overhead_rate',
  'profit_rate',
  'usn_rate',
  'vat_rate',
] as const satisfies readonly ExpertNumberFieldKey[];
const expertFieldKeySet: ReadonlySet<EditableFieldKey> = new Set(
  expertFieldKeys,
);
const isExpertNumberFieldKey = (
  value: EditableFieldKey,
): value is ExpertNumberFieldKey => expertFieldKeySet.has(value);
const isInlineBreakdownControl = (
  control: NumberControl<ExpertNumberFieldKey>,
): boolean => inlineBreakdownFieldKeySet.has(control.key);
const fieldValue = (
  row: PayloadRow,
  key: BasicNumberFieldKey,
): number | undefined => {
  if (key === 'volume') {
    return row.baseline.base?.value;
  }

  if (key === 'frequency') {
    return row.baseline.frequency?.value;
  }

  if (key === 'rate') {
    return row.baseline.price?.value;
  }

  return undefined;
};
const fieldUnit = (
  row: PayloadRow,
  key: BasicNumberFieldKey,
  fieldUnitValue?: string,
): string | undefined => {
  if (key === 'volume') {
    return row.baseline.base?.unit;
  }

  if (key === 'frequency') {
    return row.baseline.frequency?.unit;
  }

  if (key === 'rate') {
    return row.baseline.price?.unit;
  }

  return fieldUnitValue;
};
const numberControl = (
  row: PayloadRow,
  key: BasicNumberFieldKey,
): NumberControl<BasicNumberFieldKey> | undefined => {
  const field = row.editable_fields.find(
    (item) => item.key === key && item.level === 'basic',
  );
  const value = fieldValue(row, key);

  if (!field || value === undefined) {
    return undefined;
  }

  return {
    key,
    label: field.label,
    value,
    unit: fieldUnit(row, key, field.unit),
  };
};
const expertFieldValue = (
  row: PayloadRow,
  key: ExpertNumberFieldKey,
): number => {
  if (key === 'fixed_price') {
    return row.baseline.annual_gross;
  }

  if (key === 'insurance_rate') {
    return payload.coefficients.insurance_rate;
  }

  if (key === 'overhead_rate') {
    return payload.coefficients.overhead_rate;
  }

  if (key === 'profit_rate') {
    return payload.coefficients.profit_rate;
  }

  if (key === 'usn_rate') {
    return payload.coefficients.usn_rate;
  }

  if (key === 'vat_rate') {
    return payload.coefficients.vat_rate;
  }

  return row.baseline.breakdown[key];
};
const expertNumberControls = (
  row: PayloadRow,
): readonly NumberControl<ExpertNumberFieldKey>[] =>
  row.editable_fields.flatMap((field) => {
    if (field.level !== 'expert' || !isExpertNumberFieldKey(field.key)) {
      return [];
    }

    const value = expertFieldValue(row, field.key);

    return [
      {
        key: field.key,
        label: field.label,
        value,
        unit: field.unit ?? (field.key.endsWith('_rate') ? 'доля' : '₽/год'),
      },
    ];
  });
const inlineBreakdownControls = (
  controls: readonly NumberControl<ExpertNumberFieldKey>[],
): readonly NumberControl<ExpertNumberFieldKey>[] =>
  controls.filter(isInlineBreakdownControl);
const extraExpertControls = (
  controls: readonly NumberControl<ExpertNumberFieldKey>[],
): readonly NumberControl<ExpertNumberFieldKey>[] =>
  controls.filter((control) => !isInlineBreakdownControl(control));
const hasEnabledControl = (row: PayloadRow): boolean =>
  row.editable_fields.some(
    (field) => field.key === 'enabled' && field.level === 'basic',
  );
const viewSections = htmlSections.map((section) => ({
  ...section,
  rows: section.rows.map((row) => {
    const expert = expertNumberControls(row);

    return {
      ...row,
      titleId: `reglament-row-title-${row.id}`,
      searchText: estimateRowSearchText(row),
      searchSources: estimateRowSearchSources(row),
      controls: {
        enabled: hasEnabledControl(row),
        base: numberControl(row, 'volume'),
        frequency: numberControl(row, 'frequency'),
        rate: numberControl(row, 'rate'),
        breakdown: inlineBreakdownControls(expert),
        expert: extraExpertControls(expert),
      },
      missing: {
        base: missingFieldHint(row, 'base'),
        frequency: missingFieldHint(row, 'frequency'),
        rate: missingFieldHint(row, 'price'),
      },
    };
  }),
}));
const editorConfigJson = JSON.stringify({
  rows: viewSections.flatMap((section) =>
    section.rows.map((row) => ({
      id: row.id,
      breakdown: row.controls.breakdown,
      expert: row.controls.expert,
    })),
  ),
} satisfies ReglamentEditorConfig).replaceAll('<', '\\u003c');
const inputErrorId = (rowId: string, key: EditableFieldKey): string =>
  `reglament-error-${rowId}-${key}`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={reglamentUrl()}
  keywords={keywords}
  schema={schema}
  search={search}
>
  <main class="ui-page reglament-page" data-reglament-calculator>
    <script
      type="application/json"
      data-reglament-calculation-input
      set:html={calculationInputJson}
    />
    <section class="ui-page-header">
      <div class="reglament-header">
        <div class="ui-page-header-stack">
          <Breadcrumbs items={breadcrumbs} />

          <div class="reglament-intro" data-pagefind-body>
            <h1
              id="tariff-calculator-title"
              class="ui-page-title reglament-title"
            >
              Калькулятор тарифа по смете 2026
            </h1>
            <div class="reglament-lead">
              <p>
                Смета разложена на разделы и строки. Меняйте объемы,
                периодичность и цены: калькулятор сразу пересчитает тариф в{' '}
                <span class="reglament-emphasis" data-pagefind-weight="5"
                  >₽/сотка за месяц</span
                > и покажет, как изменилась итоговая сумма.
              </p>
              <p>
                Для проверки по полному регламенту рядом есть справочники:{' '}
                <a class="ui-link reglament-link" href={reglamentAssetsUrl()}>
                  что входит в общее имущество
                </a>{' '}
                и{' '}
                <a class="ui-link reglament-link" href={reglamentServicesUrl()}>
                  какие услуги указаны в регламенте
                </a>.
              </p>
            </div>
          </div>
        </div>

        <div class="reglament-totals" aria-label="Итоги сметы">
          <div class="reglament-total reglament-total--divided">
            <p class="reglament-total__label">Официальный тариф</p>
            <p class="reglament-total__value">
              {formatReglamentTariff(payload.official.tariff_per_sotka_month)}
            </p>
            <p class="reglament-total__note">
              {formatReglamentAnnualMoney(payload.official.annual_gross)}
            </p>
          </div>
          <div class="reglament-total reglament-total--divided">
            <p class="reglament-total__label">Текущий пересчет</p>
            <p class="reglament-total__value" data-reglament-current-tariff>
              {formatReglamentTariff(payload.computed.tariff_per_sotka_month)}
            </p>
            <p class="reglament-total__note" data-reglament-current-annual>
              {formatReglamentAnnualMoney(payload.computed.annual_gross)}
            </p>
          </div>
          <div class="reglament-total">
            <p class="reglament-total__label">Разница</p>
            <p class="reglament-total__value" data-reglament-current-delta>
              {
                formatReglamentMoneyDelta(
                  payload.computed.delta_tariff_per_sotka_month,
                )
              }
            </p>
            <p class="reglament-total__note">к официальному тарифу</p>
          </div>
        </div>
      </div>
    </section>

    <div class="reglament-sticky-total">
      <div class="reglament-sticky-total__inner">
        <button
          class="reglament-reset"
          type="button"
          data-reglament-reset
          hidden
        >
          <span class="reglament-reset__long">Сбросить</span><span
            class="reglament-reset__short">Сброс</span
          >
        </button>
        <span class="ui-visually-hidden">Текущий тариф</span>
        <span class="reglament-sticky-total__values">
          <span
            class="reglament-sticky-total-original"
            data-reglament-current-original-tariff
            hidden
          >
            {formatReglamentNumber(payload.official.tariff_per_sotka_month)}
          </span>
          <span
            class="reglament-sticky-total-arrow"
            data-reglament-current-tariff-arrow
            aria-hidden="true"
            hidden
          >
            →
          </span>
          <strong
            class="reglament-sticky-total__current"
            data-reglament-current-tariff
            data-reglament-current-tariff-tone
          >
            {formatReglamentTariff(payload.computed.tariff_per_sotka_month)}
          </strong>
        </span>
      </div>
    </div>

    <section
      class="reglament-sections"
      aria-labelledby="estimate-sections-title"
    >
      <div class="reglament-sections__inner">
        <div class="reglament-sections__intro" data-pagefind-body>
          <h2 id="estimate-sections-title" class="ui-section-title">
            Разделы сметы
          </h2>
          <p class="reglament-sections__description">
            В строках главным числом показан вклад в тариф. Годовые суммы
            оставлены в деталях и источниках, чтобы можно было свериться с PDF.
          </p>
        </div>

        {
          viewSections.map((section) => (
            <section aria-labelledby={section.id}>
              <div class="reglament-section-header">
                <div class="reglament-section-heading" data-pagefind-body>
                  <h3
                    id={section.id}
                    class="ui-prose-title"
                    data-pagefind-weight="1.5"
                  >
                    {section.title}
                  </h3>
                  <p
                    class="reglament-section-sources"
                    data-pagefind-weight="0.3"
                  >
                    Источники раздела:{' '}
                    {section.source_refs.map((ref, index) => (
                      <>
                        {index > 0 && '; '}
                        <ResourceLink
                          class="ui-link reglament-source-link"
                          href={ref.pdf_url}
                          type="application/pdf"
                          reload
                        >
                          {formatEstimateSourceRefLabel(ref)}
                        </ResourceLink>
                      </>
                    ))}
                  </p>
                </div>
                <div class="reglament-section-total">
                  <p
                    class="reglament-section-total__tariff"
                    data-reglament-section-tariff={section.id}
                  >
                    {formatReglamentTariff(
                      section.official.tariff_per_sotka_month,
                    )}
                  </p>
                  <p
                    class="reglament-section-total__annual"
                    data-reglament-section-annual={section.id}
                  >
                    {formatReglamentAnnualMoney(section.official.annual_gross)}
                  </p>
                  <p
                    class="reglament-section-total__delta"
                    data-reglament-section-delta={section.id}
                  >
                    {formatReglamentMoneyDelta(
                      section.computed.delta_tariff_per_sotka_month,
                    )}
                  </p>
                </div>
              </div>

              <div
                class="reglament-table-shell ui-sticky-table-shell"
                data-ui-sticky-table-shell
              >
                <table class="reglament-table">
                  <caption class="ui-visually-hidden">{section.title}</caption>
                  <thead class="reglament-table__head">
                    <tr>
                      <th class="reglament-table__header reglament-table__header--work">
                        Работа
                      </th>
                      <th class="reglament-table__header reglament-table__header--base">
                        База
                      </th>
                      <th class="reglament-table__header reglament-table__header--frequency">
                        Периодичность
                      </th>
                      <th class="reglament-table__header reglament-table__header--rate">
                        Цена/ставка
                      </th>
                      <th class="reglament-table__header reglament-table__header--contribution">
                        Вклад в тариф
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {section.rows.map((row) => (
                      <>
                        <tr>
                          <td class="reglament-table__cell">
                            <div class="reglament-row-copy" data-pagefind-body>
                              <div class="reglament-row-heading">
                                {row.controls.enabled && (
                                  <input
                                    class="reglament-checkbox"
                                    type="checkbox"
                                    checked={row.baseline.is_enabled}
                                    aria-label="Включить позицию"
                                    aria-describedby={row.titleId}
                                    data-pagefind-ignore="all"
                                    data-reglament-field="enabled"
                                    data-reglament-row-id={row.id}
                                    data-reglament-baseline={String(
                                      row.baseline.is_enabled,
                                    )}
                                  />
                                )}
                                <h4
                                  id={row.titleId}
                                  class="reglament-table-text reglament-row-title"
                                  data-pagefind-weight="2"
                                >
                                  {row.title}
                                </h4>
                              </div>
                              <p class="ui-visually-hidden" aria-hidden="true">
                                {row.searchText}
                              </p>
                              <p
                                class="ui-visually-hidden"
                                aria-hidden="true"
                                data-pagefind-weight="0.3"
                              >
                                {row.searchSources}
                              </p>
                            </div>
                          </td>
                          <td class="reglament-table__cell reglament-table__cell--muted">
                            {row.controls.base ? (
                              <label
                                class="reglament-control"
                                data-pagefind-ignore="all"
                              >
                                <span class="reglament-input-shell">
                                  <input
                                    class="reglament-input"
                                    type="text"
                                    inputmode="decimal"
                                    value={formatReglamentInputNumber(
                                      row.controls.base.value,
                                    )}
                                    aria-label={`${row.title}: ${row.controls.base.label}`}
                                    aria-describedby={inputErrorId(
                                      row.id,
                                      row.controls.base.key,
                                    )}
                                    data-reglament-field={row.controls.base.key}
                                    data-reglament-row-id={row.id}
                                    data-reglament-baseline={String(
                                      row.controls.base.value,
                                    )}
                                  />
                                  {row.controls.base.unit && (
                                    <span class="reglament-input-unit">
                                      {row.controls.base.unit}
                                    </span>
                                  )}
                                </span>
                                <span
                                  id={inputErrorId(
                                    row.id,
                                    row.controls.base.key,
                                  )}
                                  class="reglament-input-error"
                                  aria-live="polite"
                                  aria-atomic="true"
                                  hidden
                                />
                              </label>
                            ) : row.baseline.base ? (
                              <span class="reglament-table-text">
                                {formatDisplayValue(row.baseline.base)}
                              </span>
                            ) : (
                              <span
                                class="reglament-table-text reglament-missing"
                                data-pagefind-ignore="all"
                              >
                                <span class="reglament-missing__label">
                                  <span class="reglament-semibold">
                                    {row.missing.base.label}
                                  </span>
                                  <span class="reglament-missing-help">
                                    <button
                                      class="reglament-missing-help-button"
                                      type="button"
                                      aria-label="Почему здесь нет поля ввода"
                                      aria-describedby={
                                        row.missing.base.tooltipId
                                      }
                                    >
                                      ?
                                    </button>
                                    <span
                                      id={row.missing.base.tooltipId}
                                      class="reglament-missing-tooltip"
                                      role="tooltip"
                                    >
                                      {row.missing.base.reason}
                                    </span>
                                  </span>
                                </span>
                              </span>
                            )}
                          </td>
                          <td class="reglament-table__cell reglament-table__cell--muted">
                            {row.controls.frequency ? (
                              <label
                                class="reglament-control"
                                data-pagefind-ignore="all"
                              >
                                <span class="reglament-input-shell">
                                  <input
                                    class="reglament-input"
                                    type="text"
                                    inputmode="decimal"
                                    value={formatReglamentInputNumber(
                                      row.controls.frequency.value,
                                    )}
                                    aria-label={`${row.title}: ${row.controls.frequency.label}`}
                                    aria-describedby={inputErrorId(
                                      row.id,
                                      row.controls.frequency.key,
                                    )}
                                    data-reglament-field={
                                      row.controls.frequency.key
                                    }

---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import ResourceLink from '@shelkovo/ui/ResourceLink.astro';
import {
  ForestIcon,
  ParkIcon,
  RiverIcon,
  VillageIcon,
} from '@shelkovo/ui/icons';

import { fullReglamentDataset2026 } from '@/data/reglament/full-2026';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import type {
  FullReglamentCommonAsset,
  FullReglamentVillageId,
} from '@/lib/reglament/full-schema';
import { formatReglamentNumber } from '@/lib/reglament/format';
import {
  reglamentAssetsUrl,
  reglamentFullSourcePdfUrl,
  reglamentUrl,
} from '@/lib/reglament/routes';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

type AssetCategory = FullReglamentCommonAsset['category'];

const title = 'Общее имущество — Регламент — Шелково Онлайн';
const description =
  'Справочник общего имущества Шелково из полного регламента: дороги, ливневые траншеи, зелень, благоустройство, электроснабжение и охрана.';
const search = {
  scope: 'manual',
  title: 'Что входит в общее имущество',
  description,
  section: SEARCH_SECTIONS.regulation,
} satisfies SearchDocument;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Регламент', href: reglamentUrl() },
  { label: 'Общее имущество' },
]);
const categoryLabels = {
  roads: 'Дороги и тротуары',
  stormwater: 'Ливневые траншеи',
  greenery: 'Зеленые насаждения',
  forest: 'Лес',
  improvement: 'Объекты благоустройства',
  electricity: 'Электроснабжение',
  security: 'Охрана',
} as const satisfies Record<AssetCategory, string>;
const categoryOrder = [
  'roads',
  'stormwater',
  'greenery',
  'forest',
  'improvement',
  'electricity',
  'security',
] as const satisfies readonly AssetCategory[];
const groups = categoryOrder
  .map((category) => ({
    category,
    title: categoryLabels[category],
    assets: fullReglamentDataset2026.common_assets.filter(
      (asset) => asset.category === category,
    ),
  }))
  .filter((group) => group.assets.length > 0);
const schema = collectionPageSchema({
  name: title,
  description,
  url: reglamentAssetsUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Регламент', url: reglamentUrl() },
    { name: 'Общее имущество', url: reglamentAssetsUrl() },
  ]),
  items: groups.map((group) => ({
    name: group.title,
    url: `${reglamentAssetsUrl()}#${group.category}`,
  })),
});

const displayQuantity = (
  quantity: FullReglamentCommonAsset['total'],
): string =>
  quantity.value === null
    ? quantity.raw
    : formatReglamentNumber(quantity.value);
const publicVerificationNote = (
  note: FullReglamentCommonAsset['verification_note'],
): string | null => note;
const assetSearchText = (
  asset: FullReglamentCommonAsset,
  category: string,
): string => {
  const quantities = fullReglamentDataset2026.villages
    .map(
      (village) =>
        `${village.title}: ${displayQuantity(asset.values_by_village[village.id])}`,
    )
    .join('; ');

  return [
    `Категория: ${category}.`,
    asset.unit
      ? `Единица измерения: ${asset.unit.replace(/\.$/u, '')}.`
      : undefined,
    `Количество по поселкам: ${quantities}; всего: ${displayQuantity(asset.total)}.`,
  ]
    .filter((part): part is string => Boolean(part))
    .join(' ');
};
const villageIcons = {
  'shelkovo-village': VillageIcon,
  'shelkovo-forest': ForestIcon,
  'shelkovo-park': ParkIcon,
  'shelkovo-river': RiverIcon,
} as const satisfies Record<FullReglamentVillageId, typeof VillageIcon>;
---

<BaseLayout
  title={title}
  description={description}
  canonical={reglamentAssetsUrl()}
  keywords={[
    'общее имущество Шелково',
    'регламент Шелково имущество',
    'Шелково дороги охрана освещение',
  ]}
  schema={schema}
  search={search}
>
  <main class="ui-page assets-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack assets-header">
        <Breadcrumbs items={breadcrumbs} />

        <div class="assets-intro" data-pagefind-body>
          <h1 class="ui-page-title assets-title">
            Что входит в общее имущество
          </h1>
          <div class="assets-intro-copy">
            <p>
              Справочник по Приложению №2 полного регламента: дороги, ливневые
              траншеи, зеленые насаждения, благоустройство, электроснабжение и
              охрана по поселкам.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="assets-content" aria-labelledby="assets-title">
      <div class="assets-groups">
        <h2 id="assets-title" class="ui-visually-hidden">
          Таблицы общего имущества
        </h2>

        {
          groups.map((group) => (
            <section class="assets-group" aria-labelledby={group.category}>
              <div class="assets-group-header" data-pagefind-body>
                <h3
                  id={group.category}
                  class="ui-section-title"
                  data-pagefind-weight="1.5"
                >
                  {group.title}
                </h3>
                <p class="assets-source" data-pagefind-weight="0.3">
                  Источник:{' '}
                  <ResourceLink
                    class="ui-link"
                    href={reglamentFullSourcePdfUrl()}
                    type="application/pdf"
                    reload
                  >
                    полный регламент
                  </ResourceLink>
                  , Приложение №2, стр. 128-130. Значения перенесены как
                  справочные факты; пустые ячейки сохранены пустыми.
                </p>
              </div>

              <div
                class="reglament-table-shell ui-sticky-table-shell assets-table-shell"
                data-ui-sticky-table-shell
              >
                <table class="assets-table">
                  <caption class="ui-visually-hidden">{group.title}</caption>
                  <thead class="assets-table-head">
                    <tr>
                      <th class="assets-table-heading assets-table-object">
                        Объект
                      </th>
                      <th class="assets-table-heading">Ед. изм.</th>
                      {fullReglamentDataset2026.villages.map((village) => {
                        const AreaIcon = villageIcons[village.id];

                        return (
                          <th class="assets-table-heading assets-table-number">
                            <span class="assets-village">
                              <AreaIcon class="assets-village-icon" />
                              <span>
                                {village.title.replace('Шелково ', '')}
                              </span>
                            </span>
                          </th>
                        );
                      })}
                      <th class="assets-table-heading assets-table-number assets-table-total-heading">
                        Всего
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.assets.map((asset) => {
                      const note = publicVerificationNote(
                        asset.verification_note,
                      );

                      return (
                        <tr>
                          <td class="assets-table-cell">
                            <div class="assets-item" data-pagefind-body>
                              <h4
                                id={`reglament-asset-${asset.id}`}
                                class="assets-item-title"
                                data-pagefind-weight="2"
                              >
                                {asset.title}
                              </h4>
                              <p class="ui-visually-hidden" aria-hidden="true">
                                {assetSearchText(asset, group.title)}
                              </p>
                              {note && <p class="assets-note">{note}</p>}
                            </div>
                          </td>
                          <td class="assets-table-cell assets-table-muted">
                            {asset.unit ?? '-'}
                          </td>
                          {fullReglamentDataset2026.villages.map((village) => (
                            <td class="assets-table-cell assets-table-number assets-table-muted">
                              {displayQuantity(
                                asset.values_by_village[village.id],
                              )}
                            </td>
                          ))}
                          <td class="assets-table-cell assets-table-number assets-table-total">
                            {displayQuantity(asset.total)}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>

  <style>
    .assets-page {
      padding-block-end: 2rem;
    }

    .assets-header {
      max-width: 64rem;
    }

    .assets-intro > * + * {
      margin-block-start: 1rem;
    }

    .assets-title {
      max-width: 56rem;
    }

    .assets-intro-copy,
    .assets-group-header {
      max-width: 48rem;
    }

    .assets-intro-copy {
      color: var(--color-text-muted);
      font-size: 0.875rem;
      line-height: 1.5rem;
    }

    .assets-intro-copy > * + * {
      margin-block-start: 0.75rem;
    }

    .assets-content {
      padding-inline: 1.25rem;
    }

    .assets-groups {
      max-width: 72rem;
    }

    .assets-groups > section + section {
      margin-block-start: 2.5rem;
    }

    .assets-group > * + * {
      margin-block-start: 1rem;
    }

    .assets-group-header > * + * {
      margin-block-start: 0.375rem;
    }

    .assets-source {
      color: var(--color-text-muted);
      font-size: 0.875rem;
      line-height: 1.5rem;
    }

    .assets-note {
      color: var(--color-primary);
    }

    .assets-table-shell {
      margin-inline: -1.25rem;
      border-block: 1px solid var(--color-border);
      background-color: var(--color-surface);
    }

    .assets-table {
      width: 100%;
      min-width: 58rem;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 0.875rem;
      line-height: 1.25rem;
      text-align: left;
    }

    .assets-table-head {
      color: var(--color-text-muted);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      line-height: 1rem;
      text-transform: uppercase;
    }

    .assets-table-heading {
      position: sticky;
      top: var(--ui-sticky-table-header-top);
      z-index: 10;
      padding: 0.625rem 1rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface-muted);
      vertical-align: bottom;
    }

    .assets-table-object {
      width: 24%;
    }

    .assets-table-number {
      text-align: right;
    }

    .assets-village {
      display: inline-flex;
      align-items: baseline;
      justify-content: flex-end;
      gap: 0.375rem;
    }

    .assets-village :global(.assets-village-icon) {
      width: 1.75rem;
      height: 0.875rem;
      flex-shrink: 0;
    }

    .assets-table-cell {
      padding: 0.75rem 1rem;
      border-top: 1px solid var(--color-border);
      vertical-align: top;
    }

    .assets-item > * + * {
      margin-block-start: 0.375rem;
    }

    .assets-item-title,
    .assets-table-total {
      color: var(--color-text);
      font-weight: 600;
    }

    .assets-note {
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.25rem;
    }

    .assets-table-muted {
      color: var(--color-text-muted);
    }

    @media (min-width: 40rem) {
      .assets-table-shell {
        margin-inline: 0;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
      }

      .assets-table-object {
        border-top-left-radius: var(--radius-xl);
      }

      .assets-table-total-heading {
        border-top-right-radius: var(--radius-xl);
      }
    }

    @media (min-width: 48rem) {
      .assets-page {
        padding-block-end: 3rem;
      }

      .assets-intro-copy {
        font-size: 0.9375rem;
      }

      .assets-content {
        padding-inline: 1.5rem;
      }

      .assets-source {
        font-size: 1rem;
        line-height: 1.75rem;
      }
    }

    @media (min-width: 64rem) {
      .assets-page {
        padding-block-end: 4rem;
      }
    }
  </style>

  <script>
    import { hydrateStickyTableHeaders } from '@/lib/sticky-table-headers';

    const hydrate = () => hydrateStickyTableHeaders();

    hydrate();
    document.addEventListener('astro:after-swap', hydrate);
    document.addEventListener('astro:page-load', hydrate);
  </script>
</BaseLayout>

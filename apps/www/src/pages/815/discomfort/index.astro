---
import { formatDynamicHtml } from '@shelkovo/typography';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import {
  DISCOMFORT_DESCRIPTION,
  DISCOMFORT_LEAD,
  DISCOMFORT_META_TITLE,
  DISCOMFORT_PAGE_TITLE,
  DISCOMFORT_QUOTE,
  DISCOMFORT_QUOTE_TIMESTAMP,
  DISCOMFORT_QUOTE_TIMESTAMP_URL,
} from '@/lib/discomfort/config';
import { loadDiscomfortData } from '@/lib/discomfort/load';
import { discomfortCanonical, discomfortUrl } from '@/lib/discomfort/routes';
import { formatDiscomfortDate } from '@/lib/discomfort/view';
import { renderMarkdown } from '@/lib/markdown/render';
import { collectionPageSchema } from '@/lib/json-ld';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { DiscomfortDataset } from '@/lib/discomfort/types';

interface Props {
  readonly data?: DiscomfortDataset;
}

const data = Astro.props.data ?? (await loadDiscomfortData());
const breadcrumbs = withHomeBreadcrumbs([{ label: DISCOMFORT_PAGE_TITLE }]);
const quoteHtml = formatDynamicHtml(DISCOMFORT_QUOTE);
const schema = collectionPageSchema({
  name: DISCOMFORT_META_TITLE,
  description: DISCOMFORT_DESCRIPTION,
  url: discomfortUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: DISCOMFORT_PAGE_TITLE, url: discomfortUrl() },
  ]),
  items: data.events.map((event) => ({
    name: event.title,
    url: event.url,
  })),
});
const events = data.events.map((event) => ({
  event,
  bodyHtml: renderMarkdown(event.body),
  dateHtml: formatDynamicHtml(formatDiscomfortDate(event.dateIso)),
  titleHtml: formatDynamicHtml(event.title),
}));
const latestDateHtml = data.latestEvent
  ? formatDynamicHtml(formatDiscomfortDate(data.latestEvent.dateIso))
  : undefined;
---

<BaseLayout
  title={DISCOMFORT_META_TITLE}
  description={DISCOMFORT_DESCRIPTION}
  canonical={discomfortCanonical()}
  schema={schema}
  search={{
    scope: 'page',
    title: DISCOMFORT_PAGE_TITLE,
    description: DISCOMFORT_DESCRIPTION,
    section: SEARCH_SECTIONS.discomfort,
  }}
>
  <main class="ui-page discomfort-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack discomfort-content">
        <Breadcrumbs items={breadcrumbs} />

        <div>
          <h1 class="ui-page-title">{DISCOMFORT_PAGE_TITLE}</h1>

          <figure class="discomfort-quote">
            <div class="discomfort-quote-content">
              <blockquote cite={DISCOMFORT_QUOTE_TIMESTAMP_URL}>
                <p
                  class="ui-prose-title discomfort-quote-text"
                  set:html={quoteHtml}
                />
              </blockquote>

              <figcaption class="discomfort-quote-caption">
                <p>
                  <a
                    href={data.quoteAuthor.htmlUrl}
                    title={data.quoteAuthor.linkTitle}
                    class="site-text-link"
                  >
                    {data.quoteAuthor.label}
                  </a>{' '}
                  на встрече по новому тарифу,{' '}
                  <a
                    href={DISCOMFORT_QUOTE_TIMESTAMP_URL}
                    class="site-text-link"
                    data-pagefind-ignore
                  >
                    {DISCOMFORT_QUOTE_TIMESTAMP}
                  </a>
                  .
                </p>
              </figcaption>
            </div>
          </figure>

          <div class="discomfort-lead">
            <p class="ui-copy">{DISCOMFORT_LEAD}</p>
            {data.latestEvent && latestDateHtml && (
              <p class="discomfort-latest">
                Последнее событие —{' '}
                <time
                  datetime={data.latestEvent.dateIso}
                  set:html={latestDateHtml}
                />
              </p>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="discomfort-timeline" aria-labelledby="timeline-title">
      <div class="discomfort-content">
        <h2 id="timeline-title" class="ui-visually-hidden">
          Хронология
        </h2>
        <ol class="discomfort-events" role="list">
          {events.map(({ event, bodyHtml, dateHtml, titleHtml }, index) => (
            <li class="discomfort-event">
              <a
                href={event.url}
                aria-label={`Ссылка на событие «${event.title}»`}
                title="Ссылка на это событие"
                class="site-text-link discomfort-event-date ui-num"
              >
                <time datetime={event.dateIso} set:html={dateHtml} />
              </a>

              <span class="discomfort-event-marker" aria-hidden="true">
                {index > 0 && <span class="discomfort-event-line-before" />}
                {index < events.length - 1 && (
                  <span class="discomfort-event-line-after" />
                )}
                <span class="discomfort-event-dot" />
              </span>

              <div class="discomfort-event-content">
                <h3
                  id={event.slug}
                  class="ui-entry-title discomfort-event-title"
                  set:html={titleHtml}
                />
                <div
                  class="ui-prose discomfort-event-body"
                  set:html={bodyHtml}
                />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .discomfort-page {
    padding-bottom: 2.5rem;
  }
  .discomfort-content {
    max-width: 64rem;
  }
  .discomfort-quote {
    margin-top: 1.75rem;
    max-width: 56rem;
    background: var(--color-primary-soft);
    padding: 1.75rem 1.25rem;
  }
  .discomfort-quote-content,
  .discomfort-lead {
    max-width: 48rem;
  }
  .discomfort-quote-caption {
    margin: 1.75rem 0 0 auto;
    max-width: 36rem;
    text-align: right;
    font-size: 0.875rem;
    line-height: 1.5rem;
    color: var(--color-text-muted);
  }
  .discomfort-lead {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }
  .discomfort-latest {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
  .discomfort-timeline {
    margin-top: 2rem;
    padding-inline: 1.25rem;
  }
  .discomfort-events {
    list-style: none;
  }
  .discomfort-event {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-bottom: 2.5rem;
  }
  .discomfort-event:last-child {
    padding-bottom: 0;
  }
  .discomfort-event-date {
    grid-column: 2;
    grid-row: 1;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
  .discomfort-event-marker {
    position: relative;
    grid-column: 1;
    grid-row: 1 / span 2;
    display: flex;
    justify-content: center;
  }
  .discomfort-event-line-before,
  .discomfort-event-line-after {
    position: absolute;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: var(--color-text-soft);
  }
  .discomfort-event-line-before {
    top: 0;
    height: 0.5rem;
  }
  .discomfort-event-line-after {
    top: 0.5rem;
    bottom: -2.5rem;
  }
  .discomfort-event-dot {
    position: relative;
    margin-top: 0.5rem;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-primary);
  }
  .discomfort-event-content {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.375rem;
    min-width: 0;
  }
  .discomfort-event-title {
    scroll-margin-top: 6rem;
  }
  .discomfort-event-body {
    margin-top: 0.75rem;
    max-width: 70ch;
  }
  .discomfort-event-body :global(> :first-child) {
    margin-top: 0;
  }
  .discomfort-event-body :global(> :last-child) {
    margin-bottom: 0;
  }
  @media (min-width: 48rem) {
    .discomfort-page {
      padding-bottom: 3.5rem;
    }
    .discomfort-quote {
      margin-top: 2rem;
      padding: 2.5rem 2.25rem;
    }
    .discomfort-quote blockquote {
      padding-inline: 1.25rem;
    }
    .discomfort-quote-text {
      font-size: 2.25rem;
      line-height: 1.12;
    }
    .discomfort-quote-caption {
      font-size: 1rem;
      line-height: 1.75rem;
    }
    .discomfort-timeline {
      margin-top: 2.5rem;
      padding-inline: 1.5rem;
    }
    .discomfort-event {
      grid-template-columns: 10rem 1rem minmax(0, 1fr);
      column-gap: 1.5rem;
      padding-bottom: 3rem;
    }
    .discomfort-event-date {
      grid-column: 1;
      text-align: right;
    }
    .discomfort-event-marker {
      grid-column: 2;
    }
    .discomfort-event-line-after {
      bottom: -3rem;
    }
    .discomfort-event-content {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
    }
  }
  @media (min-width: 64rem) {
    .discomfort-page {
      padding-bottom: 4rem;
    }
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/compare/components/Hero.svelte';
import KPIStats from '@/compare/components/KPIStats.svelte';
import SettlementsExplorer from '@/compare/components/SettlementsExplorer.svelte';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import {
  compareBreadcrumbs,
  compareBreadcrumbSchema,
} from '@/compare/lib/breadcrumbs';
import { loadAllData } from '@/compare/lib/data';
import { toExplorerPayload } from '@/compare/lib/explorer';
import { compareHomeMeta } from '@/compare/lib/seo';
import { canon } from '@/compare/lib/site';
import { withBase } from '@/compare/lib/url';

// Load all data at build time
const explorer = toExplorerPayload(await loadAllData());
const { settlements: list, comparisons, stats } = explorer;
const ratingUrl = withBase('/rating/');

const cards = [...list].sort((a, b) => {
  const d = b.rating - a.rating;
  if (d !== 0) return d;
  return a.shortName.localeCompare(b.shortName, 'ru');
});

const pageMeta = compareHomeMeta(stats.totalSettlements);
const pageUrl = canon('/');
const breadcrumbs = compareBreadcrumbs();
const breadcrumb = compareBreadcrumbSchema(breadcrumbs);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageMeta.title,
  description: pageMeta.description,
  url: pageUrl,
  inLanguage: 'ru-RU',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cards.length,
    itemListElement: cards.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: canon(`/settlements/${item.slug}/`),
    })),
  },
};
---

<BaseLayout
  title={pageMeta.title}
  description={pageMeta.description}
  keywords={pageMeta.keywords}
  schema={[schema, breadcrumb]}
>
  <main class="ui-page pb-6 md:pb-10 lg:pb-12">
    <section class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />

        <Hero
          title="Сравнение тарифов"
          subtitle="Структурированное сравнение тарифов поселков: цена, инфраструктура, сервисы, расстояние до Москвы и"
          subtitleLinkHref={ratingUrl}
          subtitleLinkText="рейтингу"
        >
          <KPIStats stats={stats} embed />
        </Hero>
      </div>
    </section>

    <section
      id="settlements"
      aria-labelledby="settlements-title"
      class="mt-6 space-y-6 px-0 md:px-6"
    >
      <h2 id="settlements-title" class="ui-visually-hidden">
        Список поселков для сравнения
      </h2>
      <div
        class="explorer-error ui-shell"
        data-explorer-error
        hidden
        role="alert"
      >
        <p>Не удалось загрузить интерактивное сравнение</p>
        <button
          type="button"
          class="ui-btn ui-btn-sm ui-btn-ghost"
          data-explorer-retry
        >
          Попробовать снова
        </button>
      </div>
      <div data-explorer-root>
        <SettlementsExplorer settlements={list} {comparisons} {stats} />
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { installSettlementsExplorer } from '@/compare/client/explorer';

  installSettlementsExplorer();
</script>

<style>
  .explorer-error {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--color-danger-border);
    padding: 0.75rem 1rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
  }

  .explorer-error[hidden] {
    display: none;
  }
</style>

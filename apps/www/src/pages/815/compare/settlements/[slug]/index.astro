---
import CommonSpacesTable from '@/compare/components/CommonSpacesTable.svelte';
import InfrastructureTable from '@/compare/components/InfrastructureTable.svelte';
import ServiceTable from '@/compare/components/ServiceTable.svelte';
import SettlementMap from '@/compare/components/SettlementMap.svelte';
import SourcesList from '@/compare/components/SourcesList.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import { GlobeIcon, MapPinIcon, TelegramIcon } from '@shelkovo/ui/icons';
import {
  formatCurrency,
  formatDistance,
  formatPercentage,
} from '@shelkovo/format';
import { calculateDistance } from '@shelkovo/geo';
import {
  compareBreadcrumbSchema,
  settlementBreadcrumbs,
} from '@/compare/lib/breadcrumbs';
import { loadAllData } from '@/compare/lib/data';
import {
  getLotCalc,
  formatTariffAuto,
  formatTariffBase,
  getTariffCalc,
} from '@/compare/lib/format';
import type { Settlement } from '@/compare/lib/settlement/types';
import {
  settlementPageMeta,
  settlementSearchDescription,
} from '@/compare/lib/seo';
import { canon } from '@/compare/lib/site';
import { telegram } from '@/compare/lib/url';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

// Generate static paths for all settlements
export async function getStaticPaths() {
  const { settlements, baseline, comparisons } = await loadAllData();

  return settlements.map((settlement) => ({
    params: { slug: settlement.slug },
    props: {
      settlement,
      comparison: comparisons.get(settlement.slug),
      baseline,
    },
  }));
}

interface Props {
  settlement: Settlement;
  comparison:
    | {
        tariffDelta: number;
        tariffDeltaPercent: number;
        isCheaper: boolean;
      }
    | undefined;
  baseline: Settlement;
}

const { settlement, comparison, baseline } = Astro.props;
const isBaseline = settlement.slug === baseline.slug;

// Calculate distance from Shelkovo
const distanceFromShelkovo = !isBaseline
  ? calculateDistance(
      baseline.location.lat,
      baseline.location.lng,
      settlement.location.lat,
      settlement.location.lng,
    )
  : 0;

const hasPoint =
  Number.isFinite(settlement.location.lat) &&
  Number.isFinite(settlement.location.lng);
const company = settlement.managementCompany;
const companyTitle = company?.title ?? '';
const companyUrl = company?.url ?? '';
const tg = settlement.telegram ? telegram(settlement.telegram) : undefined;
const waterInc = settlement.waterInTariff === true;
const obman = settlement.rabstvo === true;
const obmanUrl = telegram('obmandachniki');
const hasLabels = waterInc || obman || isBaseline;
const waterTitle =
  'Центральная вода уже включена в тариф и доступна без отдельной доплаты.';
const hasDelta = !isBaseline && !!comparison && comparison.tariffDelta !== 0;
const pageUrl = canon(`/settlements/${settlement.slug}/`);
const pageMeta = settlementPageMeta(settlement, comparison);
const searchDescription = settlementSearchDescription(settlement, comparison);
const search = {
  scope: 'manual',
  title: settlement.name,
  description: searchDescription,
  section: SEARCH_SECTIONS.compare,
} satisfies SearchDocument;
const delta =
  hasDelta && comparison
    ? `${comparison.isCheaper ? 'Дешевле' : 'Дороже'} Шелково на ${formatCurrency(Math.abs(comparison.tariffDelta))}.`
    : isBaseline
      ? 'Базовый поселок для сравнения.'
      : comparison
        ? 'Тариф как в Шелково.'
        : '';
const breadcrumbs = settlementBreadcrumbs(settlement.name, settlement.slug);
const breadcrumb = compareBreadcrumbSchema(breadcrumbs);
const same = [settlement.website, ...(tg ? [tg] : [])];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: settlement.name,
  url: pageUrl,
  description: pageMeta.description,
  keywords: pageMeta.keywords.join(', '),
  address: settlement.location.addressText,
  mainEntityOfPage: pageUrl,
  ...(same.length ? { sameAs: same } : {}),
  ...(hasPoint
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: settlement.location.lat,
          longitude: settlement.location.lng,
        },
      }
    : {}),
};
const tariffCalc = getTariffCalc(
  settlement.tariff,
  settlement.lots,
  settlement.infrastructure,
  settlement.commonSpaces,
);
const lotCalc = getLotCalc(
  settlement.lots,
  settlement.infrastructure,
  settlement.commonSpaces,
);
const tipDesktopId = `${settlement.slug}-tariff-tip-desktop`;
const tipMobileId = `${settlement.slug}-tariff-tip-mobile`;
const assumption = tariffCalc?.assumption;
const heroMap = hasPoint
  ? [
      {
        slug: settlement.slug,
        name: settlement.name,
        shortName: settlement.shortName,
        lat: settlement.location.lat,
        lng: settlement.location.lng,
        normalizedTariff: settlement.tariff.normalizedPerSotkaMonth,
        isBaseline,
      },
    ]
  : [];
---

<BaseLayout
  title={pageMeta.title}
  description={pageMeta.description}
  keywords={pageMeta.keywords}
  schema={[schema, breadcrumb]}
  preconnectYandexMaps
  search={search}
>
  <main class="ui-page settlement-page">
    <h1 class="ui-visually-hidden">{settlement.name}</h1>
    <p class="ui-visually-hidden" data-pagefind-body>{searchDescription}</p>

    <div class="settlement-breadcrumbs ui-page-header">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="settlement-hero hero-bleed" data-testid="settlement-hero">
      <div
        class:list={[
          'settlement-hero-map hero-map-fade',
          { 'hero-map-placeholder': !hasPoint },
        ]}
      >
        {
          hasPoint && (
            <div class="settlement-hero-map-canvas">
              <SettlementMap
                settlements={heroMap}
                interactive={false}
                popup={false}
                shell={false}
                muted={false}
                height={430}
                focusX={0.8}
                client:visible
              />
            </div>
          )
        }

        <div class="settlement-hero-wash-top"></div>
        <div class="settlement-hero-wash-bottom"></div>
      </div>

      <div class="ui-page settlement-hero-content">
        <div class="settlement-hero-label-row">
          <div class="settlement-labels">
            {
              waterInc && (
                <span class="ui-badge ui-badge-water" title={waterTitle}>
                  Вода в тарифе
                </span>
              )
            }
            {
              obman && (
                <a
                  href={obmanUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ui-badge ui-badge-danger settlement-badge-link"
                  title="Открыть Telegram-канал Коттеджное рабство"
                >
                  Коттеджное рабство
                </a>
              )
            }
            {
              isBaseline && (
                <span class="ui-badge ui-badge-info">Наш посёлок</span>
              )
            }
          </div>
        </div>

        <div
          class:list={[
            'settlement-hero-summary',
            { 'settlement-hero-summary--spaced': !hasLabels },
          ]}
        >
          <div class="settlement-hero-heading">
            <div class="settlement-hero-title-row">
              <div class="settlement-hero-title-wrap">
                <div
                  aria-hidden="true"
                  class="settlement-hero-title-shadow ui-page-title"
                >
                  {settlement.name}
                </div>
              </div>
              <div class="settlement-hero-actions">
                {
                  settlement.website && (
                    <a
                      href={settlement.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Открыть сайт поселка"
                      class="ui-icon-btn"
                      title="Перейти на сайт поселка"
                    >
                      <GlobeIcon class="settlement-icon settlement-icon--desktop" />
                    </a>
                  )
                }
                {
                  tg && (
                    <a
                      href={tg}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Открыть Telegram-канал поселка"
                      class="ui-icon-btn"
                      title="Перейти в Telegram-канал"
                    >
                      <TelegramIcon class="settlement-icon settlement-icon--desktop settlement-icon--telegram" />
                    </a>
                  )
                }
                <a
                  href={settlement.location.mapUrl ??
                    `https://yandex.ru/maps/?pt=${settlement.location.lng},${settlement.location.lat}&z=15&l=map`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Открыть поселок на Яндекс.Картах"
                  class="ui-icon-btn"
                  title="Открыть на Яндекс.Картах"
                >
                  <MapPinIcon
                    class="settlement-icon settlement-icon--desktop"
                  />
                </a>
              </div>
            </div>
            <p class="settlement-hero-district settlement-hero-text-shadow">
              {settlement.location.district}
            </p>
            {
              companyTitle && (
                <div class="settlement-hero-glass-pill settlement-company-pill">
                  <span class="settlement-company-label">Обслуживается</span>
                  {companyUrl ? (
                    <a
                      href={companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="settlement-company-link"
                      title="Перейти на сайт управляющей компании"
                    >
                      {companyTitle}
                    </a>
                  ) : (
                    <span class="settlement-company-name">{companyTitle}</span>
                  )}
                </div>
              )
            }
          </div>

          <div
            class:list={[
              'settlement-hero-facts',
              { 'settlement-hero-facts--three': hasDelta },
            ]}
          >
            <div class="settlement-hero-glass-card settlement-tariff-card">
              <p class="settlement-fact-label">Тариф</p>
              <div class="settlement-tariff-group">
                <span
                  class:list={[
                    'ui-num',
                    'settlement-tariff-value',
                    { 'settlement-tariff-value--interactive': tariffCalc },
                  ]}
                  tabindex={tariffCalc ? 0 : undefined}
                  aria-describedby={tariffCalc ? tipDesktopId : undefined}
                >
                  {formatTariffAuto(settlement.tariff)}
                </span>
                {
                  tariffCalc && (
                    <div
                      id={tipDesktopId}
                      role="tooltip"
                      class="settlement-hero-tooltip"
                    >
                      <p class="settlement-tooltip-muted">{tariffCalc.intro}</p>
                      {assumption && (
                        <p class="settlement-tooltip-muted settlement-tooltip-line">
                          {assumption}
                        </p>
                      )}
                      {lotCalc && (
                        <div class="settlement-tooltip-section">
                          <p class="settlement-tooltip-title">
                            Средняя площадь участка
                          </p>
                          <p class="settlement-tooltip-muted settlement-tooltip-line">
                            Данные: {lotCalc.known}
                          </p>
                          {lotCalc.factors && (
                            <p class="settlement-tooltip-muted">
                              Вычет: {lotCalc.factors}
                            </p>
                          )}
                          <p class="settlement-tooltip-text">
                            Итого: {lotCalc.total}
                          </p>
                        </div>
                      )}
                      <div
                        class:list={[
                          'settlement-tooltip-rows',
                          { 'settlement-tooltip-rows--divided': lotCalc },
                        ]}
                      >
                        {tariffCalc.rows.map((item) => (
                          <div>
                            <p class="settlement-tooltip-title">{item.title}</p>
                            <p class="settlement-tooltip-muted">
                              {item.source}
                            </p>
                            <p class="settlement-tooltip-text">
                              {item.formula}
                            </p>
                          </div>
                        ))}
                      </div>
                      <p class="settlement-tooltip-total">
                        Итого: {tariffCalc.total}
                      </p>
                    </div>
                  )
                }
              </div>
              {
                settlement.tariff.normalizedIsEstimate && (
                  <p class="settlement-tariff-detail settlement-tariff-detail--estimate">
                    {formatTariffBase(settlement.tariff)}
                  </p>
                )
              }
              {
                settlement.tariff.note && (
                  <p class="settlement-tariff-detail">
                    {settlement.tariff.note}
                  </p>
                )
              }
            </div>

            {
              hasDelta && comparison && (
                <div class="settlement-hero-glass-card">
                  <p class="settlement-fact-label">Разница с Шелково</p>
                  <p
                    class:list={[
                      'ui-num',
                      'settlement-delta-value',
                      comparison.isCheaper
                        ? 'settlement-delta-value--cheaper'
                        : 'settlement-delta-value--costlier',
                    ]}
                  >
                    {comparison.isCheaper ? '−' : '+'}
                    {formatCurrency(Math.abs(comparison.tariffDelta))}
                  </p>
                  <p class="settlement-fact-detail">
                    {comparison.isCheaper ? 'Дешевле' : 'Дороже'} на{' '}
                    {formatPercentage(comparison.tariffDeltaPercent / 100, {
                      signed: false,
                    })}
                  </p>
                </div>
              )
            }

            <div class="settlement-hero-glass-card">
              <p class="settlement-fact-label">Расположение</p>
              <p class="settlement-location-address">
                {settlement.location.addressText}
              </p>
              {
                distanceFromShelkovo > 0 && (
                  <p class="settlement-fact-detail">
                    {formatDistance(distanceFromShelkovo)} от Шелково
                  </p>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <header class="settlement-mobile-header">
      <div class="settlement-mobile-heading">
        <div>
          <div class="settlement-mobile-title-group">
            <div class="settlement-mobile-title-wrap">
              <div aria-hidden="true" class="ui-page-title">
                {settlement.name}
              </div>
            </div>
            <div class="settlement-mobile-actions">
              {
                settlement.website && (
                  <a
                    href={settlement.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Открыть сайт поселка"
                    class="ui-btn ui-btn-sm ui-btn-outline settlement-mobile-action"
                    title="Перейти на сайт поселка"
                  >
                    <GlobeIcon class="settlement-icon" />
                    <span>Сайт</span>
                  </a>
                )
              }
              {
                tg && (
                  <a
                    href={tg}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Открыть Telegram-канал поселка"
                    class="ui-btn ui-btn-sm ui-btn-outline settlement-mobile-action"
                    title="Перейти в Telegram-канал"
                  >
                    <TelegramIcon class="settlement-icon settlement-icon--telegram" />
                    <span>Telegram</span>
                  </a>
                )
              }
              <a
                href={settlement.location.mapUrl ??
                  `https://yandex.ru/maps/?pt=${settlement.location.lng},${settlement.location.lat}&z=15&l=map`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Открыть поселок на Яндекс.Картах"
                class="ui-btn ui-btn-sm ui-btn-outline settlement-mobile-action"
                title="Открыть на Яндекс.Картах"
              >
                <MapPinIcon class="settlement-icon" />
                <span>Карта</span>
              </a>
            </div>
          </div>
        </div>
        <p class="settlement-mobile-district">
          {settlement.location.district}
        </p>
        {
          companyTitle && (
            <p class="settlement-mobile-company">
              Обслуживается:{' '}
              {companyUrl ? (
                <a
                  href={companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="settlement-company-link settlement-company-link--mobile"
                  title="Перейти на сайт управляющей компании"
                >
                  {companyTitle}
                </a>
              ) : (
                <span class="settlement-company-name">{companyTitle}</span>
              )}
            </p>
          )
        }
      </div>

      {
        hasLabels && (
          <div class="settlement-mobile-labels">
            {waterInc && (
              <span class="ui-badge ui-badge-water" title={waterTitle}>
                Вода в тарифе
              </span>
            )}
            {obman && (
              <a
                href={obmanUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ui-badge ui-badge-danger settlement-badge-link"
                title="Открыть Telegram-канал Коттеджное рабство"
              >
                Коттеджное рабство
              </a>
            )}
            {isBaseline && (
              <span class="ui-badge ui-badge-info">Наш посёлок</span>
            )}
          </div>
        )
      }
    </header>

    <section class="settlement-passport" data-testid="base-info-section">
      <h2 class="ui-visually-hidden">Паспорт поселка</h2>

      <div class="settlement-passport-content">
        <p class="settlement-passport-label">Тариф на обслуживание</p>
        <div class="settlement-passport-tariff">
          <div class="ui-num settlement-passport-tariff-group">
            <span
              class:list={{
                'settlement-tariff-value--interactive': tariffCalc,
              }}
              tabindex={tariffCalc ? 0 : undefined}
              aria-describedby={tariffCalc ? tipMobileId : undefined}
            >
              {formatTariffAuto(settlement.tariff)}
            </span>
            {
              tariffCalc && (
                <div
                  id={tipMobileId}
                  role="tooltip"
                  class="settlement-hero-tooltip settlement-hero-tooltip--mobile"
                >
                  <p class="settlement-tooltip-muted">{tariffCalc.intro}</p>
                  {assumption && (
                    <p class="settlement-tooltip-muted settlement-tooltip-line">
                      {assumption}
                    </p>
                  )}
                  {lotCalc && (
                    <div class="settlement-tooltip-section">
                      <p class="settlement-tooltip-title">
                        Средняя площадь участка
                      </p>
                      <p class="settlement-tooltip-muted settlement-tooltip-line">
                        Данные: {lotCalc.known}
                      </p>
                      {lotCalc.factors && (
                        <p class="settlement-tooltip-muted">
                          Вычет: {lotCalc.factors}
                        </p>
                      )}
                      <p class="settlement-tooltip-text">
                        Итого: {lotCalc.total}
                      </p>
                    </div>
                  )}
                  <div
                    class:list={[
                      'settlement-tooltip-rows',
                      { 'settlement-tooltip-rows--divided': lotCalc },
                    ]}
                  >
                    {tariffCalc.rows.map((item) => (
                      <div>
                        <p class="settlement-tooltip-title">{item.title}</p>
                        <p class="settlement-tooltip-muted">{item.source}</p>
                        <p class="settlement-tooltip-text">{item.formula}</p>
                      </div>
                    ))}
                  </div>
                  <p class="settlement-tooltip-total">
                    Итого: {tariffCalc.total}
                  </p>
                </div>
              )
            }
          </div>
          {
            settlement.tariff.normalizedIsEstimate && (
              <span class="settlement-passport-detail">
                {formatTariffBase(settlement.tariff)}
              </span>
            )
          }
          {
            settlement.tariff.note && (
              <span class="settlement-passport-detail">
                {settlement.tariff.note}
              </span>
            )
          }
        </div>

        {
          hasDelta && comparison && (
            <p class="settlement-passport-comparison">
              <span class="settlement-passport-key">Сравнение с Шелково: </span>
              <span
                class:list={[
                  'ui-num',
                  'settlement-passport-delta',
                  comparison.isCheaper
                    ? 'settlement-delta-value--cheaper'
                    : 'settlement-delta-value--costlier',
                ]}
              >
                {comparison.isCheaper ? '−' : '+'}
                {formatCurrency(Math.abs(comparison.tariffDelta))}
              </span>
              , {comparison.isCheaper ? 'дешевле' : 'дороже'} на{' '}
              {formatPercentage(comparison.tariffDeltaPercent / 100, {
                signed: false,
              })}
            </p>
          )
        }

        <p class="settlement-passport-location">
          <span class="settlement-passport-key">Расположение: </span>
          {settlement.location.addressText}
          {
            distanceFromShelkovo > 0 && (
              <span>, {formatDistance(distanceFromShelkovo)} от Шелково</span>
            )
          }
        </p>
      </div>
    </section>

    <section
      class="settlement-table-section"
      data-testid="infrastructure-section"
    >
      <InfrastructureTable
        title="Инфраструктура"
        infra={settlement.infrastructure}
        shelkovoInfra={!isBaseline ? baseline.infrastructure : undefined}
        client:visible
      />
    </section>

    <section
      class="settlement-table-section"
      data-testid="common-spaces-section"
    >
      <CommonSpacesTable
        title="Общие пространства"
        spaces={settlement.commonSpaces}
        shelkovoSpaces={!isBaseline ? baseline.commonSpaces : undefined}
        client:visible
      />
    </section>

    <section class="settlement-table-section" data-testid="services-section">
      <ServiceTable
        title="Модель обслуживания"
        services={settlement.serviceModel}
        shelkovoServices={!isBaseline ? baseline.serviceModel : undefined}
        client:visible
      />
    </section>

    {
      settlement.sources.length > 0 && (
        <section
          class="settlement-sources-section"
          data-testid="sources-section"
        >
          <h2 class="settlement-sources-title">Источники</h2>
          <SourcesList sources={settlement.sources} />
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .settlement-page {
    position: relative;
    padding-bottom: 1.5rem;
  }

  .settlement-breadcrumbs.ui-page-header {
    position: relative;
    z-index: 30;
    margin-bottom: 1rem;
    padding-bottom: 0;
  }

  .settlement-hero {
    position: relative;
    z-index: 20;
    display: none;
  }

  .settlement-hero-map,
  .settlement-hero-map-canvas,
  .settlement-hero-wash-top,
  .settlement-hero-wash-bottom {
    position: absolute;
    inset: 0;
  }

  .settlement-hero-map {
    overflow: hidden;
  }

  .settlement-hero-map-canvas {
    opacity: 0.8;
  }

  .settlement-hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.25rem 1rem;
  }

  .settlement-hero-label-row {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 1rem;
  }

  .settlement-labels,
  .settlement-mobile-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .settlement-labels {
    justify-content: flex-end;
  }

  .settlement-badge-link {
    transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .settlement-badge-link:hover {
    opacity: 0.9;
  }

  .settlement-hero-summary {
    width: 100%;
    max-width: 48rem;
    align-self: flex-start;
  }

  .settlement-hero-summary--spaced {
    margin-top: 2rem;
  }

  .settlement-hero-heading {
    margin-bottom: 1rem;
  }

  .settlement-hero-title-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .settlement-hero-title-wrap,
  .settlement-mobile-title-wrap {
    min-width: 0;
  }

  .settlement-mobile-title-wrap {
    flex: 1 1 0%;
  }

  .settlement-hero-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }


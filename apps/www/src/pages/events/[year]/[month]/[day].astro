---
import type { InferGetStaticPropsType } from 'astro';
import { formatDate } from '@shelkovo/format';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import EventCard from '@/components/events/EventCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withHomeBreadcrumbs } from '@/lib/breadcrumbs';
import { loadEventsData } from '@/lib/events/load';
import { buildEventJsonLd } from '@/lib/events/seo';
import { eventMonthUrl } from '@/lib/events/urls';
import { eventPageDescription, formatEventMonth } from '@/lib/events/view';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import { absoluteUrl } from '@/lib/site';

export const getStaticPaths = async () => {
  const { calendar } = await loadEventsData();
  return calendar.days.map((day) => ({
    params: {
      year: day.date.slice(0, 4),
      month: day.date.slice(5, 7),
      day: day.date.slice(8, 10),
    },
    props: { day, month: calendar.byMonth.get(day.date.slice(0, 7))! },
  }));
};
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { day, month } = Astro.props;
const heading = formatDate(day.date);
const title = `${heading} — События — Шелково Онлайн`;
const description = eventPageDescription(heading, day.events);
const monthUrl = eventMonthUrl(month.id);
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'События', href: '/events/' },
  { label: formatEventMonth(month), href: monthUrl },
  { label: heading },
]);
const schema = day.events.map((event) =>
  buildEventJsonLd(event, absoluteUrl('/')),
);
---

<BaseLayout
  title={title}
  description={description}
  canonical={day.url}
  schema={schema}
  search={{
    scope: 'manual',
    title: `${heading} — События`,
    description,
    section: SEARCH_SECTIONS.events,
  }}
>
  <main class="ui-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="ui-page-title" data-pagefind-body>{heading}</h1>
      </div>
    </header>
    <div class="day-content">
      {day.events.map((event) => <EventCard event={event} />)}
      <p class="back-link">
        <a href={monthUrl}>← Календарь: {formatEventMonth(month)}</a>
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .day-content {
    max-width: 56rem;
    padding: 0 1.25rem 3rem;
  }
  .back-link {
    margin-top: 1rem;
  }
  .back-link a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-primary);
    text-decoration: underline;
  }
  @media (min-width: 48rem) {
    .day-content {
      padding-inline: 1.5rem;
    }
  }
</style>

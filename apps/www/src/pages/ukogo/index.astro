---
import LinkWithIcon from '@shelkovo/ui/LinkWithIcon.astro';
import InventoryPage from '@/components/inventory/InventoryPage.astro';
import InventoryKindList from '@/components/inventory/InventoryKindList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatInventoryGroupEmoji } from '@/lib/inventory/groups';
import { loadInventoryData } from '@/lib/inventory/load';
import { inventoryUrl } from '@/lib/inventory/routes';
import { inventoryContentsGroups } from '@/lib/inventory/view';
const groups = inventoryContentsGroups(await loadInventoryData());
---

<BaseLayout
  title="У кого есть — Шелково Онлайн"
  description="Инвентарь у соседей в Шелково: предложения для стройки, сада и дома, условия пользования и контакты владельцев."
  canonical={inventoryUrl()}
>
  <InventoryPage title="У кого есть">
    <p slot="intro" class="ui-copy ui-muted">
      Хотите сдать инвентарь в аренду или дать попользоваться бесплатно?{' '}
      Напишите{' '}
      <LinkWithIcon
        href="https://t.me/silentroach"
        label="silentroach"
        ariaLabel="Написать silentroach в Telegram"
      />
      .
    </p>
    <div class="inventory-contents">
      {groups.length > 0 && (
        <nav class="inventory-groups-nav" aria-label="Группы инвентаря">
          {groups.map((group) => (
            <a class="inventory-group-pill" href={`#group-${group.id}`}>
              <span aria-hidden="true">
                {formatInventoryGroupEmoji(group.id)}
              </span>{' '}
              {group.title}
            </a>
          ))}
        </nav>
      )}
      {groups.length > 0 ? (
        groups.map((group) => (
          <section
            class="inventory-group"
            aria-labelledby={`group-${group.id}`}
          >
            <h2
              id={`group-${group.id}`}
              class="ui-group-title inventory-group-title"
            >
              <a class="ui-title-link inventory-group-link" href={group.url}>
                <span class="inventory-group-emoji" aria-hidden="true">
                  {formatInventoryGroupEmoji(group.id)}
                </span>
                {group.title}
              </a>
            </h2>
            <div class="inventory-group-kinds">
              <InventoryKindList kinds={group.kinds} />
            </div>
          </section>
        ))
      ) : (
        <p class="ui-copy">В каталоге пока нет предложений.</p>
      )}
    </div>
  </InventoryPage>
</BaseLayout>

<style>
  .inventory-contents {
    margin-block-start: 2rem;
  }

  .inventory-groups-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 2.5rem;
  }

  .inventory-group-pill {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .inventory-group-pill:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .inventory-group-pill:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .inventory-group-title {
    margin-block-end: 0.5rem;
    scroll-margin-top: calc(var(--site-sticky-offset) + 1rem);
  }

  .inventory-group + .inventory-group {
    margin-block-start: 2.5rem;
  }

  .inventory-group-kinds {
    padding-block-start: 0.5rem;
    border-block-start: 1px solid var(--color-border);
  }

  .inventory-group-kinds :global(.inventory-kinds) {
    margin-block-start: 0;
  }

  .inventory-group-link {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .inventory-group-emoji {
    display: none;
  }

  @media (min-width: 48rem) {
    .inventory-group-emoji {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: 100%;
      display: inline-flex;
      width: 1.25rem;
      margin-inline-end: 0.75rem;
      font-size: 1.125rem;
      line-height: 1;
      opacity: 0.7;
      transform: translateY(-50%);
    }
  }
</style>

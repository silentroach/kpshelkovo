---
import type { GetStaticPaths } from 'astro';

import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import StatusIncidentRow from '@/components/status/StatusIncidentRow.astro';
import StatusServiceState from '@/components/status/StatusServiceState.astro';
import StatusServiceTimeline from '@/components/status/StatusServiceTimeline.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import { loadStatusService } from '@/lib/status/load';
import { STATUS_SERVICES, type StatusService } from '@/lib/status/schema';
import {
  statusServiceCanonical,
  statusServiceUrl,
  statusUrl,
} from '@/lib/status/routes';
import { toStatusTimelineIncidentInput } from '@/lib/status/timeline';
import { formatStatusService } from '@/lib/status/view';

export const getStaticPaths = (async () =>
  STATUS_SERVICES.map((service) => ({
    params: { service },
  }))) satisfies GetStaticPaths;

const serviceParam = Astro.params.service;

if (!serviceParam) {
  throw new Error('status service param is required');
}

const service = STATUS_SERVICES.find((item) => item === serviceParam) as
  StatusService | undefined;

if (!service) {
  throw new Error(`status service "${serviceParam}" not found`);
}

const summary = await loadStatusService(service);

if (!summary) {
  throw new Error(`status service "${service}" not found`);
}

const serviceLabel = formatStatusService(service);
const latestIncidents = summary.incidents.slice(0, 10);
const timelineIncidents = summary.incidents.map(toStatusTimelineIncidentInput);
const schemaItems = latestIncidents
  .filter((item) => item.hasPage)
  .map((item) => ({ name: item.title, url: item.url }));
const title = `${serviceLabel} — Статус — Шелково Онлайн`;
const description = `Текущее состояние сервиса ${serviceLabel.toLowerCase()} в КП Шелково: последние инциденты, плановые работы и история изменений.`;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Статус', href: statusUrl() },
  { label: serviceLabel },
]);
const schema = collectionPageSchema({
  name: title,
  description,
  url: statusServiceUrl(service),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Статус', url: statusUrl() },
    { name: serviceLabel, url: statusServiceUrl(service) },
  ]),
  items: schemaItems,
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={statusServiceCanonical(service)}
  keywords={['статус Шелково', serviceLabel, `${serviceLabel} Шелково`]}
  schema={schema}
>
  <main class="ui-page status-service-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack status-service-header">
        <Breadcrumbs items={breadcrumbs} />

        <div>
          <h1 class="ui-page-title">
            {serviceLabel}
          </h1>
        </div>
      </div>
    </header>

    <section class="status-service-overview">
      <div class="status-service-content status-service-overview__content">
        <div class="status-service-state">
          <StatusServiceState summary={summary} />
        </div>
        <StatusServiceTimeline
          service={summary.service}
          incidents={timelineIncidents}
          timelineDays={90}
        />
      </div>
    </section>

    <section class="status-service-history">
      <div class="status-service-content status-service-history__content">
        <div>
          <h2 class="ui-section-title">История</h2>
        </div>

        {
          latestIncidents.length > 0 ? (
            <div class="status-service-history__rows">
              {latestIncidents.map((incident) => (
                <StatusIncidentRow incident={incident} />
              ))}
            </div>
          ) : (
            <p class="status-service-history__empty">
              Пока без записей по этому сервису.
            </p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-service-page {
    padding-block-end: 1.5rem;
  }

  .status-service-header {
    max-width: 56rem;
  }

  .status-service-overview,
  .status-service-history {
    padding-inline: 1.25rem;
  }

  .status-service-overview {
    margin-block-start: 2rem;
  }

  .status-service-content {
    max-width: 72rem;
  }

  .status-service-overview__content > * + * {
    margin-block-start: 0.75rem;
  }

  .status-service-state :global([data-status-service-state-label]) {
    font-size: 1rem;
    font-weight: 600;
  }

  .status-service-history {
    margin-block-start: 3rem;
  }

  .status-service-history__content > * + * {
    margin-block-start: 1rem;
  }

  .status-service-history__rows {
    margin-inline: -1.25rem;
  }

  .status-service-history__empty {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  @media (min-width: 48rem) {
    .status-service-page {
      padding-block-end: 2.5rem;
    }

    .status-service-overview,
    .status-service-history {
      padding-inline: 1.5rem;
    }

    .status-service-history {
      margin-block-start: 3.5rem;
    }

    .status-service-history__rows {
      margin-inline: -1.5rem;
    }

    .status-service-history__empty {
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 64rem) {
    .status-service-page {
      padding-block-end: 3rem;
    }
  }
</style>

---
import StatusIncidentRow from '@/components/status/StatusIncidentRow.astro';
import StatusServiceCard from '@/components/status/StatusServiceCard.astro';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import { CalendarIcon } from '@shelkovo/ui/icons';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import { loadStatusData } from '@/lib/status/load';
import {
  statusCalendarYearUrl,
  statusHistoryUrl,
  statusServiceUrl,
  statusUrl,
} from '@/lib/status/routes';

const data = await loadStatusData();
const now = Date.now();
const calendarYear = data.calendar.buildYear;
const calendarHeading = `Проблемы и плановые работы за ${calendarYear} год`;
const overviewTimelineDays = 30;
const mobileOverviewTimelineDays = 7;
const recentIncidents = data.incidents.slice(0, 10);
const activeIncidents = data.active.filter((item) => item.kind === 'incident');
const plannedWorks = data.incidents.filter(
  (item) =>
    item.kind === 'maintenance' &&
    (item.phase === 'active' || item.started.at.valueOf() > now),
);
const title = 'Статус поселка — Шелково Онлайн';
const description =
  'Текущее состояние сервисов КП Шелково: отключения, ограничения интернета, плановые работы и история изменений.';
const keywords = [
  'статус Шелково',
  'статус КП Шелково',
  'сервисы Шелково',
  'плановые работы Шелково',
  'история инцидентов Шелково',
];
const breadcrumbs = withHomeBreadcrumbs([{ label: 'Статус' }]);
const historySchemaItems = recentIncidents.map((item) => ({
  name: item.title,
  url: item.url,
}));
const schema = collectionPageSchema({
  name: title,
  description,
  url: statusUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Статус', url: statusUrl() },
  ]),
  items: historySchemaItems,
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={statusUrl()}
  keywords={keywords}
  schema={schema}
>
  <main class="ui-page status-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack status-header">
        <Breadcrumbs items={breadcrumbs} />

        <div class="status-header__copy" data-status-page-header-copy>
          <div class="status-title-row">
            <h1 class="ui-page-title">Статус КП Шелково</h1>

            <span class="status-calendar-entry">
              <a
                class="ui-btn ui-icon-action"
                href={statusCalendarYearUrl({ year: calendarYear })}
                aria-label={calendarHeading}
                title={calendarHeading}
                data-status-calendar-entry
              >
                <CalendarIcon />
              </a>
            </span>
          </div>

          <p class="status-intro">
            Журнал отключений и ограничений в КП Шелково: электричество, вода,
            интернет и проезд через дамбу. Фиксируем время, зону, источник и ход
            восстановления.
          </p>
        </div>
      </div>
    </section>

    <section class="status-services" aria-labelledby="status-services-title">
      <div class="status-content">
        <h2 id="status-services-title" class="ui-visually-hidden">
          Сводка по сервисам
        </h2>

        <div>
          <div class="status-services__header">
            <p>Сервис</p>
            <p>Хронология за месяц</p>
            <p>Статус</p>
            <p>Последняя запись</p>
          </div>

          <div>
            {
              data.services.map((summary) => (
                <StatusServiceCard
                  summary={summary}
                  serviceHref={statusServiceUrl(summary.service)}
                  timelineDays={overviewTimelineDays}
                  mobileTimelineDays={mobileOverviewTimelineDays}
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      activeIncidents.length > 0 && (
        <section class="status-section">
          <div class="status-section__content">
            <div class="status-section__heading">
              <h2 class="ui-section-title">Активные инциденты</h2>
              <p class="status-section__description">
                Отключения и ограничения, которые еще не закрыты.
              </p>
            </div>

            <div class="status-rows">
              {activeIncidents.map((incident) => (
                <StatusIncidentRow incident={incident} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      plannedWorks.length > 0 && (
        <section class="status-section">
          <div class="status-section__content">
            <div>
              <h2 class="ui-section-title">Плановые работы</h2>
              <p class="status-section__description">
                Запланированные или уже идущие работы по сервисам поселка.
              </p>
            </div>

            <div class="status-rows">
              {plannedWorks.map((incident) => (
                <StatusIncidentRow incident={incident} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section
      class="status-section"
      aria-labelledby="status-history-title"
      data-status-history
    >
      <div class="status-section__content">
        <div>
          <h2 id="status-history-title" class="ui-section-title">
            Последние записи
          </h2>
        </div>

        <div class="status-rows">
          {
            recentIncidents.map((incident) => (
              <StatusIncidentRow incident={incident} />
            ))
          }
        </div>

        <p>
          <a class="ui-link status-history-link" href={statusHistoryUrl()}>
            Вся история статусов
          </a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-page {
    padding-block-end: 1.5rem;
  }

  .status-header {
    max-width: 56rem;
  }

  .status-header__copy > * + * {
    margin-block-start: 0.75rem;
  }

  .status-title-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .status-calendar-entry {
    display: inline-flex;
    transform: translateY(0.25rem);
  }

  .status-intro {
    max-width: 48rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .status-services {
    margin-block-start: 2rem;
  }

  .status-content {
    max-width: 72rem;
  }

  .status-services__header {
    display: none;
  }

  .status-section {
    margin-block-start: 3rem;
    padding-inline: 1.25rem;
  }

  .status-section__content > * + * {
    margin-block-start: 1rem;
  }

  .status-section__heading > * + *,
  .status-section__description {
    margin-block-start: 0.375rem;
  }

  .status-section__description {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .status-rows {
    margin-inline: -1.25rem;
  }

  .status-history-link {
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .status-page {
      padding-block-end: 2.5rem;
    }

    .status-title-row {
      gap: 1.75rem;
    }

    .status-calendar-entry {
      transform: translateY(0.375rem);
    }

    .status-section {
      margin-block-start: 3.5rem;
      padding-inline: 1.5rem;
    }

    .status-section__description {
      font-size: 0.9375rem;
    }

    .status-rows {
      margin-inline: -1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .status-page {
      padding-block-end: 3rem;
    }

    .status-services__header {
      display: grid;
      grid-template-columns:
        minmax(0, 15rem) minmax(0, 1fr) minmax(0, 11rem)
        minmax(0, 21rem);
      gap: 1.5rem;
      padding: 0.75rem 1.5rem;
    }

    .status-services__header p {
      color: var(--color-text-muted);
      font-size: 0.875rem;
      font-weight: 600;
    }
  }
</style>

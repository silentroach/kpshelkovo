---
import type { GetStaticPaths } from 'astro';
import { formatDate, formatMonth } from '@shelkovo/format';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import StatusCalendarDayMarker from '@/components/status/StatusCalendarDayMarker.astro';
import StatusIncidentRow from '@/components/status/StatusIncidentRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withHomeBreadcrumbs } from '@/lib/breadcrumbs';
import { getStatusMonthJournal } from '@/lib/status/journal';
import { loadStatusData } from '@/lib/status/load';
import {
  statusCalendarMonthCanonical,
  statusCalendarMonthStaticPaths,
  statusCalendarYearUrl,
  statusUrl,
} from '@/lib/status/routes';
import { formatStatusMonth } from '@/lib/status/view';

export const getStaticPaths = (async () => {
  const data = await loadStatusData();

  return statusCalendarMonthStaticPaths(data.calendar);
}) satisfies GetStaticPaths;

const year = Number(Astro.params.year);
const month = Number(Astro.params.month);
const journal = getStatusMonthJournal(await loadStatusData(), year, month);

if (!journal) {
  throw new Error(
    `status calendar month "${Astro.params.year}/${Astro.params.month}" not found`,
  );
}

const monthLabel = formatStatusMonth(journal.year, journal.month);
const breadcrumbMonth = formatMonth(journal.year, journal.month, {
  includeYear: false,
});
const monthName = `${breadcrumbMonth.charAt(0).toLocaleUpperCase('ru')}${breadcrumbMonth.slice(1)}`;
const heading = `Статусы за ${monthLabel} года`;
const title = `${heading} — Шелково Онлайн`;
const description = `Отключения, ограничения и плановые работы в Шелково за ${monthLabel} года — по дням от новых к старым.`;
const canonical = statusCalendarMonthCanonical(journal);
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Статус', href: statusUrl() },
  {
    label: String(journal.year),
    href: statusCalendarYearUrl({ year: journal.year }),
  },
  { label: monthName },
]);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <main class="ui-page status-calendar-month-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack status-calendar-month-header">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="ui-page-title">{heading}</h1>
      </div>
    </header>

    <div class="status-calendar-month" data-status-calendar-month={journal.id}>
      {
        journal.days.map(({ day, incidents }, dayIndex) => (
          <section
            class:list={[
              'status-calendar-day',
              dayIndex > 0 && 'status-calendar-day--divided',
            ]}
            data-status-calendar-day={day.id}
          >
            <h2
              id={day.id}
              tabindex="-1"
              class="ui-group-title status-calendar-day__heading"
            >
              <StatusCalendarDayMarker kind={day.kind} />
              <time datetime={day.id}>{formatDate(day.id)}</time>
            </h2>

            <div class="status-calendar-day-records">
              {incidents.map((incident) => (
                <StatusIncidentRow incident={incident} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .status-calendar-month-page {
    padding-block-end: 1.5rem;
  }

  .status-calendar-month-header {
    max-width: 56rem;
  }

  .status-calendar-month {
    margin-block-start: 2rem;
  }

  .status-calendar-day {
    padding-block: 1.5rem 0.5rem;
  }

  .status-calendar-day--divided {
    border-block-start: 1px solid var(--color-border-strong);
  }

  .status-calendar-day__heading {
    display: flex;
    width: fit-content;
    scroll-margin-block-start: calc(var(--site-sticky-offset) + 1rem);
    align-items: center;
    gap: 0.75rem;
    padding-inline: 1.25rem;
  }

  .status-calendar-day-records {
    margin-block-start: 1rem;
  }

  .status-calendar-day:has(> h2:target) {
    background: var(--color-primary-soft-2);
  }

  .status-calendar-day > h2:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 0.35rem;
  }

  :global(.status-calendar-day-records > article) {
    border-top: 0;
  }

  @media (min-width: 48rem) {
    .status-calendar-month-page {
      padding-block-end: 2.5rem;
    }

    .status-calendar-day__heading {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .status-calendar-month-page {
      padding-block-end: 3rem;
    }
  }
</style>

<script>
  import { installStatusCalendarMonthFocus } from '@/lib/status/month-calendar.dom';

  installStatusCalendarMonthFocus();
</script>

---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import StatusCalendarLegend from '@/components/status/StatusCalendarLegend.astro';
import StatusCalendarYearMonth from '@/components/status/StatusCalendarYearMonth.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withHomeBreadcrumbs } from '@/lib/breadcrumbs';
import {
  availableStatusCalendarYears,
  buildStatusCalendarYearGrid,
} from '@/lib/status/calendar';
import { loadStatusData } from '@/lib/status/load';
import {
  statusCalendarYearCanonical,
  statusCalendarYearStaticPaths,
  statusCalendarYearUrl,
  statusUrl,
} from '@/lib/status/routes';

export const getStaticPaths = (async () =>
  statusCalendarYearStaticPaths(
    (await loadStatusData()).calendar,
  )) satisfies GetStaticPaths;

const data = await loadStatusData();
const year = Number(Astro.params.year);
const years = availableStatusCalendarYears(data.calendar);
const yearIndex = years.indexOf(year);
const previousYear = yearIndex > 0 ? years[yearIndex - 1] : undefined;
const nextYear = yearIndex >= 0 ? years[yearIndex + 1] : undefined;
const calendar = buildStatusCalendarYearGrid(data.calendar, year);
const heading = `Проблемы и плановые работы за ${year} год`;
const title = `${heading} — Шелково Онлайн`;
const description = `Проблемы и плановые работы в Шелково по дням за ${year} год с переходом к месячным журналам.`;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Статус', href: statusUrl() },
  { label: `${year} год` },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonical={statusCalendarYearCanonical({ year })}
>
  <main class="ui-page status-calendar-year-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack status-calendar-year-header">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="ui-page-title">{heading}</h1>
      </div>
    </header>

    <div class="status-calendar-year-content">
      <div class="status-calendar-year-grid" data-status-calendar-year={year}>
        {
          calendar.months.map((month) => (
            <StatusCalendarYearMonth month={month} />
          ))
        }
      </div>
      <status-year-calendar-lifecycle hidden></status-year-calendar-lifecycle>

      <StatusCalendarLegend />

      <nav
        aria-label="Переключение лет"
        class="status-calendar-year-navigation"
        data-status-calendar-year-navigation
      >
        {
          previousYear !== undefined ? (
            <a
              href={statusCalendarYearUrl({ year: previousYear })}
              aria-label={`Календарь за ${previousYear} год`}
              class="ui-btn ui-btn-sm ui-btn-ghost ui-num status-calendar-year-navigation__button"
              data-status-calendar-previous
            >
              <span aria-hidden="true">←</span>
              <span>{previousYear}</span>
            </a>
          ) : (
            <button
              type="button"
              disabled
              aria-label="Нет данных за предыдущий год"
              class="ui-btn ui-btn-sm ui-btn-ghost ui-num status-calendar-year-navigation__button"
              data-status-calendar-previous
            >
              <span aria-hidden="true">←</span>
            </button>
          )
        }

        <span
          class="ui-num status-calendar-year-navigation__current"
          aria-current="page"
        >
          {year}
        </span>

        {
          nextYear !== undefined ? (
            <a
              href={statusCalendarYearUrl({ year: nextYear })}
              aria-label={`Календарь за ${nextYear} год`}
              class="ui-btn ui-btn-sm ui-btn-ghost ui-num status-calendar-year-navigation__button"
              data-status-calendar-next
            >
              <span>{nextYear}</span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <button
              type="button"
              disabled
              aria-label="Нет данных за следующий год"
              class="ui-btn ui-btn-sm ui-btn-ghost ui-num status-calendar-year-navigation__button"
              data-status-calendar-next
            >
              <span aria-hidden="true">→</span>
            </button>
          )
        }
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .status-calendar-year-page {
    padding-block-end: 2rem;
  }

  .status-calendar-year-header {
    max-width: 56rem;
  }

  .status-calendar-year-content {
    margin-block-start: 1rem;
    padding-inline: 1.25rem;
  }

  .status-calendar-year-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 2rem;
    row-gap: 2.5rem;
  }

  .status-calendar-year-navigation {
    display: flex;
    width: 100%;
    max-width: 28rem;
    margin-block-start: 2rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .status-calendar-year-navigation__button {
    width: 6rem;
    min-height: 2.5rem;
  }

  .status-calendar-year-navigation__button:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 2px;
  }

  .status-calendar-year-navigation__current {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.75rem;
  }

  @media (min-width: 48rem) {
    .status-calendar-year-page {
      padding-block-end: 3rem;
    }

    .status-calendar-year-content {
      padding-inline: 1.5rem;
    }

    .status-calendar-year-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .status-calendar-year-page {
      padding-block-end: 4rem;
    }
  }

  @media (min-width: 80rem) {
    .status-calendar-year-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { registerStatusCalendarYearInteractions } from '@/lib/status/year-calendar.dom';

  registerStatusCalendarYearInteractions();
</script>

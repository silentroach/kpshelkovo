---
import type { GetStaticPaths } from 'astro';
import { padNumber } from '@shelkovo/format';

import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import StatusIncidentMeta from '@/components/status/StatusIncidentMeta.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import {
  loadStatusIncidentDetail,
  loadStatusIncidentDetails,
} from '@/lib/status/load';
import { statusUrl } from '@/lib/status/routes';
import { techArticleSchema } from '@/lib/news/seo';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const incidents = await loadStatusIncidentDetails();

  return incidents.map((item) => ({
    params: {
      year: String(item.year),
      month: padNumber(item.month),
      entry: item.slug,
    },
  }));
}) satisfies GetStaticPaths;

const year = Astro.params.year;
const month = Astro.params.month;
const entry = Astro.params.entry;

if (!year || !month || !entry) {
  throw new Error('status incident params are required');
}

const id = `${year}/${month}/${entry}`;
const incident = await loadStatusIncidentDetail(id);

if (!incident) {
  throw new Error(`status incident "${id}" not found`);
}

const bodyHtml = incident.body ? renderMarkdown(incident.body) : undefined;
const title = `${incident.title} — Шелково Онлайн`;
const excerptSentence = incident.excerpt?.match(/^[^.!?]+[.!?]/u)?.[0];
const fallbackDescription =
  (incident.excerpt && incident.excerpt.length <= 170
    ? incident.excerpt
    : excerptSentence) ??
  'Подробная запись о статусе сервиса в КП Шелково: что произошло, когда началось и чем закончилось.';
const description = incident.seo?.description ?? fallbackDescription;
const search = {
  scope: 'page',
  title: incident.title,
  description,
  section: SEARCH_SECTIONS.status,
  publishedAt: incident.started.iso.slice(0, 10),
} satisfies SearchDocument;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Статус', href: statusUrl() },
  { label: incident.title },
]);
const schema = techArticleSchema({
  name: incident.title,
  description,
  url: incident.url,
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Статус', url: statusUrl() },
    { name: incident.title, url: incident.url },
  ]),
  datePublished: incident.started.iso,
  dateModified: incident.ended?.iso,
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={incident.url}
  type="article"
  keywords={['статус Шелково', incident.title, 'инцидент Шелково']}
  schema={schema}
  search={search}
>
  <main class="ui-page status-incident-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack status-incident-header">
        <Breadcrumbs items={breadcrumbs} />

        <div class="status-incident-header__summary">
          <h1 class="ui-page-title">
            {incident.title}
          </h1>

          <StatusIncidentMeta incident={incident} variant="prominent" />
        </div>
      </div>
    </header>

    {
      incident.body && (
        <article class="status-incident-body">
          <div class="ui-prose" set:html={bodyHtml} />
        </article>
      )
    }
  </main>
</BaseLayout>

<style>
  .status-incident-page {
    padding-block-end: 2rem;
  }

  .status-incident-header {
    max-width: 56rem;
  }

  .status-incident-header__summary > :global(:not(:last-child)) {
    margin-block-end: 0.875rem;
  }

  .status-incident-body {
    padding-inline: 1.25rem;
  }

  @media (min-width: 48rem) {
    .status-incident-page {
      padding-block-end: 3rem;
    }

    .status-incident-body {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .status-incident-page {
      padding-block-end: 3.5rem;
    }
  }
</style>

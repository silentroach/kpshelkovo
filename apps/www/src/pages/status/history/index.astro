---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import StatusIncidentRow from '@/components/status/StatusIncidentRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { collectionPageSchema } from '@/lib/json-ld';
import { loadStatusData } from '@/lib/status/load';
import {
  statusCalendarYearUrl,
  statusHistoryUrl,
  statusMarkdownUrl,
  statusUrl,
} from '@/lib/status/routes';

const data = await loadStatusData();
const title = 'История статусов — Шелково Онлайн';
const description =
  'Полная история отключений, ограничений и плановых работ по сервисам КП Шелково: электричество, вода, интернет и проезд через дамбу.';
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Статус', href: statusUrl() },
  { label: 'История' },
]);
const historySchemaItems = data.incidents.map((item) => ({
  name: item.title,
  url: item.url,
}));
const schema = collectionPageSchema({
  name: title,
  description,
  url: statusHistoryUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Статус', url: statusUrl() },
    { name: 'История', url: statusHistoryUrl() },
  ]),
  items: historySchemaItems,
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={statusHistoryUrl()}
  markdownAlternate={statusMarkdownUrl()}
  keywords={['история статусов Шелково', 'архив отключений Шелково']}
  schema={schema}
>
  <main class="ui-page status-history-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack status-history-header">
        <Breadcrumbs items={breadcrumbs} />

        <div class="status-history-header__copy">
          <h1 class="ui-page-title">История статусов</h1>
          <p class="status-history-intro">
            Все записи об отключениях, ограничениях и плановых работах — от
            новых к старым.
          </p>
          <nav aria-label="Представление истории статусов">
            <a
              class="ui-link status-history-calendar"
              href={statusCalendarYearUrl({ year: data.calendar.buildYear })}
              data-status-history-calendar
            >
              Календарь
            </a>
          </nav>
        </div>
      </div>
    </section>

    <section
      class="status-history"
      aria-labelledby="status-history-title"
      data-status-history
    >
      <h2 id="status-history-title" class="ui-visually-hidden">Все записи</h2>

      <div class="status-history__rows">
        {
          data.incidents.map((incident) => (
            <StatusIncidentRow incident={incident} />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .status-history-page {
    padding-block-end: 1.5rem;
  }

  .status-history-header {
    max-width: 56rem;
  }

  .status-history-header__copy > * + * {
    margin-block-start: 0.75rem;
  }

  .status-history-intro {
    max-width: 48rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .status-history-calendar {
    font-weight: 600;
  }

  .status-history {
    margin-block-start: 2rem;
    padding-inline: 1.25rem;
  }

  .status-history__rows {
    margin-inline: -1.25rem;
  }

  @media (min-width: 48rem) {
    .status-history-page {
      padding-block-end: 2.5rem;
    }

    .status-history {
      padding-inline: 1.5rem;
    }

    .status-history__rows {
      margin-inline: -1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .status-history-page {
      padding-block-end: 3rem;
    }
  }
</style>

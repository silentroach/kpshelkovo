---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import ContactMethods from '@/components/contacts/ContactMethods.astro';
import ContactReviews from '@/components/contacts/ContactReviews.astro';
import ContactVcfLink from '@/components/contacts/ContactVcfLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { loadContact, loadContacts } from '@/lib/contacts/load';
import { contactCategoryUrl, contactsUrl } from '@/lib/contacts/routes';
import { contactPageSchema } from '@/lib/contacts/seo';
import { formatContactCategory } from '@/lib/contacts/view';
import { renderMarkdown } from '@/lib/markdown/render';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const contacts = await loadContacts();

  return contacts.map((contact) => ({
    params: { category: contact.category, slug: contact.slug },
  }));
}) satisfies GetStaticPaths;

const categoryKey = Astro.params.category;
const slug = Astro.params.slug;

if (!categoryKey || !slug) {
  throw new Error('contact category and slug are required');
}

const contact = await loadContact(categoryKey, slug);

if (!contact) {
  throw new Error(`contact "${categoryKey}/${slug}" not found`);
}

const category = formatContactCategory(contact.category);
const title = `${contact.title} — ${category} — Сарафан — Шелково Онлайн`;
const description =
  contact.seo?.description ??
  `Контакт из раздела «Сарафан»: ${category}. Перед обращением уточняйте цену, сроки и состав работ.`;
const search = {
  scope: 'manual',
  title: contact.title,
  description,
  section: SEARCH_SECTIONS.sarafan,
  aliases: contact.searchAliases,
} satisfies SearchDocument;
const bodyHtml = renderMarkdown(contact.body || contact.summary || description);
const categoryUrl = contactCategoryUrl({ category: contact.category });
const reviewsHeadingId = 'contact-reviews';
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Сарафан', href: contactsUrl() },
  { label: category, href: categoryUrl },
  { label: contact.title },
]);
const schema = contactPageSchema({
  contact,
  description,
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Сарафан', url: contactsUrl() },
    { name: category, url: categoryUrl },
    { name: contact.title, url: contact.url },
  ]),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={contact.url}
  keywords={['сарафан Шелково', contact.title, category]}
  schema={schema}
  search={search}
>
  <main class="ui-page sarafan-contact-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack sarafan-contact-header">
        <Breadcrumbs items={breadcrumbs} linkLast />

        <div class="sarafan-contact-heading">
          <h1 class="ui-page-title" data-pagefind-ignore="all">
            {contact.title}
          </h1>
          {
            contact.vcf ? (
              <span class="sarafan-contact-vcf">
                <ContactVcfLink vcf={contact.vcf} />
              </span>
            ) : null
          }
        </div>
      </div>
    </header>

    <article class="sarafan-contact-content">
      <div data-pagefind-ignore="all">
        <ContactMethods
          contacts={contact.contacts}
          location={contact.location}
        />
      </div>
      <div
        class="ui-prose sarafan-contact-prose"
        data-pagefind-body
        set:html={bodyHtml}
      />
      {
        contact.reviews.length > 0 ? (
          <section class="sarafan-contact-reviews" data-pagefind-ignore="all">
            <h2 id={reviewsHeadingId} class="ui-prose-title">
              Отзывы
            </h2>
            <ContactReviews
              reviews={contact.reviews}
              labelledBy={reviewsHeadingId}
            />
          </section>
        ) : null
      }
    </article>
  </main>
</BaseLayout>

<style>
  .sarafan-contact-page {
    padding-block-end: 2rem;
  }

  .sarafan-contact-header {
    max-width: 56rem;
  }

  .sarafan-contact-heading {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .sarafan-contact-vcf {
    display: inline-flex;
    transform: translateY(0.25rem);
  }

  .sarafan-contact-content {
    padding-inline: 1.25rem;
  }

  .sarafan-contact-content > :global(:not(:last-child)) {
    margin-block-end: 2rem;
  }

  .sarafan-contact-prose,
  .sarafan-contact-reviews {
    max-width: 65ch;
  }

  .sarafan-contact-reviews > :global(:not(:last-child)) {
    margin-block-end: 0.75rem;
  }

  @media (min-width: 48rem) {
    .sarafan-contact-page {
      padding-block-end: 3rem;
    }

    .sarafan-contact-heading {
      gap: 1.75rem;
    }

    .sarafan-contact-vcf {
      transform: translateY(0.375rem);
    }

    .sarafan-contact-content {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .sarafan-contact-page {
      padding-block-end: 3.5rem;
    }
  }
</style>

---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import ContactListItem from '@/components/contacts/ContactListItem.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { loadContactsData } from '@/lib/contacts/load';
import { contactsUrl } from '@/lib/contacts/routes';
import { contactsCollectionPageSchema } from '@/lib/contacts/seo';
import {
  CONTACTS_CHAT_LABEL,
  CONTACTS_CHAT_URL,
  CONTACTS_EMPTY_MESSAGE,
  CONTACTS_INTRO_PREFIX,
  CONTACTS_INTRO_SUFFIX,
  CONTACTS_NEIGHBOR_TABLE_LABEL,
  CONTACTS_NEIGHBOR_TABLE_PREFIX,
  CONTACTS_NEIGHBOR_TABLE_SUFFIX,
  CONTACTS_NEIGHBOR_TABLE_URL,
  formatContactCategory,
  formatContactCategoryEmoji,
} from '@/lib/contacts/view';

const data = await loadContactsData();
const title = 'Сарафан — Шелково Онлайн';
const description =
  'Контакты, которыми поделились жители Шелково. Сайт публикует контекст и способы связи, но не гарантирует качество работ.';
const breadcrumbs = withHomeBreadcrumbs([{ label: 'Сарафан' }]);
const schema = contactsCollectionPageSchema({
  name: title,
  description,
  url: contactsUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Сарафан', url: contactsUrl() },
  ]),
  items: data.categories.map((category) => ({
    name: formatContactCategory(category.category),
    url: category.url,
  })),
});

const sectionId = (category: string): string => category;
---

<BaseLayout
  title={title}
  description={description}
  canonical={contactsUrl()}
  keywords={['сарафан Шелково', 'контакты Шелково']}
  schema={schema}
>
  <main class="ui-page sarafan-page">
    <section class="ui-page-header">
      <div class="ui-page-header-stack sarafan-header">
        <Breadcrumbs items={breadcrumbs} />

        <div>
          <h1 class="ui-page-title">Сарафан</h1>
          <p class="ui-copy sarafan-intro">
            {CONTACTS_INTRO_PREFIX}<a
              href={CONTACTS_CHAT_URL}
              class="site-text-link">{CONTACTS_CHAT_LABEL}</a
            >{CONTACTS_INTRO_SUFFIX}{CONTACTS_NEIGHBOR_TABLE_PREFIX}<a
              href={CONTACTS_NEIGHBOR_TABLE_URL}
              class="site-text-link">{CONTACTS_NEIGHBOR_TABLE_LABEL}</a
            >{CONTACTS_NEIGHBOR_TABLE_SUFFIX}
          </p>
        </div>
      </div>
    </section>

    <section class="sarafan-content">
      <h2 class="ui-visually-hidden">Категории сарафана</h2>
      {
        data.categories.length > 0 ? (
          <div class="sarafan-categories">
            {data.categories.map((category) => (
              <a
                href={`#${sectionId(category.category)}`}
                class="sarafan-category-pill"
              >
                <span aria-hidden="true">
                  {formatContactCategoryEmoji(category.category)}
                </span>{' '}
                {formatContactCategory(category.category)}
              </a>
            ))}
          </div>
        ) : null
      }

      {
        data.categories.length > 0 ? (
          <div class="sarafan-groups">
            {data.categories.map((category) => {
              const label = formatContactCategory(category.category);

              return (
                <section aria-labelledby={sectionId(category.category)}>
                  <div class="sarafan-group-heading">
                    <h2
                      id={sectionId(category.category)}
                      class="ui-group-title sarafan-group-title"
                    >
                      <a href={category.url} class="ui-link sarafan-group-link">
                        <span aria-hidden="true" class="sarafan-group-emoji">
                          {formatContactCategoryEmoji(category.category)}
                        </span>
                        {label}
                      </a>
                    </h2>
                  </div>

                  <div class="sarafan-contact-list">
                    <div class="sarafan-contact-grid">
                      {category.contacts.map((contact) => (
                        <ContactListItem contact={contact} />
                      ))}
                    </div>
                  </div>
                </section>
              );
            })}
          </div>
        ) : (
          <div class="ui-shell sarafan-empty">
            <p class="ui-copy sarafan-empty__message">
              {CONTACTS_EMPTY_MESSAGE}
            </p>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>

<style>
  .sarafan-page {
    padding-block-end: 2rem;
  }

  .sarafan-header {
    max-width: 56rem;
  }

  .sarafan-intro {
    max-width: 48rem;
    margin-block-start: 0.75rem;
    color: var(--color-text-muted);
  }

  .sarafan-content {
    margin-block-start: 2rem;
  }

  .sarafan-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 2rem;
    padding-inline: 1.25rem;
  }

  .sarafan-category-pill {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5rem;
    transition:
      border-color 150ms cubic-bezier(0.4, 0, 0.2, 1),
      color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sarafan-category-pill:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .sarafan-category-pill:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .sarafan-groups > :global(:not(:last-child)) {
    margin-block-end: 2.5rem;
  }

  .sarafan-group-heading {
    margin-block-end: 0.5rem;
    padding-inline: 1.25rem;
  }

  .sarafan-group-title {
    scroll-margin-top: calc(var(--site-sticky-offset) + 1rem);
  }

  .sarafan-group-link {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .sarafan-group-emoji {
    display: none;
  }

  .sarafan-contact-list {
    margin-inline-start: 1.25rem;
    padding-inline-end: 1.25rem;
    border-block-start: 1px solid var(--color-border);
  }

  .sarafan-contact-grid {
    display: grid;
    column-gap: 2rem;
  }

  .sarafan-empty {
    padding: 1.5rem 1.25rem;
  }

  .sarafan-empty__message {
    max-width: 48rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .sarafan-page {
      padding-block-end: 3rem;
    }

    .sarafan-categories,
    .sarafan-group-heading {
      padding-inline: 1.5rem;
    }

    .sarafan-group-emoji {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: 100%;
      display: inline-flex;
      width: 1.25rem;
      align-items: center;
      margin-inline-end: 0.75rem;
      font-size: 1.125rem;
      line-height: 1;
      opacity: 0.7;
      transform: translateY(-50%);
    }

    .sarafan-contact-list {
      margin-inline-start: 1.5rem;
      padding-inline-end: 1.5rem;
    }

    .sarafan-contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sarafan-empty {
      padding: 1.75rem 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .sarafan-page {
      padding-block-end: 3.5rem;
    }
  }
</style>

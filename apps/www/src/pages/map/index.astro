---
import PlaceMap from '@/components/places/PlaceMap.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { prepareEditorialGeometry } from '@/lib/geometry/editorial-view';
import { loadPlaces } from '@/lib/places/load';
import { selectMapPlaces } from '@/lib/places/map-selection';
import type { PlaceMapItem } from '@/lib/places/map-types';
import { placesUrl } from '@/lib/places/routes';

const places = selectMapPlaces(await loadPlaces());
const mapPlaces: readonly PlaceMapItem[] = places.map((place) => ({
  slug: place.slug,
  name: place.name,
  marker: place.marker,
  status: place.status,
  coordinates: place.coordinates,
  geometry: place.geometry
    ? prepareEditorialGeometry(place.geometry)
    : undefined,
  openingHours: place.openingHours,
  url: place.url,
}));
const title = 'Карта — Шелково Онлайн';
const description =
  'Места и границы участков Шелково на общей карте. Найдите участок по номеру застройщика или откройте карточку места.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: placesUrl(),
  inLanguage: 'ru-RU',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: places.length,
    itemListElement: places.map((place, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: place.name,
      item: place.canonical,
    })),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={placesUrl()}
  schema={schema}
  preconnectYandexMaps
  showSiteFooter={false}
  overlaySiteHeader
>
  <main class="map-page">
    <h1 class="ui-visually-hidden">Карта мест и объектов Шелково</h1>
    <PlaceMap places={mapPlaces} client:load />

    <noscript>
      <div class="map-fallback">
        <p class="map-fallback__copy">
          Для карты нужен JavaScript. <a
            href={places[0]?.url ?? placesUrl()}
            class="site-text-link map-fallback__link"
            >{
              places[0]
                ? `Открыть карточку «${places[0].name}»`
                : 'Открыть раздел'
            }</a
          >.
        </p>
      </div>
    </noscript>
  </main>
</BaseLayout>

<style>
  .map-page {
    position: relative;
    height: 100svh;
    min-height: 30rem;
    overflow: hidden;
  }

  .map-fallback {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 30;
    border: 1px solid var(--color-border);
    padding: 1rem;
    background: var(--color-surface);
  }

  .map-fallback__copy {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .map-fallback__link {
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .map-fallback {
      right: auto;
      bottom: 1.5rem;
      left: 1.5rem;
      max-width: 24rem;
    }
  }
</style>

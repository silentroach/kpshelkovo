---
import type { GetStaticPaths } from 'astro';

import { formatDynamicHtml } from '@shelkovo/markdown';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import PlaceOpeningHours from '@/components/places/PlaceOpeningHours.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withHomeBreadcrumbs } from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import { loadPlace, loadPlaces } from '@/lib/places/load';
import { placesUrl } from '@/lib/places/routes';
import {
  formatPlaceCategory,
  formatPlaceEvidenceDate,
  formatPlaceStatus,
} from '@/lib/places/view';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const places = await loadPlaces();

  return places.map((place) => ({ params: { slug: place.slug } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;

if (!slug) {
  throw new Error('place slug is required');
}

const place = await loadPlace(slug);

if (!place) {
  throw new Error(`place "${slug}" not found`);
}

const title = `${place.name} — Карта — Шелково Онлайн`;
const description = `${place.summary}. Адрес: ${place.address}.`;
const summaryHtml = formatDynamicHtml(place.summary);
const bodyHtml = place.body ? renderMarkdown(place.body) : undefined;
const addressHtml = formatDynamicHtml(place.address);
const category = formatPlaceCategory(place.category);
const status = formatPlaceStatus(place.status);
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Карта', href: placesUrl() },
  { label: place.name },
]);
const search = {
  scope: 'page',
  title: place.name,
  description,
  section: SEARCH_SECTIONS.places,
} satisfies SearchDocument;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: place.name,
  description: place.summary,
  url: place.canonical,
  address: place.address,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.coordinates.lat,
    longitude: place.coordinates.lng,
  },
  sameAs: place.mapUrl,
  dateModified: place.updatedIso,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={place.url}
  schema={schema}
  search={search}
>
  <main class="ui-page pb-8 md:pb-12 lg:pb-14">
    <header class="ui-page-header">
      <div class="ui-page-header-stack max-w-4xl">
        <Breadcrumbs items={breadcrumbs} />

        <div>
          <p
            class="mb-2 text-xs font-bold uppercase tracking-[0.06em] text-muted-foreground"
          >
            {category}{place.status === 'existing' ? '' : ` · ${status}`}
          </p>
          <h1 class="ui-page-title">{place.name}</h1>
        </div>
      </div>
    </header>

    <article class="max-w-3xl px-5 md:px-6">
      <p class="ui-copy max-w-[65ch] text-foreground" set:html={summaryHtml} />

      {
        bodyHtml ? (
          <div class="ui-prose mt-5 max-w-[65ch]" set:html={bodyHtml} />
        ) : null
      }

      <dl class="mt-6 border-y border-border">
        <div class="grid gap-1 py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
          <dt class="text-sm font-semibold leading-7 text-muted-foreground">
            Адрес
          </dt>
          <dd
            class="text-base leading-7 text-foreground"
            set:html={addressHtml}
          />
        </div>
        {
          place.openingHours ? (
            <PlaceOpeningHours openingHours={place.openingHours} />
          ) : null
        }
        {
          place.evidence ? (
            <div class="grid gap-1 border-t border-border py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
              <dt class="text-sm font-semibold leading-7 text-muted-foreground">
                Источник
              </dt>
              <dd class="text-base leading-7 text-foreground">
                <a href={place.evidence.sourceUrl} class="site-text-link">
                  Проверено {formatPlaceEvidenceDate(place.evidence)}
                </a>
              </dd>
            </div>
          ) : null
        }
      </dl>

      <nav
        aria-label="Действия с местом"
        class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold"
      >
        <a href={placesUrl()} class="site-text-link">Показать на общей карте</a>
        <a href={place.mapUrl} class="site-text-link">Открыть в Яндекс Картах</a
        >
        {
          place.contact ? (
            <a href={place.contact.url} class="site-text-link">
              Контакты и отзывы
            </a>
          ) : null
        }
      </nav>
    </article>
  </main>
</BaseLayout>

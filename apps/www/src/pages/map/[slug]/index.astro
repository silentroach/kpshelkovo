---
import type { GetStaticPaths } from 'astro';

import { formatDynamicHtml } from '@shelkovo/markdown';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import PlaceOpeningHours from '@/components/places/PlaceOpeningHours.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withHomeBreadcrumbs } from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import { loadPlaces, loadPlaceWithBacklinks } from '@/lib/places/load';
import { placeHighlightUrl, placesUrl } from '@/lib/places/routes';
import {
  formatPlaceBacklinkDate,
  formatPlaceBacklinkKind,
  formatPlaceCategory,
  placeBacklinkGroups,
} from '@/lib/places/view';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const places = await loadPlaces();

  return places.map((place) => ({ params: { slug: place.slug } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;

if (!slug) {
  throw new Error('place slug is required');
}

const place = await loadPlaceWithBacklinks(slug);

if (!place) {
  throw new Error(`place "${slug}" not found`);
}

const title = `${place.name} — Карта — Шелково Онлайн`;
const description = place.address
  ? `${place.summary}. Адрес: ${place.address}.`
  : `${place.summary}.`;
const summaryHtml = formatDynamicHtml(place.summary);
const bodyHtml = place.body ? renderMarkdown(place.body) : undefined;
const addressHtml = place.address
  ? formatDynamicHtml(place.address)
  : undefined;
const displayName =
  place.status === 'underConstruction' ? `🚧 ${place.name}` : place.name;
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Карта', href: placesUrl() },
  { label: place.name },
]);
const showBacklinks = false;
const backlinkGroups = placeBacklinkGroups(place.backlinks);
const search = {
  scope: 'manual',
  title: place.name,
  description: place.summary,
  section: SEARCH_SECTIONS.places,
  aliases: [
    formatPlaceCategory(place.category),
    ...(place.searchAliases ?? []),
  ],
} satisfies SearchDocument;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: place.name,
  description: place.summary,
  url: place.canonical,
  address: place.address,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.coordinates.lat,
    longitude: place.coordinates.lng,
  },
  sameAs: place.mapUrl,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={place.url}
  schema={schema}
  search={search}
>
  <main class="ui-page place-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack place-header">
        <Breadcrumbs items={breadcrumbs} />

        <div>
          <h1 class="ui-page-title" data-pagefind-ignore="all">
            {displayName}
          </h1>
        </div>
      </div>
    </header>

    <article class="place-details">
      {
        addressHtml || place.openingHours ? (
          <dl class="place-facts">
            {addressHtml ? (
              <div class="place-fact">
                <dt class="place-fact__label">Адрес</dt>
                <dd class="place-fact__value" set:html={addressHtml} />
              </div>
            ) : null}
            {place.openingHours ? (
              <PlaceOpeningHours openingHours={place.openingHours} />
            ) : null}
          </dl>
        ) : null
      }

      <nav aria-label="Действия с местом" class="place-actions">
        <a href={placeHighlightUrl(place.slug)} class="site-text-link"
          >Показать на общей карте</a
        >
        <a href={place.mapUrl} class="site-text-link">Открыть в Яндекс Картах</a
        >
        {
          place.contact ? (
            <a href={place.contact.url} class="site-text-link">
              Контакты и отзывы
            </a>
          ) : null
        }
      </nav>

      {
        bodyHtml ? (
          <div
            class="ui-prose place-body"
            data-pagefind-body
            data-pagefind-weight="5"
            set:html={bodyHtml}
          />
        ) : (
          <p
            class="ui-copy place-summary"
            data-pagefind-body
            data-pagefind-weight="5"
            set:html={summaryHtml}
          />
        )
      }

      {
        showBacklinks && backlinkGroups.length > 0 ? (
          <section
            aria-labelledby="place-backlinks"
            class="place-backlinks"
            data-pagefind-ignore="all"
          >
            <div class="place-backlinks__heading">
              <h2 id="place-backlinks" class="ui-section-label">
                Где упоминается
              </h2>
              <p class="place-backlinks__description">
                Материалы сайта, в которых упомянуто это место.
              </p>
            </div>

            <div class="place-backlink-groups">
              {backlinkGroups.map((group) => (
                <section
                  aria-labelledby={`place-backlinks-${group.section}`}
                  class="place-backlink-group"
                >
                  <h3
                    id={`place-backlinks-${group.section}`}
                    class="place-backlink-group__title"
                  >
                    {group.label}
                  </h3>

                  <ul class="place-backlink-list">
                    {group.items.map((backlink) => (
                      <li class="place-backlink">
                        <div class="place-backlink__meta">
                          <span class="place-backlink__kind">
                            {formatPlaceBacklinkKind(backlink.kind)}
                          </span>
                          {backlink.mentionedAt && (
                            <time datetime={backlink.mentionedAt}>
                              {formatPlaceBacklinkDate(backlink)}
                            </time>
                          )}
                        </div>

                        <a
                          href={backlink.htmlUrl}
                          class="site-text-link place-backlink__title"
                          set:html={formatDynamicHtml(backlink.title)}
                        />

                        {backlink.excerpt && (
                          <p
                            class="place-backlink__excerpt"
                            set:html={formatDynamicHtml(backlink.excerpt)}
                          />
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </section>
        ) : null
      }
    </article>
  </main>
</BaseLayout>

<style>
  .place-page {
    padding-block-end: 2rem;
  }

  .place-header {
    max-width: 56rem;
  }

  .place-details {
    max-width: 48rem;
    padding-inline: 1.25rem;
  }

  .place-facts,
  .place-backlink-list {
    border-block: 1px solid var(--color-border);
  }

  .place-fact {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
  }

  .place-fact__label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.75rem;
  }

  .place-fact__value {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .place-actions {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    row-gap: 0.75rem;
    margin-block-start: 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .place-body,
  .place-summary {
    max-width: 65ch;
    margin-block-start: 2rem;
  }

  .place-summary {
    color: var(--color-text);
  }

  .place-backlinks {
    margin-block-start: 2.5rem;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: 2rem;
  }

  .place-backlinks__heading > :not(:last-child) {
    margin-block-end: 0.375rem;
  }

  .place-backlinks__description,
  .place-backlink__excerpt {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .place-backlink-groups {
    margin-block-start: 1.5rem;
  }

  .place-backlink-groups > :not(:last-child) {
    margin-block-end: 1.75rem;
  }

  .place-backlink-group > :not(:last-child) {
    margin-block-end: 0.5rem;
  }

  .place-backlink-group__title,
  .place-backlink__kind {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .place-backlink-group__title {
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }

  .place-backlink + .place-backlink {
    border-block-start: 1px solid var(--color-border);
  }

  .place-backlink {
    padding-block: 1rem;
  }

  .place-backlink__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .place-backlink__title {
    display: block;
    max-width: 65ch;
    margin-block-start: 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .place-backlink__excerpt {
    max-width: 65ch;
    margin-block-start: 0.375rem;
  }

  @media (min-width: 40rem) {
    .place-fact {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 48rem) {
    .place-page {
      padding-block-end: 3rem;
    }

    .place-details {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .place-page {
      padding-block-end: 3.5rem;
    }
  }
</style>

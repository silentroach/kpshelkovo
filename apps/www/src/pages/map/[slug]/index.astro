---
import type { GetStaticPaths } from 'astro';

import { formatDynamicHtml } from '@shelkovo/markdown';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import { PLACE_MARKER_IMAGES } from '@/components/places/marker-images';
import PlaceOpeningHours from '@/components/places/PlaceOpeningHours.astro';
import PlacePreview from '@/components/places/PlacePreview.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withHomeBreadcrumbs } from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import { loadPlaces, loadPlaceWithBacklinks } from '@/lib/places/load';
import { getNearbyPlaces } from '@/lib/places/nearby';
import { placeHighlightUrl, placesUrl } from '@/lib/places/routes';
import {
  formatPlaceBacklinkDate,
  formatPlaceBacklinkKind,
  formatPlaceCategory,
  formatPlaceStatus,
  placeBacklinkGroups,
} from '@/lib/places/view';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const places = await loadPlaces();

  return places.map((place) => ({ params: { slug: place.slug } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;

if (!slug) {
  throw new Error('place slug is required');
}

const place = await loadPlaceWithBacklinks(slug);

if (!place) {
  throw new Error(`place "${slug}" not found`);
}

const title = `${place.name} — Карта — Шелково Онлайн`;
const description = place.address
  ? `${place.summary}. Адрес: ${place.address}.`
  : `${place.summary}.`;
const summaryHtml = formatDynamicHtml(place.summary);
const bodyHtml = place.body ? renderMarkdown(place.body) : undefined;
const addressHtml = place.address
  ? formatDynamicHtml(place.address)
  : undefined;
const neighbors = getNearbyPlaces(place, await loadPlaces());
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Карта', href: placesUrl() },
  { label: place.name },
]);
const showBacklinks = false;
const backlinkGroups = placeBacklinkGroups(place.backlinks);
const search = {
  scope: 'manual',
  title: place.name,
  description: place.summary,
  section: SEARCH_SECTIONS.places,
  aliases: [
    formatPlaceCategory(place.category),
    ...(place.searchAliases ?? []),
  ],
} satisfies SearchDocument;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: place.name,
  description: place.summary,
  url: place.canonical,
  address: place.address,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.coordinates.lat,
    longitude: place.coordinates.lng,
  },
  sameAs: place.mapUrl,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={place.url}
  schema={schema}
  search={search}
>
  <main class="ui-page place-page">
    <div class="ui-page-header place-layout">
      <div class="place-main">
        <header class="place-header">
          <div class="ui-page-header-stack">
            <Breadcrumbs items={breadcrumbs} />

            <div class="ui-page-title place-heading">
              <h1
                class="ui-page-title"
                data-pagefind-ignore="all"
                set:html={formatDynamicHtml(place.name)}
              />
              {
                (place.showOnMap || place.contact) && (
                  <nav
                    aria-label="Действия с местом"
                    class="place-heading__actions"
                    data-pagefind-ignore="all"
                  >
                    {place.showOnMap && (
                      <a
                        href={placeHighlightUrl(place.slug)}
                        class="ui-btn ui-icon-action"
                        aria-label="Показать на общей карте"
                        title="Показать на общей карте"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m9 18-6 3V6l6-3 6 3 6-3v15l-6 3-6-3Zm0 0V3m6 18V6" />
                        </svg>
                      </a>
                    )}
                    {place.contact && (
                      <a
                        href={place.contact.url}
                        class="ui-btn ui-icon-action"
                        aria-label="Контакты и отзывы"
                        title="Контакты и отзывы"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <rect x="3" y="4" width="18" height="16" rx="2" />
                          <circle cx="8" cy="9" r="2" />
                          <path d="M5 17v-1a3 3 0 0 1 6 0v1m3-9h4m-4 4h4m-4 4h3" />
                        </svg>
                      </a>
                    )}
                  </nav>
                )
              }
            </div>
          </div>
        </header>

        <article class="place-details" aria-label="О месте">
          {
            place.openingHours && (
              <dl class="place-facts">
                <PlaceOpeningHours openingHours={place.openingHours} />
              </dl>
            )
          }

          {
            bodyHtml ? (
              <div
                class="ui-prose place-body"
                data-pagefind-body
                data-pagefind-weight="5"
                set:html={bodyHtml}
              />
            ) : (
              <p
                class="ui-copy place-summary"
                data-pagefind-body
                data-pagefind-weight="5"
                set:html={summaryHtml}
              />
            )
          }

          {
            showBacklinks && backlinkGroups.length > 0 && (
              <section
                aria-labelledby="place-backlinks"
                class="place-backlinks"
                data-pagefind-ignore="all"
              >
                <div class="place-backlinks__heading">
                  <h2 id="place-backlinks" class="ui-section-label">
                    Где упоминается
                  </h2>
                  <p class="place-backlinks__description">
                    Материалы сайта, в которых упомянуто это место.
                  </p>
                </div>

                <div class="place-backlink-groups">
                  {backlinkGroups.map((group) => (
                    <section
                      aria-labelledby={`place-backlinks-${group.section}`}
                      class="place-backlink-group"
                    >
                      <h3
                        id={`place-backlinks-${group.section}`}
                        class="place-backlink-group__title"
                      >
                        {group.label}
                      </h3>

                      <ul class="place-backlink-list">
                        {group.items.map((backlink) => (
                          <li class="place-backlink">
                            <div class="place-backlink__meta">
                              <span class="place-backlink__kind">
                                {formatPlaceBacklinkKind(backlink.kind)}
                              </span>
                              {backlink.mentionedAt && (
                                <time datetime={backlink.mentionedAt}>
                                  {formatPlaceBacklinkDate(backlink)}
                                </time>
                              )}
                            </div>

                            <a
                              href={backlink.htmlUrl}
                              class="site-text-link place-backlink__title"
                              set:html={formatDynamicHtml(backlink.title)}
                            />

                            {backlink.excerpt && (
                              <p
                                class="place-backlink__excerpt"
                                set:html={formatDynamicHtml(backlink.excerpt)}
                              />
                            )}
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </div>
              </section>
            )
          }
        </article>
      </div>
      <aside
        class="place-location"
        aria-label="Расположение"
        data-pagefind-ignore="all"
      >
        <figure>
          <PlacePreview {place} />
          {addressHtml && <figcaption set:html={addressHtml} />}
        </figure>
        {
          neighbors.length > 0 && (
            <section class="place-nearby" aria-labelledby="nearby-heading">
              <h2 id="nearby-heading" class="ui-section-label">
                Рядом
              </h2>
              <ul class="place-nearby__list">
                {neighbors.map((neighbor) => {
                  const marker = neighbor.marker
                    ? PLACE_MARKER_IMAGES[neighbor.marker]
                    : undefined;
                  return (
                    <li>
                      <a href={neighbor.url} class="place-nearby__link">
                        <span class="place-nearby__icon" aria-hidden="true">
                          {marker ? (
                            <img
                              src={marker.src}
                              width={marker.width}
                              height={marker.height}
                              alt=""
                            />
                          ) : (
                            <span class="place-nearby__point" />
                          )}
                        </span>
                        <span class="place-nearby__name">
                          <span set:html={formatDynamicHtml(neighbor.name)} />
                          {neighbor.status !== 'existing' && (
                            <span class="ui-visually-hidden">
                              , {formatPlaceStatus(neighbor.status)}
                            </span>
                          )}
                        </span>
                        <span class="place-nearby__arrow" aria-hidden="true">
                          ↗
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .place-page {
    padding-block-end: 3rem;
  }

  .place-layout {
    display: grid;
    gap: 2.25rem;
    padding-block-end: 0;
  }

  .place-main,
  .place-details,
  .place-location {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .place-header {
    padding: 0 0 1.5rem;
  }

  .place-heading {
    text-wrap: wrap;
  }

  .place-heading h1 {
    display: inline;
    text-wrap: inherit;
  }

  .place-heading__actions {
    display: inline-flex;
    margin-inline-start: 1.25rem;
    gap: 0.5rem;
    vertical-align: middle;
  }

  .place-heading__actions a {
    width: 2.75rem;
    height: 2.75rem;
  }

  .place-facts {
    margin-block-end: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .place-facts :global(.place-opening-hours-row) {
    border-top: 0;
    padding-block-start: 0;
  }

  .place-backlink-list {
    border-block: 1px solid var(--color-border);
  }

  .place-body,
  .place-summary {
    max-width: 65ch;
    margin-block-start: 0;
  }

  .place-body > :global(:first-child) {
    margin-block-start: 0;
  }

  .place-summary {
    color: var(--color-text);
  }

  .place-backlinks {
    margin-block-start: 2.5rem;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: 2rem;
  }

  .place-backlinks__heading > :not(:last-child) {
    margin-block-end: 0.375rem;
  }

  .place-backlinks__description,
  .place-backlink__excerpt {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .place-backlink-groups {
    margin-block-start: 1.5rem;
  }

  .place-backlink-groups > :not(:last-child) {
    margin-block-end: 1.75rem;
  }

  .place-backlink-group > :not(:last-child) {
    margin-block-end: 0.5rem;
  }

  .place-backlink-group__title,
  .place-backlink__kind {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .place-backlink-group__title {
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }

  .place-backlink + .place-backlink {
    border-block-start: 1px solid var(--color-border);
  }

  .place-backlink {
    padding-block: 1rem;
  }

  .place-backlink__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .place-backlink__title {
    display: block;
    max-width: 65ch;
    margin-block-start: 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .place-backlink__excerpt {
    max-width: 65ch;
    margin-block-start: 0.375rem;
  }

  figcaption {
    margin-block-start: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .place-nearby {
    margin-block-start: 1.5rem;
  }

  .place-nearby h2 {
    margin-block-end: 0.5rem;
    color: var(--color-text-muted);
  }

  .place-nearby__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding-block: 0.625rem;
    color: var(--color-text);
  }

  .place-nearby__link:is(:hover, :active) {
    color: var(--color-primary);
    background: var(--color-primary-soft-2);
  }

  .place-nearby__icon {
    display: grid;
    place-items: center;
    flex: 0 0 2rem;
    height: 2rem;
  }

  .place-nearby__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .place-nearby__point {
    width: 0.625rem;
    height: 0.625rem;
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .place-nearby__name {
    flex: 1;
    min-width: 0;
    line-height: 1.4;
  }

  .place-nearby__arrow {
    color: var(--color-text-muted);
  }

  a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (min-width: 48rem) {
    .place-heading__actions {
      margin-inline-start: 1.75rem;
    }

    .place-page {
      padding-block-end: 4rem;
    }

    .place-header {
      padding-block-end: 2rem;
    }
  }

  @media (min-width: 60rem) {
    .place-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
      gap: clamp(2rem, 5vw, 4.5rem);
    }
  }

  @media (min-width: 64rem) {
    .place-header {
      padding-block-end: 2.5rem;
    }
  }
</style>

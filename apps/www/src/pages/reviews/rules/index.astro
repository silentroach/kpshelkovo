---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';
import '@shelkovo/ui/prose.css';

import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/routes/content.css';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import { reviewsRulesUrl, reviewsUrl } from '@/lib/reviews/routes';
import { REVIEW_RULES } from '@/lib/reviews/rules';
import { reviewsCollectionPageSchema } from '@/lib/reviews/seo';

const title = 'Правила отзывов — Отзывы — Шелково Онлайн';
const description =
  'Как текущим собственникам Шелково отправить отзыв, как проходит ручная проверка и почему материал могут не принять.';
const rulesHtml = renderMarkdown(REVIEW_RULES.bodyMarkdown);
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Отзывы', href: reviewsUrl() },
  { label: 'Правила' },
]);
const schema = reviewsCollectionPageSchema({
  name: title,
  description,
  url: reviewsRulesUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Отзывы', url: reviewsUrl() },
    { name: 'Правила', url: reviewsRulesUrl() },
  ]),
  items: [],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={reviewsRulesUrl()}
  keywords={['правила отзывов Шелково', 'отзывы собственников Шелково']}
  schema={schema}
>
  <main class="ui-page pb-8 md:pb-12 lg:pb-14">
    <header class="ui-page-header">
      <div class="ui-page-header-stack max-w-4xl">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="ui-page-title">{REVIEW_RULES.title}</h1>
      </div>
    </header>

    <article class="px-5 md:px-6">
      <div class="ui-prose max-w-[65ch]" set:html={rulesHtml} />
    </article>
  </main>
</BaseLayout>

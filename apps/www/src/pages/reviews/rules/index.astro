---
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { reviewsRulesUrl, reviewsUrl } from '@/lib/reviews/routes';
import { REVIEW_RULES } from '@/lib/reviews/rules';
import { reviewsCollectionPageSchema } from '@/lib/reviews/seo';

const title = 'Правила отзывов — Отзывы — Шелково Онлайн';
const description =
  'Как текущим собственникам Шелково отправить отзыв, как проходит ручная проверка и почему материал могут не принять.';
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Отзывы', href: reviewsUrl() },
  { label: 'Правила' },
]);
const schema = reviewsCollectionPageSchema({
  name: title,
  description,
  url: reviewsRulesUrl(),
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Отзывы', url: reviewsUrl() },
    { name: 'Правила', url: reviewsRulesUrl() },
  ]),
  items: [],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={reviewsRulesUrl()}
  keywords={['правила отзывов Шелково', 'отзывы собственников Шелково']}
  schema={schema}
>
  <main class="ui-page pb-8 md:pb-12 lg:pb-14">
    <header class="ui-page-header">
      <div class="ui-page-header-stack max-w-4xl">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="ui-page-title">{REVIEW_RULES.title}</h1>
      </div>
    </header>

    <article class="px-5 md:px-6">
      <div class="ui-prose max-w-[65ch]">
        <h2>{REVIEW_RULES.eligibility.heading}</h2>
        <p>{REVIEW_RULES.eligibility.text}</p>

        <h2>{REVIEW_RULES.submission.heading}</h2>
        <p>
          Напишите в Telegram: <a href={REVIEW_RULES.submission.telegram.href}
            >{REVIEW_RULES.submission.telegram.label}</a
          >. {REVIEW_RULES.submission.ownershipVerification}
        </p>
        <p>{REVIEW_RULES.submission.dataHandling}</p>

        <h2>{REVIEW_RULES.editing.heading}</h2>
        <p>{REVIEW_RULES.editing.text}</p>

        <h2>{REVIEW_RULES.rejection.heading}</h2>
        <ul>
          {REVIEW_RULES.rejection.reasons.map((reason) => <li>{reason}</li>)}
        </ul>

        <h2>{REVIEW_RULES.disclaimer.heading}</h2>
        <p>{REVIEW_RULES.disclaimer.text}</p>

        <h2>{REVIEW_RULES.rightsViolation.heading}</h2>
        <p>{REVIEW_RULES.rightsViolation.text}</p>
      </div>
    </article>
  </main>
</BaseLayout>

---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '@shelkovo/ui/Breadcrumbs.astro';

import ReviewAspectList from '@/components/reviews/ReviewAspectList.astro';
import ReviewMeta from '@/components/reviews/ReviewMeta.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  withHomeBreadcrumbs,
  withHomeSchemaBreadcrumbs,
} from '@/lib/breadcrumbs';
import { renderMarkdown } from '@/lib/markdown/render';
import { loadReview, loadReviews } from '@/lib/reviews/load';
import { REVIEW_RULES } from '@/lib/reviews/rules';
import { reviewPageSchema } from '@/lib/reviews/seo';
import { reviewsUrl } from '@/lib/reviews/routes';
import { formatReviewAuthor, formatReviewTitle } from '@/lib/reviews/view';
import { SEARCH_SECTIONS } from '@/lib/search/sections';
import type { SearchDocument } from '@/lib/search/types';

export const getStaticPaths = (async () => {
  const reviews = await loadReviews();

  return reviews.map((review) => ({
    params: { id: review.id },
  }));
}) satisfies GetStaticPaths;

const id = Astro.params.id;

if (!id) {
  throw new Error('review id is required');
}

const review = await loadReview(id);

if (!review) {
  throw new Error(`review "${id}" not found`);
}

const reviewTitle = formatReviewTitle(review);
const title = `${reviewTitle} — Отзывы — Шелково Онлайн`;
const description =
  review.seo?.description ??
  `Отзыв собственника ${formatReviewAuthor(review)} о жизни в Шелково.`;
const disclaimerHtml = renderMarkdown(REVIEW_RULES.disclaimer.bodyMarkdown);
const search = {
  scope: 'manual',
  title: reviewTitle,
  description,
  section: SEARCH_SECTIONS.reviews,
} satisfies SearchDocument;
const bodyHtml = renderMarkdown(review.body);
const breadcrumbs = withHomeBreadcrumbs([
  { label: 'Отзывы', href: reviewsUrl() },
  { label: reviewTitle },
]);
const schema = reviewPageSchema({
  review,
  description,
  breadcrumbs: withHomeSchemaBreadcrumbs([
    { name: 'Отзывы', url: reviewsUrl() },
    { name: reviewTitle, url: review.url },
  ]),
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={review.url}
  type="article"
  keywords={['отзывы Шелково', reviewTitle]}
  schema={schema}
  search={search}
>
  <main class="ui-page review-page">
    <header class="ui-page-header">
      <div class="ui-page-header-stack review-header">
        <Breadcrumbs items={breadcrumbs} linkLast />
        <div class="review-header__summary">
          <h1 class="ui-page-title">{reviewTitle}</h1>
          <ReviewMeta review={review} showVerified />
        </div>
      </div>
    </header>

    <article class="review-body">
      <div
        class="ui-prose review-body__prose"
        data-pagefind-body
        set:html={bodyHtml}
      />
      <ReviewAspectList aspects={review.aspects} />
    </article>

    <!--noindex-->
    <footer class="review-footer" data-nosnippet data-pagefind-ignore="all">
      <section
        aria-labelledby="review-disclaimer"
        class="ui-shell review-disclaimer"
      >
        <h2 id="review-disclaimer" class="ui-section-label">
          {REVIEW_RULES.disclaimer.heading}
        </h2>
        <div class="review-disclaimer__body" set:html={disclaimerHtml} />
      </section>
    </footer>
    <!--/noindex-->
  </main>
</BaseLayout>

<style>
  .review-page {
    padding-block-end: 2rem;
  }

  .review-header {
    max-width: 56rem;
  }

  .review-header__summary > :global(:not(:last-child)) {
    margin-block-end: 1rem;
  }

  .review-body,
  .review-footer {
    padding-inline: 1.25rem;
  }

  .review-body > :global(:not(:last-child)) {
    margin-block-end: 2rem;
  }

  .review-body__prose {
    max-width: 65ch;
  }

  .review-footer {
    margin-block-start: 2rem;
  }

  .review-disclaimer {
    padding-block: 1rem;
  }

  .review-disclaimer__body {
    margin-block-start: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  @media (min-width: 48rem) {
    .review-page {
      padding-block-end: 3rem;
    }

    .review-body,
    .review-footer {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .review-page {
      padding-block-end: 3.5rem;
    }
  }
</style>

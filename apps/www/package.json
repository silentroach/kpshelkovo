{
  "name": "@shelkovo/www",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind && rm -rf ../../dist/www && mkdir -p ../../dist && cp -R dist/site ../../dist/www",
    "search:prepare": "rm -rf ../../.cache/pagefind && astro build && pagefind --output-path ../../.cache/pagefind",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:browser:compare": "playwright test -c playwright.compare-browser.local.config.ts",
    "test:browser:compare:serve": "astro build && ASTRO_PREVIEW_BACKGROUND=0 astro preview --host 127.0.0.1 --port 4330",
    "test:browser:header-a11y": "playwright test -c playwright.header-a11y.local.config.ts",
    "test:browser:header-a11y:serve": "astro build && ASTRO_PREVIEW_BACKGROUND=0 astro preview --host 127.0.0.1 --port 14331",
    "test:browser:home-hero": "playwright test -c playwright.home-hero.local.config.ts",
    "test:browser:home-hero:serve": "astro build && ASTRO_PREVIEW_BACKGROUND=0 astro preview --host 127.0.0.1 --port 14333",
    "test:browser:status-calendar-focus": "playwright test -c playwright.status-calendar-focus.local.config.ts",
    "test:browser:status-calendar-focus:serve": "astro build && ASTRO_PREVIEW_BACKGROUND=0 astro preview --host 127.0.0.1 --port 14332",
    "test:search-quality": "pnpm build && vitest run -c vitest.search-quality.config.ts",
    "test:search-quality:update": "pnpm build && vitest run -c vitest.search-quality.config.ts -u",
    "test:watch": "vitest",
    "test:visual:status": "playwright test -c playwright.status-visual.local.config.ts",
    "test:visual:status:update": "playwright test -c playwright.status-visual.local.config.ts --update-snapshots",
    "test:visual:status:serve": "node ../../scripts/visual-fixture-launcher.mjs tests/status-timeline-visual 4324",
    "test:visual:news-event": "playwright test -c playwright.news-event-card-visual.local.config.ts",
    "test:visual:news-event:update": "playwright test -c playwright.news-event-card-visual.local.config.ts --update-snapshots",
    "test:visual:news-event:serve": "node ../../scripts/visual-fixture-launcher.mjs tests/news-event-card-visual 4327",
    "test:visual:sticky-table": "playwright test -c playwright.sticky-table-visual.local.config.ts",
    "test:visual:sticky-table:update": "playwright test -c playwright.sticky-table-visual.local.config.ts --update-snapshots",
    "test:visual:sticky-table:serve": "node ../../scripts/visual-fixture-launcher.mjs tests/sticky-table-visual 4329"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@shelkovo/format": "workspace:*",
    "@shelkovo/geo": "workspace:*",
    "@shelkovo/markdown": "workspace:*",
    "@shelkovo/seo": "workspace:*",
    "@shelkovo/ui": "workspace:*",
    "@shelkovo/url": "workspace:*",
    "@yandex/ymaps3-clusterer": "^0.0.12",
    "astro": "^7.2.10",
    "diff": "^9.0.0",
    "svelte": "^5.57.0",
    "vcard-creator": "^1.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@yandex/ymaps3-types": "^1.0.20315584",
    "astro-compressor": "^1.3.0",
    "happy-dom": "^20.11.6",
    "pagefind": "1.5.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "explore": {
      "model": "kimi-code-plan-global/kimi-for-coding#high"
    }
  },
  "mcp": {
    "astro": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp"
    },
    "sveltejs": {
      "type": "local",
      "command": ["npx", "-y", "@sveltejs/mcp"],
      "enabled": true
    }
  }
}

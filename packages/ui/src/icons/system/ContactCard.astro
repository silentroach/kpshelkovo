---
import type { HTMLAttributes } from 'astro/types';

type Props = Pick<HTMLAttributes<'svg'>, 'class'>;
const { class: className }: Props = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="4" width="18" height="16" rx="2" />
  <circle cx="8" cy="9" r="2" />
  <path d="M5 17v-1a3 3 0 0 1 6 0v1m3-9h4m-4 4h4m-4 4h3" />
</svg>

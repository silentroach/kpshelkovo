---
import { TELEGRAM_ICON_PATH } from './telegram-icon';

interface Props {
  readonly class?: string;
}

const { class: className }: Props = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill="currentColor"
  aria-hidden="true"
>
  <path d={TELEGRAM_ICON_PATH}></path>
</svg>

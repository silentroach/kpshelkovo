---
interface Item {
  readonly label: string;
  readonly href?: string;
}

interface Props {
  readonly items: readonly Item[];
  readonly linkLast?: boolean;
}

const { items, linkLast = false } = Astro.props;
const lastIndex = items.length - 1;
const firstParentIndex = items.findIndex(
  (item, index) => index < lastIndex && item.href !== '/',
);
const parents = items.filter(
  (item, index) => index < lastIndex && item.href !== '/',
);
const hasSingleLinkedParent = parents.length === 1 && Boolean(parents[0]?.href);
let structuredPosition = 0;
const renderedItems = items.map((item, index) => {
  const isStructuredItem = Boolean(item.href) || index === lastIndex;

  if (isStructuredItem) structuredPosition += 1;

  return {
    item,
    index,
    structuredPosition: isStructuredItem ? structuredPosition : undefined,
  };
});
---

{items.length > 0 && (
  <nav
    aria-label="Хлебные крошки"
    class:list={[
      'breadcrumbs',
      { 'breadcrumbs--desktop-only': firstParentIndex === -1 },
    ]}
    data-pagefind-ignore="all"
  >
    <ol
      class="breadcrumbs-list"
      itemscope
      itemtype="https://schema.org/BreadcrumbList"
    >
      {renderedItems.map(({ item, index, structuredPosition }) => (
        <li
          class:list={[
            'breadcrumbs-item',
            {
              'breadcrumbs-item--current': index === lastIndex,
              'breadcrumbs-item--home': item.href === '/',
              'breadcrumbs-item--parent-first': index === firstParentIndex,
            },
          ]}
          itemprop={structuredPosition ? 'itemListElement' : undefined}
          itemscope={structuredPosition ? true : undefined}
          itemtype={
            structuredPosition ? 'https://schema.org/ListItem' : undefined
          }
        >
          {index > 0 && (
            <span class="breadcrumbs-separator" aria-hidden="true">
              ›
            </span>
          )}
          {hasSingleLinkedParent && index === firstParentIndex && (
            <span class="breadcrumbs-up" aria-hidden="true">
              ‹
            </span>
          )}
          {item.href && (linkLast || index < lastIndex) ? (
            <a
              href={item.href}
              class="breadcrumbs-link"
              itemprop={structuredPosition ? 'item' : undefined}
            >
              <span itemprop={structuredPosition ? 'name' : undefined}>
                {item.label}
              </span>
            </a>
          ) : (
            <span
              class="breadcrumbs-current"
              aria-current={index === items.length - 1 ? 'page' : undefined}
              itemprop={structuredPosition ? 'name' : undefined}
            >
              {item.label}
            </span>
          )}
          {structuredPosition && (
            <meta itemprop="position" content={String(structuredPosition)} />
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .breadcrumbs-up {
    display: none;
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.375rem;
    row-gap: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .breadcrumbs-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .breadcrumbs-link {
    color: var(--color-primary);
    font-weight: 400;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease,
      text-underline-offset 0.2s ease;
  }

  .breadcrumbs-link:hover {
    color: var(--color-primary-hover);
  }

  .breadcrumbs-link:is(:hover, :focus-visible) {
    text-decoration-color: color-mix(in oklab, currentColor 30%, transparent);
    text-underline-offset: 0.18em;
  }

  .breadcrumbs-current {
    color: var(--color-text);
    font-weight: 400;
  }

  @media (width < 64rem) {
    .breadcrumbs--desktop-only,
    .breadcrumbs-item--home,
    .breadcrumbs-item--current,
    .breadcrumbs-item--parent-first .breadcrumbs-separator {
      display: none;
    }

    .breadcrumbs-item {
      min-width: 0;
      max-width: 100%;
    }

    .breadcrumbs-separator {
      flex-shrink: 0;
    }

    .breadcrumbs-link,
    .breadcrumbs-current {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .breadcrumbs-link:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
  }

  @media (width < 40rem) {
    .breadcrumbs-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .breadcrumbs-item {
      align-items: flex-start;
      margin-inline-start: 0.75rem;
    }

    .breadcrumbs-item--parent-first {
      margin-inline-start: 0;
    }

    .breadcrumbs-separator {
      padding-block: 0.125rem;
    }

    .breadcrumbs-up {
      display: block;
      flex-shrink: 0;
      padding-block: 0.125rem;
    }

    .breadcrumbs-link,
    .breadcrumbs-current {
      padding-block: 0.125rem;
      color: var(--color-text-muted);
    }

    .breadcrumbs-link:is(:hover, :focus-visible) {
      color: var(--color-primary);
    }
  }

  @media (min-width: 48rem) {
    .breadcrumbs-list {
      column-gap: 0.5rem;
    }

    .breadcrumbs-item {
      gap: 0.5rem;
    }
  }
</style>

---
import DomylandIcon from './icons/system/Domyland.astro';
import TelegramIcon from './icons/system/Telegram.astro';
import { isDomylandUrl, isTelegramUrl } from '@shelkovo/url';

interface Props {
  readonly href: string;
  readonly label?: string;
  readonly ariaLabel?: string;
  readonly ariaLabelPrefix?: string;
  readonly class?: string;
  readonly iconClass?: string;
  readonly textClass?: string;
}

const {
  href,
  label,
  ariaLabel,
  ariaLabelPrefix,
  class: className,
  iconClass,
  textClass,
}: Props = Astro.props;

const isTelegramLink = isTelegramUrl(href);
const isDomylandLink = isDomylandUrl(href);
const resolvedIconClass = iconClass ?? 'link-with-icon__icon';
const targetUrl =
  !isTelegramLink && !isDomylandLink
    ? new URL(href.startsWith('//') ? `https:${href}` : href)
    : undefined;
const hostLabel = isTelegramLink
  ? 'Telegram'
  : isDomylandLink
    ? 'Домиленд'
    : targetUrl?.hostname.replace(/^www\./i, '') || undefined;
const resolvedLabel = label ?? 'источник';
const resolvedAriaLabel =
  ariaLabel ??
  (ariaLabelPrefix && hostLabel
    ? `${ariaLabelPrefix}: ${hostLabel}`
    : (ariaLabelPrefix ?? hostLabel));
---

<a
  href={href}
  target="_blank"
  rel="noreferrer noopener"
  aria-label={resolvedAriaLabel}
  class:list={[
    'ui-link link-with-icon',
    (isTelegramLink || isDomylandLink) && 'link-with-icon--branded',
    isTelegramLink && 'link-with-icon--telegram',
    className,
  ]}
>
  {isTelegramLink && <TelegramIcon class={resolvedIconClass} />}
  {isDomylandLink && <DomylandIcon class={resolvedIconClass} />}
  <span class={textClass}>{resolvedLabel}</span>
</a>

<style>
  .link-with-icon {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .link-with-icon:hover {
    color: var(--color-primary-hover);
  }

  .link-with-icon--branded {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .link-with-icon > :global(.link-with-icon__icon) {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .link-with-icon--telegram > :global(.link-with-icon__icon) {
    color: var(--color-telegram);
  }
</style>

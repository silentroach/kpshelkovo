---
import StarIcon from './icons/system/Star.astro';

interface Props {
  readonly rating: number;
  readonly label: string;
  readonly class?: string;
}

const STAR_COUNT = 5;
const { rating, label, class: className }: Props = Astro.props;

if (!Number.isInteger(rating) || rating < 1 || rating > STAR_COUNT) {
  throw new RangeError(
    `Star rating must be an integer from 1 to ${STAR_COUNT}`,
  );
}

const stars = Array.from({ length: STAR_COUNT }, (_, index) => index < rating);
---

<span class:list={['star-rating', className]} role="img" aria-label={label}>
  {
    stars.map((filled) => (
      <StarIcon class={filled ? 'star-rating__star--filled' : undefined} />
    ))
  }
</span>

<style>
  .star-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
  }

  .star-rating > :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-border-strong);
  }

  .star-rating > :global(.star-rating__star--filled) {
    color: var(--color-star);
    fill: currentColor;
  }
</style>

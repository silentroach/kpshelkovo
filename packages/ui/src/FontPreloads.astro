---
import firaSans400 from '../fonts/fira-sans-400-normal.woff2';
import firaSans600 from '../fonts/fira-sans-600-normal.woff2';
import shelkovoSerif700 from '../fonts/shelkovo-serif-700-normal.woff2';

const fonts = [firaSans400, firaSans600, shelkovoSerif700] as const;
---

{
  fonts.map((href) => (
    <link
      rel="preload"
      href={href}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  ))
}
